<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.EditInstanceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Enums"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:local="clr-namespace:Tavstal.KonkordLauncher.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate instance.edit.window}"
    Width="900"
    Height="500"
    MinWidth="900"
    MinHeight="500"
    d:DesignHeight="500"
    d:DesignWidth="900"
    x:DataType="vm:EditInstanceViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://KonkordLauncher/Assets/Images/logo.png"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <!--  Main Window Content  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar/>

                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, *">
                    <!--  Title  -->
                    <WrapPanel
                        Margin="25,0,25,0"
                        HorizontalAlignment="Left"
                        ItemSpacing="10">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Classes="InstanceTitle"
                            Text="{lang:Translate instance.edit.title}" />
                        <TextBlock
                            HorizontalAlignment="Left"
                            Classes="InstanceTitle"
                            Text="{Binding InstanceName}" />
                    </WrapPanel>

                    <Border
                        Grid.Row="1"
                        BorderBrush="{DynamicResource border-two}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="Auto, *">

                            <!--  Tab Buttons  -->
                            <Border
                                Padding="0,10,10,10"
                                BorderBrush="{DynamicResource border-two}"
                                BorderThickness="0,0,1,0">
                                <ScrollViewer>
                                    <Grid
                                        Margin="25,0,15,0"
                                        RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                                        RowSpacing="10">
                                        <Button
                                            Name="LogsTabBtn"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn SettingsTabBtnActive"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.LOGS}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.logs}" />
                                        </Button>
                                        <Button
                                            Name="ModsTabBtn"
                                            Grid.Row="1"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.MODS}"
                                            IsVisible="{Binding !IsVanilla}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.mods}" />
                                        </Button>
                                        <Button
                                            Name="ResourcePacksTabBtn"
                                            Grid.Row="2"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.RESOURCE_PACKS}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.resourcePacks}" />
                                        </Button>
                                        <Button
                                            Name="ShaderPacksTabBtn"
                                            Grid.Row="3"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.SHADER_PACKS}"
                                            IsVisible="{Binding !IsVanilla}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.shaderPacks}" />
                                        </Button>
                                        <Button
                                            Name="WorldsTabBtn"
                                            Grid.Row="4"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.WORLDS}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.worlds}" />
                                        </Button>
                                        <Button
                                            Name="ServersTabBtn"
                                            Grid.Row="5"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.SERVERS}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.servers}" />
                                        </Button>
                                        <Button
                                            Name="ScreenshotsTabBtn"
                                            Grid.Row="6"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.SCREENSHOTS}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.screenshots}" />
                                        </Button>
                                        <Button
                                            Name="SettingsTabBtn"
                                            Grid.Row="7"
                                            HorizontalAlignment="Stretch"
                                            Classes="SettingsTabBtn"
                                            Command="{Binding SwitchTabCommand}"
                                            CommandParameter="{x:Static enums:EEditInstanceTab.SETTINGS}">
                                            <TextBlock Text="{lang:Translate instance.edit.tab.settings}" />
                                        </Button>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!--  Content  -->
                            <Carousel
                                Grid.Column="1"
                                Margin="0,15,0,0"
                                SelectedIndex="{Binding EditInstanceTab}">
                                <Carousel.PageTransition>
                                    <CompositePageTransition>
                                        <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                                    </CompositePageTransition>
                                </Carousel.PageTransition>
                                <Carousel.Items>

                                    <!--  Logs  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.latestLog}" />

                                            <!--  Log content  -->
                                            <Border
                                                Grid.Row="1"
                                                Margin="0,0,0,15"
                                                Classes="GridInnerContent">
                                                <ScrollViewer
                                                    Name="LogsScrollViewer"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Logs}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    FontFamily="Consolas"
                                                                    FontSize="11"
                                                                    Opacity="0.8"
                                                                    Text="{Binding}"
                                                                    TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <!--  Actions  -->
                                            <Grid
                                                Grid.Row="2"
                                                Margin="4,0"
                                                ColumnDefinitions="*, Auto, Auto, Auto"
                                                ColumnSpacing="5">
                                                <!--  Search bar  -->
                                                <TextBox
                                                    Grid.Column="0"
                                                    Classes="TextInput"
                                                    PlaceholderText="{lang:Translate common.search}" />
                                                <!--  To bottom button  -->
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="IconBtn"
                                                    Command="{Binding ScrollLogsToEndCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xe4b8;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.bottom}" />
                                                    </WrapPanel>
                                                </Button>
                                                <!--  Copy button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding CopyLogsCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf0c5;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.copy}" />
                                                    </WrapPanel>
                                                </Button>
                                                <!--  Clear button  -->
                                                <Button
                                                    Grid.Column="3"
                                                    Classes="IconBtn ErrorBtn"
                                                    Command="{Binding ClearLogsCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf1b8;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.clear}" />
                                                    </WrapPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  Mods  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.subTitle.mods}" />

                                            <!--  Content  -->
                                            <Border Grid.Row="1">
                                                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid
                                                        Classes="InstanceMultiTable"
                                                        ItemsSource="{Binding Mods.FilteredMods}"
                                                        SelectedItem="{Binding Mods.SelectedMod}">
                                                        <DataGrid.Columns>
                                                            <!--  Enabled  -->
                                                            <DataGridCheckBoxColumn
                                                                Width="Auto"
                                                                Binding="{Binding IsEnabled}"
                                                                Header="{lang:Translate instance.edit.table.enabled}"
                                                                IsReadOnly="False" />
                                                            <!--  Image  -->
                                                            <DataGridTemplateColumn Width="Auto" Header="{lang:Translate instance.edit.table.image}">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Image
                                                                            Width="32"
                                                                            Height="32"
                                                                            Source="{Binding Icon.Value}"
                                                                            Stretch="UniformToFill" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <!--  Name  -->
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding Name}"
                                                                Header="{lang:Translate instance.edit.table.name}" />
                                                            <!--  Provider  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding Platform}"
                                                                Header="{lang:Translate instance.edit.table.provider}" />
                                                            <!--  Size  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding FormattedSize}"
                                                                Header="{lang:Translate instance.edit.table.size}" />
                                                        </DataGrid.Columns>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu>
                                                                <!--  Toggle  -->
                                                                <MenuItem
                                                                    Command="{Binding Mods.ToggleCommand}"
                                                                    CommandParameter="{Binding Mods.SelectedMod}"
                                                                    Header="{lang:Translate common.toggle}" />
                                                                <Separator />
                                                                <!--  Check For Updates  -->
                                                                <MenuItem
                                                                    Command="{Binding Mods.CheckUpdateCommand}"
                                                                    CommandParameter="{Binding Mods.SelectedMod}"
                                                                    Header="{lang:Translate instance.update.check}" />
                                                                <Separator />
                                                                <!--  Change Version  -->
                                                                <MenuItem
                                                                    Command="{Binding Mods.ChangeVersionCommand}"
                                                                    CommandParameter="{Binding Mods.SelectedMod}"
                                                                    Header="{lang:Translate instance.version.change}" />
                                                                <Separator />
                                                                <!--  Remove  -->
                                                                <MenuItem
                                                                    Command="{Binding Mods.RemoveCommand}"
                                                                    CommandParameter="{Binding Mods.SelectedMod}"
                                                                    Header="{lang:Translate common.remove}" />
                                                                <Separator />
                                                                <!--  Download Mods  -->
                                                                <MenuItem Command="{Binding Mods.DownloadCommand}" Header="{lang:Translate instance.download.mods}" />
                                                                <!--  Open Folder  -->
                                                                <MenuItem Command="{Binding Mods.ModOpenDirectoryCommand}" Header="{lang:Translate common.open.directory}" />
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                    </DataGrid>
                                                </ScrollViewer>
                                            </Border>

                                            <!--  Actions  -->
                                            <Grid
                                                Grid.Row="2"
                                                Margin="4,10,4,0"
                                                ColumnDefinitions="*, Auto, Auto"
                                                ColumnSpacing="5">
                                                <!--  Search bar  -->
                                                <TextBox
                                                    Grid.Column="0"
                                                    Classes="TextInput"
                                                    PlaceholderText="{lang:Translate common.search}" />
                                                <!--  Download  -->
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="IconBtn"
                                                    Command="{Binding Mods.DownloadCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf0ed;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate instance.edit.downloadMods}" />
                                                    </WrapPanel>
                                                </Button>
                                                <!--  View Folder  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding Mods.ModOpenDirectoryCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf07c;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.open.directory}" />
                                                    </WrapPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  Resource Packs  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.subTitle.resourcePacks}" />

                                            <!--  Content  -->
                                            <Border Grid.Row="1">
                                                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid
                                                        CellEditEnded="ResourcePacksDataGrid_OnCellEditEnded"
                                                        Classes="InstanceMultiTable"
                                                        IsReadOnly="False"
                                                        ItemsSource="{Binding ResourcePacks.FilteredResourcePacks}"
                                                        SelectedItem="{Binding ResourcePacks.SelectedResourcePack}">
                                                        <DataGrid.Columns>
                                                            <!--  Enabled  -->
                                                            <DataGridCheckBoxColumn
                                                                Width="Auto"
                                                                Binding="{Binding IsEnabled, Mode=TwoWay}"
                                                                Header="{lang:Translate instance.edit.table.enabled}"
                                                                IsReadOnly="False" />
                                                            <!--  Image  -->
                                                            <DataGridTemplateColumn Width="Auto" Header="{lang:Translate instance.edit.table.image}">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Image
                                                                            Width="32"
                                                                            Height="32"
                                                                            Source="{Binding Icon.Value}"
                                                                            Stretch="UniformToFill" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <!--  Name  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding Name}"
                                                                Header="{lang:Translate instance.edit.table.name}"
                                                                IsReadOnly="True" />
                                                            <!--  Provider  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding Platform}"
                                                                Header="{lang:Translate instance.edit.table.provider}"
                                                                IsReadOnly="True" />
                                                            <!--  Size  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding FormattedSize}"
                                                                Header="{lang:Translate instance.edit.table.size}"
                                                                IsReadOnly="True" />
                                                        </DataGrid.Columns>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu>
                                                                <!--  Toggle  -->
                                                                <MenuItem
                                                                    Command="{Binding ResourcePacks.ToggleCommand}"
                                                                    CommandParameter="{Binding ResourcePacks.SelectedResourcePack}"
                                                                    Header="{lang:Translate common.toggle}" />
                                                                <Separator />
                                                                <!--  Remove  -->
                                                                <MenuItem
                                                                    Command="{Binding ResourcePacks.RemoveCommand}"
                                                                    CommandParameter="{Binding ResourcePacks.SelectedResourcePack}"
                                                                    Header="{lang:Translate common.remove}" />
                                                                <Separator />
                                                                <!--  Download Packs  -->
                                                                <MenuItem
                                                                    Command="{Binding ResourcePacks.DownloadCommand}"
                                                                    CommandParameter="{Binding ResourcePacks.SelectedResourcePack}"
                                                                    Header="{lang:Translate instance.download.resourcePacks}" />
                                                                <!--  Open Folder  -->
                                                                <MenuItem Command="{Binding ResourcePacks.OpenDirCommand}" Header="{lang:Translate common.open.directory}" />
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                    </DataGrid>
                                                </ScrollViewer>
                                            </Border>

                                            <!--  Actions  -->
                                            <Grid
                                                Grid.Row="2"
                                                Margin="4,10,4,0"
                                                ColumnDefinitions="*, Auto, Auto"
                                                ColumnSpacing="5">
                                                <!--  Search bar  -->
                                                <TextBox
                                                    Grid.Column="0"
                                                    Classes="TextInput"
                                                    PlaceholderText="{lang:Translate common.search}"
                                                    Text="{Binding ResourcePacks.SearchQuery}" />
                                                <!--  Download  -->
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="IconBtn"
                                                    Command="{Binding ResourcePacks.DownloadCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf0ed;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate instance.edit.downloadPacks}" />
                                                    </WrapPanel>
                                                </Button>
                                                <!--  View Folder  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ResourcePacks.OpenDirCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf07c;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.open.directory}" />
                                                    </WrapPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  Shader Packs  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.subTitle.shaderPacks}" />

                                            <!--  Content  -->
                                            <Border Grid.Row="1">
                                                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid
                                                        Classes="InstanceMultiTable"
                                                        ItemsSource="{Binding ShaderPacks.FilteredShaderPacks}"
                                                        SelectedItem="{Binding ShaderPacks.SelectedShaderPack}">
                                                        <DataGrid.Columns>
                                                            <!--  Enabled  -->
                                                            <DataGridCheckBoxColumn
                                                                Width="Auto"
                                                                Binding="{Binding IsEnabled}"
                                                                Header="{lang:Translate instance.edit.table.enabled}"
                                                                IsReadOnly="False" />
                                                            <!--  Name  -->
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding Name}"
                                                                Header="{lang:Translate instance.edit.table.name}" />
                                                            <!--  Provider  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding Platform}"
                                                                Header="{lang:Translate instance.edit.table.provider}" />
                                                            <!--  Size  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding FormattedSize}"
                                                                Header="{lang:Translate instance.edit.table.size}" />
                                                        </DataGrid.Columns>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu>
                                                                <!--  Toggle  -->
                                                                <MenuItem
                                                                    Command="{Binding ShaderPacks.ToggleCommand}"
                                                                    CommandParameter="{Binding ShaderPacks.SelectedShaderPack}"
                                                                    Header="{lang:Translate common.toggle}" />
                                                                <Separator />
                                                                <!--  Remove  -->
                                                                <MenuItem
                                                                    Command="{Binding ShaderPacks.RemoveCommand}"
                                                                    CommandParameter="{Binding ShaderPacks.SelectedShaderPack}"
                                                                    Header="{lang:Translate common.remove}" />
                                                                <Separator />
                                                                <!--  Download Packs  -->
                                                                <MenuItem Command="{Binding ShaderPacks.DownloadCommand}" Header="{lang:Translate instance.download.shaders}" />
                                                                <!--  Open Folder  -->
                                                                <MenuItem Command="{Binding ShaderPacks.OpenDirCommand}" Header="{lang:Translate common.open.directory}" />
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                    </DataGrid>
                                                </ScrollViewer>
                                            </Border>

                                            <!--  Actions  -->
                                            <Grid
                                                Grid.Row="2"
                                                Margin="4,10,4,0"
                                                ColumnDefinitions="*, Auto, Auto"
                                                ColumnSpacing="5">
                                                <!--  Search bar  -->
                                                <TextBox
                                                    Grid.Column="0"
                                                    Classes="TextInput"
                                                    PlaceholderText="{lang:Translate common.search}" />
                                                <!--  Download  -->
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="IconBtn"
                                                    Command="{Binding ShaderPacks.DownloadCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf0ed;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate instance.edit.downloadPacks}" />
                                                    </WrapPanel>
                                                </Button>
                                                <!--  View Folder  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ShaderPacks.OpenDirCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#xf07c;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.open.directory}" />
                                                    </WrapPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  Worlds  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.subTitle.worlds}" />

                                            <!--  Content  -->
                                            <Border Grid.Row="1">
                                                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid
                                                        Name="WorldsTable"
                                                        CellEditEnded="WorldDataGrid_OnCellEditEnded"
                                                        Classes="InstanceMultiTable"
                                                        IsReadOnly="False"
                                                        ItemsSource="{Binding Worlds.Worlds}"
                                                        RowEditEnded="WorldDataGrid_OnRowEditEnded"
                                                        SelectedItem="{Binding Worlds.SelectedWorld}">
                                                        <DataGrid.Columns>
                                                            <!--  Icon & Name  -->
                                                            <DataGridTemplateColumn Width="*" Header="{lang:Translate instance.edit.table.name}">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Image
                                                                                Height="48"
                                                                                MaxWidth="48"
                                                                                Margin="5"
                                                                                Source="{Binding Icon.Value}"
                                                                                Stretch="UniformToFill" />
                                                                            <TextBlock
                                                                                Margin="0,0,25,0"
                                                                                VerticalAlignment="Center"
                                                                                Text="{Binding Name}"
                                                                                TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                                    <DataTemplate>
                                                                        <TextBox
                                                                            Margin="5,0,25,0"
                                                                            VerticalAlignment="Center"
                                                                            Text="{Binding Name, Mode=TwoWay}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellEditingTemplate>
                                                            </DataGridTemplateColumn>
                                                            <!--  GameMode  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding Gamemode}"
                                                                Header="{lang:Translate instance.edit.table.gameMode}"
                                                                IsReadOnly="True" />
                                                            <!--  Last Played  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding FormattedLastPlayed}"
                                                                Header="{lang:Translate instance.edit.table.lastPlayed}"
                                                                IsReadOnly="True" />
                                                            <!--  Size  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding FormattedSize}"
                                                                Header="{lang:Translate instance.edit.table.size}"
                                                                IsReadOnly="True" />
                                                        </DataGrid.Columns>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu>
                                                                <!--  Duplicate  -->
                                                                <MenuItem
                                                                    Command="{Binding Worlds.DuplicateCommand}"
                                                                    CommandParameter="{Binding Worlds.SelectedWorld}"
                                                                    Header="{lang:Translate common.duplicate}" />
                                                                <!--  Rename  -->
                                                                <MenuItem
                                                                    Command="{Binding Worlds.RenameCommand}"
                                                                    CommandParameter="{Binding Worlds.SelectedWorld}"
                                                                    Header="{lang:Translate common.rename}" />
                                                                <!--  Delete  -->
                                                                <MenuItem
                                                                    Command="{Binding Worlds.DeleteCommand}"
                                                                    CommandParameter="{Binding Worlds.SelectedWorld}"
                                                                    Header="{lang:Translate common.delete}" />
                                                                <Separator />
                                                                <!--  Copy Speed  -->
                                                                <MenuItem
                                                                    Command="{Binding Worlds.CopySeedCommand}"
                                                                    CommandParameter="{Binding Worlds.SelectedWorld}"
                                                                    Header="{lang:Translate instance.edit.copySeed}" />
                                                                <!--  Open Folder  -->
                                                                <MenuItem
                                                                    Command="{Binding Worlds.OpenDirCommand}"
                                                                    CommandParameter="{Binding Worlds.SelectedWorld}"
                                                                    Header="{lang:Translate common.open.directory}" />
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                    </DataGrid>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!--  Servers  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.subTitle.servers}" />

                                            <!--  Content  -->
                                            <Border Grid.Row="1">
                                                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid
                                                        Classes="InstanceMultiTable"
                                                        IsReadOnly="False"
                                                        ItemsSource="{Binding Servers.Servers}"
                                                        RowEditEnded="ServersDataGrid_OnRowEditEnded"
                                                        SelectedItem="{Binding Servers.SelectedServer}">
                                                        <DataGrid.Columns>
                                                            <!--  Icon & Name  -->
                                                            <DataGridTemplateColumn Width="*" Header="{lang:Translate instance.edit.table.name}">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Image
                                                                                Height="48"
                                                                                MaxWidth="48"
                                                                                Margin="5"
                                                                                Source="{Binding Image.Value}"
                                                                                Stretch="UniformToFill" />
                                                                            <TextBlock
                                                                                Margin="0,0,25,0"
                                                                                VerticalAlignment="Center"
                                                                                Text="{Binding Name}"
                                                                                TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                                    <DataTemplate>
                                                                        <TextBox
                                                                            Margin="5,0,25,0"
                                                                            VerticalAlignment="Center"
                                                                            Text="{Binding Name, Mode=TwoWay}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellEditingTemplate>
                                                            </DataGridTemplateColumn>
                                                            <!--  Address  -->
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding Ip}"
                                                                Header="{lang:Translate instance.edit.table.ipAddress}" />
                                                        </DataGrid.Columns>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu>
                                                                <!--  Remove  -->
                                                                <MenuItem
                                                                    Command="{Binding Servers.RemoveCommand}"
                                                                    CommandParameter="{Binding Servers.SelectedServer}"
                                                                    Header="{lang:Translate common.remove}" />
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                    </DataGrid>
                                                </ScrollViewer>
                                            </Border>

                                            <!--  Actions  -->
                                            <Grid
                                                Grid.Row="2"
                                                Margin="4,10,4,0"
                                                ColumnDefinitions="*, *, Auto"
                                                ColumnSpacing="5">
                                                <!--  Name bar  -->
                                                <TextBox
                                                    Grid.Column="0"
                                                    Classes="TextInput"
                                                    PlaceholderText="Minecraft Server"
                                                    Text="{Binding Servers.ServerName}" />
                                                <!--  Address bar  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    PlaceholderText="192.168.1.0:25565"
                                                    Text="{Binding Servers.ServerIp}" />
                                                <!--  Add  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding Servers.AddCommand}">
                                                    <WrapPanel Classes="IconBtnWrapper">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="FontAwesome"
                                                            Text="&#x2b;" />
                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.add}" />
                                                    </WrapPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  Screenshots  -->
                                    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="5,5,5,10"
                                                Classes="SettingsCategoryText"
                                                Text="{lang:Translate instance.edit.subTitle.screenshots}" />

                                            <!--  Content  -->
                                            <Border Grid.Row="1">
                                                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid
                                                        Name="ScreenshotsTable"
                                                        CellEditEnded="ScreenshotCell_OnEditEnded"
                                                        Classes="InstanceMultiTable"
                                                        IsReadOnly="False"
                                                        ItemsSource="{Binding Screenshots.Screenshots}"
                                                        SelectedItem="{Binding Screenshots.SelectedScreenshot}">
                                                        <DataGrid.Columns>
                                                            <!--  Icon & Name  -->
                                                            <DataGridTemplateColumn
                                                                Width="*"
                                                                Header="{lang:Translate instance.edit.table.name}"
                                                                IsReadOnly="False">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Image
                                                                                Height="48"
                                                                                MaxWidth="48"
                                                                                Margin="5"
                                                                                Source="{Binding Image}"
                                                                                Stretch="UniformToFill" />
                                                                            <TextBlock
                                                                                Margin="5,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Text="{Binding Name}"
                                                                                TextAlignment="Center" />
                                                                            <TextBlock
                                                                                Margin="0,0,25,0"
                                                                                VerticalAlignment="Center"
                                                                                Text="{Binding Extension}"
                                                                                TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                                    <DataTemplate>
                                                                        <TextBox
                                                                            Margin="5,0,25,0"
                                                                            VerticalAlignment="Center"
                                                                            Text="{Binding Name, Mode=TwoWay}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellEditingTemplate>
                                                            </DataGridTemplateColumn>
                                                            <!--  Size  -->
                                                            <DataGridTextColumn
                                                                Width="Auto"
                                                                Binding="{Binding FormatedSize}"
                                                                Header="{lang:Translate instance.edit.table.size}"
                                                                IsReadOnly="True" />
                                                        </DataGrid.Columns>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu>
                                                                <!--  Copy  -->
                                                                <MenuItem
                                                                    Command="{Binding Screenshots.CopyToClipboardCommand}"
                                                                    CommandParameter="{Binding Screenshots.SelectedScreenshot}"
                                                                    Header="{lang:Translate common.copy}" />
                                                                <!--  Delete  -->
                                                                <MenuItem
                                                                    Command="{Binding Screenshots.DeleteCommand}"
                                                                    CommandParameter="{Binding Screenshots.SelectedScreenshot}"
                                                                    Header="{lang:Translate common.delete}" />
                                                                <!--  Rename  -->
                                                                <MenuItem
                                                                    Command="{Binding Screenshots.RenameCommand}"
                                                                    CommandParameter="{Binding Screenshots.SelectedScreenshot}"
                                                                    Header="{lang:Translate common.rename}" />
                                                                <!--  Open Directory  -->
                                                                <MenuItem
                                                                    Command="{Binding Screenshots.OpenDirCommand}"
                                                                    CommandParameter="{Binding Screenshots.SelectedScreenshot}"
                                                                    Header="{lang:Translate common.open.directory}" />
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                    </DataGrid>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!--  Settings  -->
                                    <Grid Margin="25,0,25,25" RowDefinitions="Auto, *">
                                        <!--  Settings Buttons  -->
                                        <Border Classes="SettingsTabBorder">
                                            <WrapPanel Classes="SettingsTabWrapper">
                                                <Button
                                                    Name="JavaSettingsBtn"
                                                    Classes="SettingsTabBtn SettingsTabBtnActive"
                                                    Command="{Binding Settings.SwitchSettingsTabCommand}"
                                                    CommandParameter="{x:Static enums:EInstanceSettingsTab.JAVA}">
                                                    <TextBlock Text="{lang:Translate settings.tab.java}" />
                                                </Button>
                                                <Button
                                                    Name="GameSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding Settings.SwitchSettingsTabCommand}"
                                                    CommandParameter="{x:Static enums:EInstanceSettingsTab.GAME}">
                                                    <TextBlock Text="{lang:Translate settings.tab.game}" />
                                                </Button>
                                                <Button
                                                    Name="CustomCommandSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding Settings.SwitchSettingsTabCommand}"
                                                    CommandParameter="{x:Static enums:EInstanceSettingsTab.CUSTOM_COMMAND}">
                                                    <TextBlock Text="{lang:Translate settings.tab.customCommands}" />
                                                </Button>
                                                <Button
                                                    Name="EnvironmentSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding Settings.SwitchSettingsTabCommand}"
                                                    CommandParameter="{x:Static enums:EInstanceSettingsTab.ENVIRONMENT}">
                                                    <TextBlock Text="{lang:Translate settings.tab.environment}" />
                                                </Button>
                                                <Button
                                                    Name="MiscSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding Settings.SwitchSettingsTabCommand}"
                                                    CommandParameter="{x:Static enums:EInstanceSettingsTab.MISC}">
                                                    <TextBlock Text="{lang:Translate settings.tab.misc}" />
                                                </Button>
                                            </WrapPanel>
                                        </Border>

                                        <!--  Settings Content  -->
                                        <Carousel
                                            Grid.Row="1"
                                            Margin="0,15,0,0"
                                            SelectedIndex="{Binding InstanceSettingsTab}">
                                            <Carousel.PageTransition>
                                                <CompositePageTransition>
                                                    <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                                                </CompositePageTransition>
                                            </Carousel.PageTransition>
                                            <Carousel.Items>
                                                <!--  Java  -->
                                                <ScrollViewer Padding="0,0,15,0">
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <!--  General Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.launcher.subtitle.general}" />

                                                                <!--  Minimum Memory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.minMemory}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\ MB"
                                                                        Increment="128"
                                                                        Maximum="{Binding Settings.InstanceConfig.Java.MaxMemory}"
                                                                        Minimum="512"
                                                                        Value="{Binding Settings.InstanceConfig.Java.MinMemory, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Maximum Memory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.maxMemory}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\ MB"
                                                                        Increment="128"
                                                                        Maximum="131072"
                                                                        Minimum="512"
                                                                        Value="{Binding Settings.InstanceConfig.Java.MaxMemory, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  PermGen  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.permaGen}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\ MB"
                                                                        Increment="128"
                                                                        Maximum="1024"
                                                                        Minimum="8"
                                                                        Value="{Binding Settings.InstanceConfig.Java.PermaGen, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Java Path  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 350, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.path}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        PlaceholderText="{lang:Translate common.select.directory}"
                                                                        Text="{Binding Settings.InstanceConfig.Java.DefaultJavaPath, Mode=TwoWay}" />
                                                                    <StackPanel
                                                                        Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="5">
                                                                        <Button
                                                                            Classes="IconBtn"
                                                                            Command="{Binding Settings.JavaDirSelectCommand}"
                                                                            CommandParameter="9">
                                                                            <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                        </Button>
                                                                        <Button Classes="IconBtn" Command="{Binding Settings.JavaPathSelectorCommand}">
                                                                            <TextBlock Classes="FontAwesome" Text="&#xf126;" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!--  JVM Arguments  Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel Spacing="10">
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.java.jvmArgs}" />

                                                                <!--  Input  -->
                                                                <TextBox
                                                                    MinHeight="128"
                                                                    MaxLines="512"
                                                                    Text="{Binding Settings.InstanceConfig.Java.JvmArguments, Mode=TwoWay}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  Game  -->
                                                <ScrollViewer Padding="0,0,15,0">
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <!--  Window  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.edit.subTitle.window}" />

                                                                <!--  Start Maximized  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.startMaximized}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.StartMaximized, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Window Width  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.windowWidth}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0"
                                                                        Increment="10"
                                                                        IsEnabled="{Binding !Settings.InstanceConfig.Game.StartMaximized}"
                                                                        Maximum="{x:Static local:App.ScreenWidth}"
                                                                        Minimum="100"
                                                                        Value="{Binding Settings.InstanceConfig.Game.WindowWidth, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Window Height  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.windowHeight}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0"
                                                                        Increment="10"
                                                                        IsEnabled="{Binding !Settings.InstanceConfig.Game.StartMaximized}"
                                                                        Maximum="{x:Static local:App.ScreenHeight}"
                                                                        Minimum="100"
                                                                        Value="{Binding Settings.InstanceConfig.Game.WindowHeight, Mode=TwoWay}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!--  Console  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.edit.subTitle.console}" />

                                                                <!--  Show console  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate instance.edit.settings.console.showStart}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.ShowConsoleWhileGameRunning, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Auto close console  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate instance.edit.settings.console.closeExit}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.CloseConsoleOnGameExit, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Show console on crash  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate instance.edit.settings.console.showCrash}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.ShowConsoleWhenGameCrashes, Mode=TwoWay}" />
                                                                </Grid>

                                                            </StackPanel>
                                                        </Border>

                                                        <!--  Performance  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.edit.subTitle.performance}" />

                                                                <!--  Enable Feral GameMode  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.enableGameMode}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.EnableFeralGameMode, Mode=TwoWay}"
                                                                        IsVisible="{Binding IsLinux}" />
                                                                </Grid>

                                                                <!--  Enable MangoHud  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.enableMangoHud}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.EnableMangoHud, Mode=TwoWay}"
                                                                        IsVisible="{Binding IsLinux}" />
                                                                </Grid>

                                                                <!--  Use dedicated GPU  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.useDedicatedGpu}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Game.UseDedicatedGpu, Mode=TwoWay}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  Custom Commands  -->
                                                <ScrollViewer Padding="0,0,15,0">
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.misc.subtitle.customCommands}" />

                                                                <!--  Pre-launch Command  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <StackPanel MaxWidth="200" HorizontalAlignment="Left">
                                                                        <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.prelaunchCommand}" />
                                                                        <TextBlock
                                                                            Classes="SettingsDescription"
                                                                            Text="{lang:Translate settings.misc.prelaunchCommand.description}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding Settings.InstanceConfig.Commands.PreLaunchCommand, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Wrapper Command  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <StackPanel MaxWidth="200" HorizontalAlignment="Left">
                                                                        <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.wrapperCommand}" />
                                                                        <TextBlock
                                                                            Classes="SettingsDescription"
                                                                            Text="{lang:Translate settings.misc.wrapperCommand.description}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding Settings.InstanceConfig.Commands.WrapperCommand, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Post-exit Command  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <StackPanel MaxWidth="200" HorizontalAlignment="Left">
                                                                        <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.postExitCommand}" />
                                                                        <TextBlock
                                                                            Classes="SettingsDescription"
                                                                            Text="{lang:Translate settings.misc.postExitCommand.description}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding Settings.InstanceConfig.Commands.PostExitCommand, Mode=TwoWay}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  Environment Variables  -->
                                                <ScrollViewer Padding="0,0,15,0">
                                                    <Border Classes="SettingsCategoryBorder">
                                                        <Grid RowDefinitions="Auto, Auto, *, Auto">
                                                            <!--  Category Title  -->
                                                            <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.environment.subtitle}" />

                                                            <!--  Enable  -->
                                                            <Grid
                                                                Grid.Row="1"
                                                                Classes="SettingsContentGrid"
                                                                ColumnDefinitions="*, 150">
                                                                <TextBlock Classes="SettingsName" Text="{lang:Translate settings.environment.enable}" />
                                                                <ToggleSwitch
                                                                    Grid.Column="1"
                                                                    Classes="SettingsSwitch"
                                                                    IsChecked="{Binding Settings.InstanceConfig.EnableEnvironment, Mode=TwoWay}" />
                                                            </Grid>

                                                            <!--  Content  -->
                                                            <Border Grid.Row="2">
                                                                <ScrollViewer Classes="TableScrollViewer">
                                                                    <DataGrid
                                                                        Classes="InstanceMultiTable"
                                                                        IsEnabled="{Binding Settings.InstanceConfig.EnableEnvironment}"
                                                                        IsReadOnly="False"
                                                                        ItemsSource="{Binding Settings.InstanceConfig.Environment}"
                                                                        RowEditEnded="EnvironmentDataGrid_OnRowEditEnded"
                                                                        SelectedIndex="{Binding Settings.SelectedEnvironmentVariableIndex}">
                                                                        <DataGrid.Columns>
                                                                            <!--  Name  -->
                                                                            <DataGridTextColumn
                                                                                Width="Auto"
                                                                                Binding="{Binding Key}"
                                                                                Header="{lang:Translate settings.environment.name}" />
                                                                            <!--  Value  -->
                                                                            <DataGridTextColumn
                                                                                Width="Auto"
                                                                                Binding="{Binding Value}"
                                                                                Header="{lang:Translate settings.environment.value}" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ScrollViewer>
                                                            </Border>

                                                            <!--  Actions  -->
                                                            <Grid
                                                                Grid.Row="3"
                                                                Margin="4,10,4,0"
                                                                ColumnDefinitions="Auto, Auto, Auto"
                                                                ColumnSpacing="5">
                                                                <!--  Add button  -->
                                                                <Button
                                                                    Classes="IconBtn"
                                                                    Click="AddEnvironmentRow_OnClick"
                                                                    IsEnabled="{Binding Settings.InstanceConfig.EnableEnvironment}">
                                                                    <WrapPanel Classes="IconBtnWrapper">
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Classes="FontAwesome"
                                                                            Text="&#x2b;" />
                                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.add}" />
                                                                    </WrapPanel>
                                                                </Button>
                                                                <!--  Remove button  -->
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Classes="IconBtn"
                                                                    Click="RemoveEnvironmentRow_OnClick"
                                                                    IsEnabled="{Binding Settings.CanRemoveEnvironmentVariable}">
                                                                    <WrapPanel Classes="IconBtnWrapper">
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Classes="FontAwesome"
                                                                            Text="&#xf068;" />
                                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.remove}" />
                                                                    </WrapPanel>
                                                                </Button>
                                                                <!--  Clear button  -->
                                                                <Button
                                                                    Grid.Column="2"
                                                                    Classes="IconBtn"
                                                                    Click="ClearEnvironmentTable_OnClick"
                                                                    IsEnabled="{Binding Settings.InstanceConfig.EnableEnvironment}">
                                                                    <WrapPanel Classes="IconBtnWrapper">
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Classes="FontAwesome"
                                                                            Text="&#xf1f8;" />
                                                                        <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.clear}" />
                                                                    </WrapPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </ScrollViewer>

                                                <!--  Misc  -->
                                                <ScrollViewer Padding="0,0,15,0">
                                                    <StackPanel Classes="SettingsWrapper">

                                                        <!--  Native Libraries  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.misc.subtitle.nativeLibraries}" />

                                                                <!--  Use custom GLFW  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.customGLFW}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Misc.UseCustomGlfw, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  GLFW library path  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.pathGLFW}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        IsEnabled="{Binding Settings.InstanceConfig.Misc.UseCustomGlfw}"
                                                                        PlaceholderText="{lang:Translate common.select.file}"
                                                                        Text="{Binding Settings.InstanceConfig.Misc.CustomGlfwPath, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Use custom OpenAL  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.customOpenAL}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Misc.UseCustomOpenAL, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  OpenAL library path  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.pathOpenAL}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        IsEnabled="{Binding Settings.InstanceConfig.Misc.UseCustomOpenAL}"
                                                                        PlaceholderText="{lang:Translate common.select.file}"
                                                                        Text="{Binding Settings.InstanceConfig.Misc.CustomOpenALPath, Mode=TwoWay}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!--  Preferences  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.misc.subtitle.preferences}" />

                                                                <!--  Override Account  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.overrideAccount}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Misc.OverrideAccount, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Account  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <!--  Text  -->
                                                                    <TextBlock Classes="TextDropdown" Text="{lang:Translate settings.misc.account}" />
                                                                    <!--  Input  -->
                                                                    <ComboBox
                                                                        Grid.Column="1"
                                                                        Margin="0,0,5,0"
                                                                        Classes="TextDropdown"
                                                                        DisplayMemberBinding="{Binding DisplayName}"
                                                                        IsEnabled="{Binding Settings.InstanceConfig.Misc.OverrideAccount}"
                                                                        ItemsSource="{Binding Accounts}"
                                                                        SelectedIndex="{Binding Settings.OverridenAccountIndex}"
                                                                        SelectionChanged="OverridenAccount_SelectionChanged" />
                                                                </Grid>

                                                                <!--  Set target server  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.serverQuickPlay}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding Settings.InstanceConfig.Misc.JoinServerOnLaunch, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Server address  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <!--  Text  -->
                                                                    <TextBlock Classes="TextDropdown" Text="{lang:Translate settings.misc.serverAddress}" />
                                                                    <!--  Input  -->
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        IsEnabled="{Binding Settings.InstanceConfig.Misc.JoinServerOnLaunch}"
                                                                        PlaceholderText="192.168.1.0:25565"
                                                                        Text="{Binding Settings.InstanceConfig.Misc.ServerAddress}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Carousel.Items>
                                        </Carousel>
                                    </Grid>

                                </Carousel.Items>
                            </Carousel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>