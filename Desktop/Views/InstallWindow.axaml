<Window
    CanResize="False"
    Height="250"
    Icon="../Assets/Images/logo.png"
    ShowInTaskbar="False"
    Title="Starting..."
    Width="400"
    d:DesignHeight="250"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.InstallWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tavstal.KonkordLauncher.Desktop.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Classes="ModalView">
        <StackPanel
            Classes="ModalWrapper"
            Spacing="10">
            <!-- Title -->
            <TextBlock Classes="StartupProgressText" FontWeight="500" FontSize="18" Margin="0, 0, 0, 10" Text="Downloading Game Files..." />
            <!-- Step -->
            <TextBlock Classes="StartupProgressText" FontSize="14" Margin="0, 0, 0, 5" Text="Download Complete!" />
            <!-- Detail -->
            <TextBlock Classes="StartupProgressText" FontWeight="300" FontSize="12" Margin="0, 0, 0, 20" Text="Installation finished. You can close this window." />
            <!-- Progress bar -->
            <ProgressBar
                Classes="StartupProgress" Margin="0, 0, 0, 20" />
            <!-- Button -->
            <Button Classes="IconBtn PrimaryBtn" HorizontalAlignment="Center">
                <TextBlock Text="Close" Padding="5" />
            </Button>
        </StackPanel>
    </Border>
</Window>
