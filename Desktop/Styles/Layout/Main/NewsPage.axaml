<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  NewsPageWrapper  -->
    <Style Selector="ListBox.NewsPageWrapper">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.NewsPageWrapper &gt; ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="ListBox.NewsPageWrapper &gt; ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.NewsPageWrapper &gt; ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!--  End Of NewsPageWrapper  -->

    <Style Selector="Border.NewsCard">
        <Setter Property="Background" Value="{DynamicResource base-100}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Margin" Value="0, 0, 20, 0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.NewsCardTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.NewsCardDescription">
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
