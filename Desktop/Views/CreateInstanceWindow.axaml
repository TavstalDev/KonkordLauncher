<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.CreateInstanceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Enums"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Pages.CreateInstance"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    Title="{lang:Translate instance.create.title}"
    Width="900"
    Height="500"
    MinWidth="900"
    MinHeight="500"
    d:DesignHeight="500"
    d:DesignWidth="900"
    x:DataType="vm:CreateInstanceViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <!--  Main window body  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar />

                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">
                    <!--  Title  -->
                    <TextBlock
                        Margin="25,0,25,15"
                        HorizontalAlignment="Left"
                        Classes="InstanceTitle"
                        Text="{lang:Translate instance.create.instance.title}" />

                    <!--  Tab Buttons  -->
                    <Border
                        Grid.Row="1"
                        Margin="25,0,25,0"
                        Classes="SettingsTabBorder">
                        <WrapPanel Classes="SettingsTabWrapper">
                            <Button
                                Name="CustomTabBtn"
                                Classes="SettingsTabBtn SettingsTabBtnActive"
                                Command="{Binding HandleTabBtnCommand}"
                                CommandParameter="{x:Static enums:ECreateInstanceTab.CUSTOM}">
                                <TextBlock Text="{lang:Translate instance.create.tab.custom}" />
                            </Button>
                            <Button
                                Name="ModpackTabBtn"
                                Classes="SettingsTabBtn"
                                Command="{Binding HandleTabBtnCommand}"
                                CommandParameter="{x:Static enums:ECreateInstanceTab.MODPACK}">
                                <TextBlock Text="{lang:Translate instance.create.tab.modpacks}" />
                            </Button>
                            <Button
                                Name="ImportTabBtn"
                                Classes="SettingsTabBtn"
                                Command="{Binding HandleTabBtnCommand}"
                                CommandParameter="{x:Static enums:ECreateInstanceTab.IMPORT}">
                                <TextBlock Text="{lang:Translate instance.create.tab.import}" />
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!--  Content  -->
                    <Carousel
                        Grid.Row="2"
                        Margin="0,15,0,0"
                        SelectedIndex="{Binding SelectedTab}">
                        <Carousel.PageTransition>
                            <CompositePageTransition>
                                <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                            </CompositePageTransition>
                        </Carousel.PageTransition>
                        <Carousel.Items>
                            <pages:CustomPage />
                            <pages:ModpackPage />
                            <pages:ImportPage />
                        </Carousel.Items>
                    </Carousel>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>
