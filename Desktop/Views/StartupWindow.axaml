<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.StartupWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate startup.title}"
    Width="300"
    d:DesignWidth="300"
    x:DataType="vm:StartupViewModel"
    Background="Transparent"
    CanResize="False"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border
        Background="{DynamicResource base-200}"
        BorderBrush="{DynamicResource border-one}"
        BorderThickness="1"
        CornerRadius="14"
        PointerPressed="DragStart_PointerPressed">
        <Grid RowDefinitions="Auto, *">
            <!--  Window Controls  -->
            <templates:CustomTitleBar/>
            <!--  Main Content  -->
            <Border
                Grid.Row="1"
                Padding="20,0,20,35"
                Classes="ModalView"
                PointerPressed="DragStart_PointerPressed">
                <Grid
                    Classes="ModalWrapper"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="10">
                    <!--  Logo  -->
                    <Image Classes="StartupLogo" Source="avares://Desktop/Assets/Images/logo.png" />
                    <!--  Progress bar  -->
                    <ProgressBar
                        Name="ProgressBar"
                        Grid.Row="1"
                        Classes="StartupProgress"
                        Value="{Binding Progress}" />
                    <!--  Progress text  -->
                    <TextBlock
                        Grid.Row="2"
                        Classes="StartupProgressText"
                        Text="{Binding ProgressText}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
