<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  AccountsPageContainer  -->
    <Style Selector="ListBox.AccountsPageContainer">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0, 0, 15, 0" />
    </Style>

    <Style Selector="ListBox.AccountsPageContainer &gt; ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="ListBox.AccountsPageContainer &gt; ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.AccountsPageContainer &gt; ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!--  End Of AccountsPageContainer  -->

    <Style Selector="UniformGrid.AccountsPageWrapper">
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="RowSpacing" Value="10" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.AccountsCard">
        <Setter Property="Background" Value="{DynamicResource base-100}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Height" Value="80" />
    </Style>

    <Style Selector="Border.AccountsCard.selected">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource primary}" />
    </Style>

    <Style Selector="TextBlock.AccountsCardName">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Grid.AccountsCardWrapper">
        <Setter Property="RowSpacing" Value="5" />
        <Setter Property="ColumnSpacing" Value="5" />
    </Style>
</Styles>
