<UserControl
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Pages.EditInstance.ServersPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:EditInstanceViewModel"
    mc:Ignorable="d">
    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
        <Grid RowDefinitions="Auto, *, Auto">
            <!--  Title  -->
            <TextBlock
                Margin="5,5,5,10"
                Classes="SettingsCategoryText"
                Text="{lang:Translate instance.edit.subTitle.servers}" />

            <!--  Content  -->
            <Border Grid.Row="1">
                <ScrollViewer Classes="TableScrollViewer" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid
                        Classes="InstanceMultiTable"
                        IsReadOnly="False"
                        ItemsSource="{Binding Servers.Servers}"
                        RowEditEnded="ServersDataGrid_OnRowEditEnded"
                        SelectedItem="{Binding Servers.SelectedServer}">
                        <DataGrid.Columns>
                            <!--  Icon & Name  -->
                            <DataGridTemplateColumn Width="*" Header="{lang:Translate instance.edit.table.name}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Image
                                                Height="48"
                                                MaxWidth="48"
                                                Margin="5"
                                                Source="{Binding Image.Value}"
                                                Stretch="UniformToFill" />
                                            <TextBlock
                                                Margin="0,0,25,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Margin="5,0,25,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <!--  Address  -->
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Ip}"
                                Header="{lang:Translate instance.edit.table.ipAddress}" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <!--  Remove  -->
                                <MenuItem
                                    Command="{Binding Servers.RemoveCommand}"
                                    CommandParameter="{Binding Servers.SelectedServer}"
                                    Header="{lang:Translate common.remove}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </ScrollViewer>
            </Border>

            <!--  Actions  -->
            <Grid
                Grid.Row="2"
                Margin="4,10,4,0"
                ColumnDefinitions="*, *, Auto"
                ColumnSpacing="5">
                <!--  Name bar  -->
                <TextBox
                    Grid.Column="0"
                    Classes="TextInput"
                    PlaceholderText="Minecraft Server"
                    Text="{Binding Servers.ServerName}" />
                <!--  Address bar  -->
                <TextBox
                    Grid.Column="1"
                    Classes="TextInput"
                    PlaceholderText="192.168.1.0:25565"
                    Text="{Binding Servers.ServerIp}" />
                <!--  Add  -->
                <Button
                    Grid.Column="2"
                    Classes="IconBtn"
                    Command="{Binding Servers.AddCommand}">
                    <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="FontAwesome"
                            Text="&#x2b;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{lang:Translate common.add}" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>

