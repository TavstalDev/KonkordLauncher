<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="TabControl.SettingsTab">
        <Setter Property="Background" Value="{DynamicResource base-200}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="0" />
    </Style>
    
    <Style Selector="TabItem.SettingsTabItem">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="WrapPanel.SettingsWrapper">
        <Setter Property="LineSpacing" Value="10" />
        <Setter Property="ItemSpacing" Value="10" />
        <Setter Property="Width" Value="440"></Setter>
        <Setter Property="ItemWidth" Value="440" />
        <Setter Property="Margin" Value="25,10,25,25" />
        <Setter Property="Orientation" Value="Vertical" />
    </Style>
    
    <Style Selector="TextBlock.SettingsCategory">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="TextBlock.NumericInput">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="NumericUpDown.NumericInput">
        <Setter Property="ParsingNumberStyle" Value="Integer" />
        <Setter Property="ShowButtonSpinner" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="TextBlock.TextDropdown">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="ComboBox.TextDropdown">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="TextBlock.TextInput">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="TextBox.TextInput">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
</Styles>