      </Compile>
      <Compile Update="Views\Dialogs\InstanceLogsWindow.axaml.cs">
        <DependentUpon>InstanceLogsWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Dialogs\InputWindow.axaml.cs">
        <DependentUpon>InputWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Dialogs\ResourceDownloadWindow.axaml.cs">
        <DependentUpon>ResourceDownloadWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\LICENSE">
          <Link>Assets\LICENSE</Link>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\Icons\**\*" />
        <EmbeddedResource Include="Assets\Fmllib\**\*" />
    </ItemGroup>
</Project>
