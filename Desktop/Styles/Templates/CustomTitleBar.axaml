<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates">
    <Style Selector="templates|CustomTitleBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_DragArea"
                    HorizontalAlignment="Stretch"
                    Background="{TemplateBinding Background}">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Classes="WindowTitle" Text="{Binding $parent[Window].Title}" />

                        <StackPanel Grid.Column="1" Classes="WindowBtnPanel">
                            <Button
                                x:Name="PART_MinimizeButton"
                                Classes="WindowBtn WarningBtn"
                                ToolTip.Tip="{lang:Translate main.window.minimize}" />

                            <Button
                                x:Name="PART_MaximizeButton"
                                Classes="WindowBtn SuccessBtn"
                                IsEnabled="{Binding $parent[Window].CanResize}"
                                ToolTip.Tip="{lang:Translate main.window.maximize}" />

                            <Button
                                x:Name="PART_CloseButton"
                                Classes="WindowBtn ErrorBtn"
                                ToolTip.Tip="{lang:Translate main.window.close}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
