<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Enums"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Pages.Main"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    Title="{lang:Translate main.title}"
    Width="950"
    Height="600"
    d:DesignHeight="600"
    d:DesignWidth="950"
    x:DataType="vm:MainViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="True"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--  Content  -->
    <Grid>
        <!--  Main Window Content  -->
        <Border
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14">
            <Grid ColumnDefinitions="250, *">
                <!--  Sidebar  -->
                <Border
                    Background="{DynamicResource base-300}"
                    BorderBrush="{DynamicResource border-one}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="14, 0, 0, 14"
                    PointerPressed="DragStart_PointerPressed">
                    <Grid Margin="20,40,20,30" RowDefinitions="Auto, *, Auto">
                        <!--  Title  -->
                        <TextBlock
                            Margin="10,0,0,40"
                            FontSize="20"
                            FontWeight="Black"
                            Foreground="{DynamicResource primary}"
                            LetterSpacing="4"
                            Text="KONKORD" />

                        <!--  Buttons  -->
                        <StackPanel Grid.Row="1">
                            <Button
                                Name="PlaySideBtn"
                                Classes="SidebarBtn SideBarActiveBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Play}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf04b;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate main.sidebar.play}" />
                                </Grid>
                            </Button>
                            <Button
                                Name="NewsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Patch}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf15c;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate main.sidebar.patch}" />
                                </Grid>
                            </Button>
                            <Button
                                Name="AccountsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Accounts}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf0c0;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate main.sidebar.accounts.label}" />
                                </Grid>
                            </Button>
                            <Button
                                Name="SkinsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Skins}"
                                IsEnabled="{Binding Accounts.IsMojangAccount}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf553;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate main.sidebar.skins}" />
                                </Grid>
                            </Button>
                            <Button
                                Name="SettingsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Settings}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf013;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate main.sidebar.settings}" />
                                </Grid>
                            </Button>
                            <Button
                                Name="AboutSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.About}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf02d;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate main.sidebar.about}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!--  Account Info  -->
                        <Border
                            Grid.Row="2"
                            Height="75"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource base-100}"
                            BorderBrush="{DynamicResource border-two}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <!--  Avatar  -->
                                <Image
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding Accounts.AccountAvatar.Value}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="5"
                                    VerticalAlignment="Center">
                                    <!--  Logged in text  -->
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiLight"
                                        Foreground="{DynamicResource text-faded}"
                                        Text="{lang:Translate main.sidebar.accounts.loggedin}" />
                                    <!--  Username  -->
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource base-content}"
                                        Text="{Binding Accounts.AccountName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  Main Content  -->
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource base-200}"
                    CornerRadius="0, 14, 14, 0"
                    PointerPressed="DragStart_PointerPressed">
                    <Grid RowDefinitions="Auto, *">
                        <!--  Window Controls  -->
                        <templates:CustomTitleBar />

                        <!--  Content Area  -->
                        <Border Grid.Row="1" Margin="0,0,0,20">
                            <Carousel SelectedIndex="{Binding CurrentPageIndex}">
                                <Carousel.PageTransition>
                                    <CompositePageTransition>
                                        <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                                    </CompositePageTransition>
                                </Carousel.PageTransition>
                                <Carousel.Items>
                                    <pages:PlayPage />
                                    <pages:PatchPage />
                                    <pages:AccountsPage />
                                    <pages:SkinsPage />
                                    <pages:SettingsPage />
                                    <pages:AboutPage />
                                </Carousel.Items>
                            </Carousel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>
