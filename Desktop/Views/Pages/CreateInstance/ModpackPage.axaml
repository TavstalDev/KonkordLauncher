<UserControl
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Pages.CreateInstance.ModpackPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:LoadingIndicators.Avalonia;assembly=LoadingIndicators.Avalonia"
    xmlns:converters="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Instance"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:CreateInstanceViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="*, Auto">
        <!--  Content  -->
        <Grid
            Margin="25,0,25,15"
            Classes="SettingsWrapper"
            ColumnDefinitions="180, *">
            <!--  Filters  -->
            <Border Classes="SettingsCategoryBorder">
                <ScrollViewer>
                    <Grid
                        Margin="0,0,10,0"
                        RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                        RowSpacing="10">
                        <!--  Search  -->
                        <TextBox
                            MinHeight="30"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            Classes="TextInput"
                            FontSize="12"
                            IsReadOnly="{Binding !Modpack.AllowScrollbarRefresh}"
                            PlaceholderText="{lang:Translate common.search}"
                            Text="{Binding Modpack.SearchQuery, Delay=500}" />

                        <!--  Platform  -->
                        <Grid
                            Grid.Row="1"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="8">
                            <!--  Text  -->
                            <TextBlock
                                Classes="TextInput"
                                FontSize="12"
                                Foreground="{DynamicResource text-muted}"
                                Text="{lang:Translate instance.create.modpack.platform}" />
                            <!--  Input  -->
                            <ComboBox
                                Grid.Row="1"
                                MinHeight="30"
                                Classes="TextDropdown"
                                FontSize="12"
                                IsEnabled="False"
                                IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}"
                                ItemsSource="{Binding Modpack.AvailablePlatforms}"
                                SelectedItem="{Binding Modpack.SelectedPlatform}"
                                SelectionChanged="ModPackFilter_OnSelectionChanged" />
                        </Grid>

                        <!--  ModLoader  -->
                        <Grid
                            Grid.Row="2"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="8">
                            <!--  Text  -->
                            <TextBlock
                                Classes="TextInput"
                                FontSize="12"
                                Foreground="{DynamicResource text-muted}"
                                Text="{lang:Translate instance.create.modpack.mod.loader}" />
                            <!--  Input  -->
                            <ComboBox
                                Grid.Row="1"
                                MinHeight="30"
                                Classes="TextDropdown"
                                FontSize="12"
                                IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}"
                                SelectedIndex="0"
                                SelectedValue="{Binding Modpack.ModLoader}"
                                SelectionChanged="ModPackFilter_OnSelectionChanged">
                                <ComboBoxItem Content="Any" />
                                <ComboBoxItem Content="NeoForge" />
                                <ComboBoxItem Content="Forge" />
                                <ComboBoxItem Content="Fabric" />
                                <ComboBoxItem Content="Quilt" />
                            </ComboBox>
                        </Grid>

                        <!--  Minecraft Version  -->
                        <Grid
                            Grid.Row="3"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="8">
                            <!--  Text  -->
                            <TextBlock
                                Classes="TextInput"
                                FontSize="12"
                                Foreground="{DynamicResource text-muted}"
                                Text="{lang:Translate instance.create.modpack.minecraft.version}" />
                            <!--  Input  -->
                            <ComboBox
                                Grid.Row="1"
                                MinHeight="30"
                                Classes="TextDropdown"
                                FontSize="12"
                                IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}"
                                ItemsSource="{Binding Modpack.VersionFilterSource}"
                                SelectedIndex="0"
                                SelectedValue="{Binding Modpack.MinecraftVersion}"
                                SelectionChanged="ModPackFilter_OnSelectionChanged" />
                        </Grid>

                        <!--  Categories  -->
                        <StackPanel Grid.Row="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource text-muted}"
                                Text="{lang:Translate common.categories}" />

                            <ItemsControl ItemsSource="{Binding Modpack.Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CategoryModel">
                                        <CheckBox Classes="InstanceModCategory"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsChecked}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!--  Content  -->
            <Grid
                Grid.Column="1"
                ColumnDefinitions="*, Auto, *"
                ColumnSpacing="10">
                <!--  Modpack List  -->
                <Border Classes="SettingsCategoryBorder">
                    <Grid>
                        <!--  Content  -->
                        <ListBox
                            x:Name="ModpackList"
                            Padding="0,0,10,0"
                            Background="Transparent"
                            ItemsSource="{Binding Modpack.Modpacks}"
                            Opacity="{Binding Modpack.AllowScrollbarRefresh, Converter={StaticResource BoolToOpacityConverter}}"
                            SelectedItem="{Binding Modpack.SelectedModpack}"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ModPackPreviewModel">
                                    <Border Classes="InstanceModCard">
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                            <Image Width="35" Height="35"
                                                   Source="{Binding Icon.Value}" />
                                            <Grid Grid.Column="1" RowDefinitions="Auto, Auto">
                                                <TextBlock
                                                    Classes="InstanceModTitle"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    MaxLines="2"
                                                    Classes="InstanceModDescription"
                                                    Text="{Binding Description}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border IsVisible="{Binding !Modpack.AllowScrollbarRefresh}"
                                Background="#99000000">
                            <avalonia:LoadingIndicator Height="150"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource primary-content}"
                                                       IsActive="True"
                                                       Mode="Arc"
                                                       SpeedRatio="1.2" />
                        </Border>
                    </Grid>
                </Border>

                <!--  Grid Splitter  -->
                <GridSplitter Grid.Column="1" Classes="InstanceSplitter" />

                <!--  Modpack preview  -->
                <Border
                    Grid.Column="2"
                    Padding="10,0"
                    Classes="SettingsCategoryBorder">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <HtmlLabel
                            Margin="0,0,10,0"
                            HorizontalAlignment="Stretch"
                            BaseStylesheet="{DynamicResource HtmlBaseStyle}"
                            Text="{Binding Modpack.SelectedModpackMarkdownBody}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!--  Buttons  -->
        <Border Grid.Row="1" Classes="InstanceButtonBorder">
            <Grid ColumnDefinitions="250, 200, *" ColumnSpacing="10">
                <!--  Modpack Version  -->
                <ComboBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="TextDropdown"
                    ItemsSource="{Binding Modpack.SelectedModpackVersions}"
                    PlaceholderText="{lang:Translate instance.create.modpack.select}"
                    SelectedIndex="{Binding Modpack.SelectedModpackVersionIndex}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding .}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  Instance Name  -->
                <TextBox
                    Grid.Column="1"
                    Classes="TextInput"
                    PlaceholderText="My Instance Name"
                    Text="{Binding Modpack.InstanceName, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Action buttons  -->
                <StackPanel Grid.Column="2" Classes="InstanceButtonWrapper">
                    <!--  Cancel Button  -->
                    <Button Classes="IconBtn ErrorBtn" Command="{Binding Custom.CustomCancelCreateCommand}">
                        <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf00d;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="500"
                                Text="{lang:Translate common.cancel}" />
                        </Grid>
                    </Button>
                    <!--  Create Instance Button  -->
                    <Button
                        Classes="IconBtn SuccessBtn"
                        Command="{Binding Modpack.CreateInstanceCommand}"
                        IsEnabled="{Binding Modpack.CanCreateInstance}">
                        <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf0c7;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="500"
                                Text="{lang:Translate instance.create.button}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>

