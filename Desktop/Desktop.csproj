<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>KonkordLauncher</AssemblyTitle>
        <Description>A modern, user-friendly launcher for Minecraft, designed to enhance the gaming experience with a sleek interface and powerful features.</Description>
        <Company>Tavstal</Company>
        <Product>KonkordLauncher</Product>
        <Copyright>Copyright © 2026 Tavstal</Copyright>
        <ComVisible>false</ComVisible>
        <Guid>5C0F1C0A-2258-4DD5-B454-0ED8FFF9E5A8</Guid>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0</FileVersion>
        <Version>2.0.0</Version>

        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Tavstal.KonkordLauncher.Desktop</RootNamespace>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <EnableUnsafeUTF8Json>true</EnableUnsafeUTF8Json>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
        <PackageReference Include="Avalonia.HtmlRenderer" Version="12.0.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
        <PackageReference Include="Markdig" Version="1.1.3" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
        <PackageReference Include="MinecraftSkinRender" Version="1.2.0" />
        <PackageReference Include="MinecraftSkinRender.Image" Version="1.2.0" />
        <PackageReference Include="NbtLib" Version="1.0.1" />
        <PackageReference Include="Optris.LoadingIndicators.Avalonia" Version="12.0.3" />
        <PackageReference Include="QRCoder" Version="1.8.0" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
        <PackageReference Include="ReverseMarkdown" Version="5.3.0" />
        <PackageReference Include="Velopack" Version="0.0.1298" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Common\Common.csproj" />
      <ProjectReference Include="..\Core\Core.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Include="Styles\**" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Views\MainWindow.axaml.cs">
        <DependentUpon>MainWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\AccountsWindow.axaml.cs">
        <DependentUpon>AccountsWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\CreateInstanceWindow.axaml.cs">
        <DependentUpon>CreateInstanceWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\StartupWindow.axaml.cs">
        <DependentUpon>StartupWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\EditInstanceWindow.axaml.cs">
        <DependentUpon>EditInstanceWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Modals\IconSelectorWindow.axaml.cs">
        <DependentUpon>IconSelectorWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Modals\JavaSelectorWindow.axaml.cs">
        <DependentUpon>JavaSelectorWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Modals\AlertWindow.axaml.cs">
