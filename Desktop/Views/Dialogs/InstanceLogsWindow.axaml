<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.InstanceLogsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    Title="{lang:Translate instance.edit.log.title}"
    Width="800"
    Height="500"
    d:DesignHeight="500"
    d:DesignWidth="800"
    x:DataType="vm:InstanceLogsViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="True"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <!--  Main Window Content  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar />

                <!--  Main Content  -->
                <Grid
                    Grid.Row="1"
                    Margin="25,0,25,25"
                    RowDefinitions="Auto,*">
                    <!--  Title  -->
                    <WrapPanel ItemSpacing="10">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Classes="InstanceTitle"
                            Text="{lang:Translate instance.logs.title}" />
                        <TextBlock
                            HorizontalAlignment="Left"
                            Classes="InstanceTitle"
                            Text="{Binding InstanceName}" />
                    </WrapPanel>
                    <!--  Content  -->
                    <Grid
                        Grid.Row="1"
                        Classes="ModalScrollableWrapper"
                        RowDefinitions="*, Auto">
                        <!--  Log content  -->
                        <Border
                            Grid.Row="0"
                            Background="{DynamicResource base-100}"
                            Classes="GridInnerContent">
                            <ScrollViewer
                                Name="LogsScrollViewer"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.8"
                                    Text="{Binding Logs}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <!--  Actions  -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*, Auto, Auto, Auto"
                            ColumnSpacing="5">
                            <!--  Search bar  -->
                            <TextBox
                                Grid.Column="0"
                                Classes="TextInput"
                                PlaceholderText="{lang:Translate common.search}" />
                            <!--  To bottom button  -->
                            <Button
                                Grid.Column="1"
                                Classes="IconBtn DefaultBtn"
                                Command="{Binding ScrollLogsToEndCommand}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xe4b8;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate common.bottom}" />
                                </Grid>
                            </Button>
                            <!--  Copy button  -->
                            <Button
                                Grid.Column="2"
                                Classes="IconBtn DefaultBtn"
                                Command="{Binding CopyLogsCommand}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf0c5;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate common.copy}" />
                                </Grid>
                            </Button>
                            <!--  Clear button  -->
                            <Button
                                Grid.Column="3"
                                Classes="IconBtn ErrorBtn"
                                Command="{Binding ClearLogsCommand}">
                                <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf1b8;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{lang:Translate common.clear}" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>
