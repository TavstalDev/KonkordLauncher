<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="WrapPanel.NewsPageWrapper">
        <Setter Property="LineSpacing" Value="10" />
        <Setter Property="ItemSpacing" Value="10" />
        <Setter Property="MaxHeight" Value="440" />
    </Style>

    <Style Selector="Border.NewsCard">
        <Setter Property="Background" Value="{DynamicResource base-200}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="15" />
    </Style>

    <Style Selector="TextBlock.NewsCardTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.NewsCardDescription">
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>