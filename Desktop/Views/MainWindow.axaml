<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Tavstal.KonkordLauncher.Core.Models;assembly=Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Enums"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:local="clr-namespace:Tavstal.KonkordLauncher.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models"
    xmlns:models1="clr-namespace:Tavstal.KonkordLauncher.Common.Models;assembly=Common"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:domain="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Domain"
    Title="{lang:Translate main.title}"
    Width="950"
    Height="600"
    d:DesignHeight="600"
    d:DesignWidth="950"
    x:DataType="vm:MainViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="True"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Templates -->
    <Window.DataTemplates>
        <!--  Play Card  -->
        <DataTemplate DataType="domain:InstanceModel">
            <Border Classes="PlayCard">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!--  Icon  -->
                    <Image
                        Grid.Row="0"
                        Classes="PlayCardImage"
                        Source="{Binding Icon}" />
                    <!--  Name  -->
                    <TextBlock
                        Grid.Row="1"
                        Classes="PlayCardText"
                        Text="{Binding Name}" />
                    <!--  Buttons  -->
                    <WrapPanel Grid.Row="2" Classes="PlayCardButtonWrapper">
                        <!--  Launch Button  -->
                        <Button
                            Width="32"
                            MaxWidth="32"
                            HorizontalContentAlignment="Center"
                            Classes="IconBtn PrimaryBtn"
                            Command="{Binding $parent[Window].DataContext.LaunchInstanceCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding !IsGameRunning}">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf04b;" />
                        </Button>
                        <!--  Stop Button  -->
                        <Button
                            Width="32"
                            MaxWidth="32"
                            HorizontalContentAlignment="Center"
                            Classes="IconBtn ErrorBtn"
                            Command="{Binding $parent[Window].DataContext.StopInstanceCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding IsGameRunning}">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf04d;" />
                        </Button>
                        <!--  Edit Button  -->
                        <Button
                            Width="34"
                            MaxWidth="34"
                            Classes="IconBtn AccentAltBtn"
                            Command="{Binding $parent[Window].DataContext.EditInstanceCommand}"
                            CommandParameter="{Binding .}">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf304;" />
                        </Button>
                        <!--  Menu Button  -->
                        <Button
                            Width="32"
                            MaxWidth="32"
                            Classes="IconBtn SecondaryBtn">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <!--  Name  -->
                                    <MenuItem Header="{Binding Name}" IsEnabled="False" />
                                    <!--  Launch Btn  -->
                                    <MenuItem
                                        Command="{Binding $parent[Window].DataContext.LaunchInstanceCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding !IsGameRunning}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf04b;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.launch}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Stop Btn  -->
                                    <MenuItem
                                        Command="{Binding $parent[Window].DataContext.StopInstanceCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding IsGameRunning}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf04d;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.stop}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Logs Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.ViewInstanceLogsCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf15c;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate instance.view.logs}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <Separator />
                                    <!--  Rename Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.RenameInstanceCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf044;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.rename}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Change Icon Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.ChangeInstanceIconCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf03e;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate instance.change.icon}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Change Group Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.ChangeInstanceGroupCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf5fd;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate instance.change.group}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <Separator />
                                    <!--  Open Folder Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.OpenInstanceDirCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf07c;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.open.directory}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Export Btn  -->
                                    <MenuItem Header="Export">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf56e;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.export}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                        <MenuItem
                                            Command="{Binding $parent[Window].DataContext.ExportPrismInstanceCommand}"
                                            CommandParameter="{Binding .}"
                                            Header="PrismLauncher" />
                                        <MenuItem
                                            Command="{Binding $parent[Window].DataContext.ExportModrinthInstanceCommand}"
                                            CommandParameter="{Binding .}"
                                            Header="Modrinth" />
                                        <MenuItem
                                            Command="{Binding $parent[Window].DataContext.ExportCurseForgeInstanceCommand}"
                                            CommandParameter="{Binding .}"
                                            Header="CurseForge" />
                                    </MenuItem>
                                    <Separator />
                                    <!--  Delete Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.DeleteInstanceCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf1f8;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.delete}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <!--  Button Icon  -->
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf142;" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  Patch Card  -->
        <DataTemplate DataType="models1:PatchNote">
            <Border Classes="NewsCard">
                <Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto">
                    <!--  News Card Title  -->
                    <TextBlock Classes="NewsCardTitle" Text="{Binding Title}" />
                    <!--  News Card Description  -->
                    <HtmlLabel
                        Grid.Row="1"
                        MaxWidth="{Binding $parent[Grid].Bounds.Width}"
                        BaseStylesheet="body, p, div, span, h1, h2, h3, ul, ol {                          color: white !important;                          font-family: sans-serif;                          white-space: normal;                          word-wrap: break-word;                         }"
                        Text="{Binding Content}" />

                    <!--  Read More Button  -->
                    <HyperlinkButton
                        Grid.Row="2"
                        Classes="IconBtn InfoBtn"
                        NavigateUri="{Binding Url}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf02d;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.page.patch.read}" />
                        </WrapPanel>
                    </HyperlinkButton>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  Account Card  -->
        <DataTemplate DataType="core:Account">
            <Border Classes="AccountsCard" Classes.selected="{Binding IsSelected}">
                <Grid ColumnDefinitions="*, Auto">
                    <!--  Name & Type  -->
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                        <TextBlock Classes="AccountsCardName" Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Buttons  -->
                    <WrapPanel Grid.Column="1" Classes="AccountsCardWrapper">
                        <Button
                            Classes="IconBtn SuccessBtn"
                            Command="{Binding $parent[Window].DataContext.SelectAccountBtnCommand}"
                            CommandParameter="{Binding Id}"
                            IsVisible="{Binding !IsSelected}">
                            <TextBlock Classes="FontAwesome" Text="&#xf00c;" />
                        </Button>
                        <Button
                            Classes="IconBtn WarningBtn"
                            Command="{Binding $parent[Window].DataContext.RefreshAccountBtnCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding CanExpire}">
                            <TextBlock Classes="FontAwesome" Text="&#xf2f9;" />
                        </Button>
                        <Button
                            Classes="IconBtn ErrorBtn"
                            Command="{Binding $parent[Window].DataContext.RemoveAccountBtnCommand}"
                            CommandParameter="{Binding .}">
                            <TextBlock Classes="FontAwesome" Text="&#xf1f8;" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  Skin Card  -->
        <DataTemplate DataType="domain:SkinDataModel">
            <Border Classes="SkinBorder" Classes.selected="{Binding IsSelected}">
                <Button
                    Classes="SkinBtn"
                    Command="{Binding $parent[Window].DataContext.SkinSelectCommand}"
                    CommandParameter="{Binding .}">
                    <Viewbox Classes="SkinViewBox">
                        <Image Classes="SkinPreview" Source="{Binding Image}" />
                    </Viewbox>
                </Button>
            </Border>
        </DataTemplate>
        <!--  Cape Card  -->
        <DataTemplate DataType="domain:CapeDataModel">
            <Border Classes="SkinBorder" Classes.selected="{Binding IsSelected}">
                <Button
                    Classes="SkinBtn"
                    Command="{Binding $parent[Window].DataContext.CapeSelectCommand}"
                    CommandParameter="{Binding .}"
                    ToolTip.Tip="{Binding Alias}">
                    <Viewbox MaxHeight="70" Classes="SkinViewBox">
                        <Image Classes="SkinPreview" Source="{Binding Image}" />
                    </Viewbox>
                </Button>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>
    
    <!-- Content -->
    <Grid>
        <!--  Main Window Content  -->
        <Border
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14">
            <Grid ColumnDefinitions="250, *">
                <!--  Sidebar  -->
                <Border
                    Background="{DynamicResource base-300}"
                    BorderBrush="{DynamicResource border-one}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="14, 0, 0, 14"
                    PointerPressed="DragStart_PointerPressed">
                    <Grid Margin="20,40,20,30" RowDefinitions="Auto, *, Auto">
                        <!--  Title  -->
                        <TextBlock
                            Margin="10,0,0,40"
                            FontSize="20"
                            FontWeight="Black"
                            Foreground="{DynamicResource primary}"
                            LetterSpacing="4"
                            Text="KONKORD" />

                        <!--  Buttons  -->
                        <StackPanel Grid.Row="1">
                            <Button
                                Name="PlaySideBtn"
                                Classes="SidebarBtn SideBarActiveBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Play}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf04b;" />
                                    <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.play}" />
                                </WrapPanel>
                            </Button>
                            <Button
                                Name="NewsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Patch}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf15c;" />
                                    <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.patch}" />
                                </WrapPanel>
                            </Button>
                            <Button
                                Name="AccountsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Accounts}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf0c0;" />
                                    <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.accounts}" />
                                </WrapPanel>
                            </Button>
                            <Button
                                Name="SkinsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Skins}"
                                IsEnabled="{Binding IsMojangAccount}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf553;" />
                                    <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.skins}" />
                                </WrapPanel>
                            </Button>
                            <Button
                                Name="SettingsSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.Settings}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf013;" />
                                    <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.settings}" />
                                </WrapPanel>
                            </Button>
                            <Button
                                Name="AboutSideBtn"
                                Classes="SidebarBtn"
                                Command="{Binding HandleSidebarBtnCommand}"
                                CommandParameter="{x:Static enums:ESidebarType.About}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf02d;" />
                                    <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.about}" />
                                </WrapPanel>
                            </Button>
                        </StackPanel>

                        <!--  Account Info  -->
                        <Border
                            Grid.Row="2"
                            Height="75"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource base-100}"
                            BorderBrush="{DynamicResource border-two}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <!--  Avatar  -->
                                <Image
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding AccountAvatar}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="5"
                                    VerticalAlignment="Center">
                                    <!--  Logged in text  -->
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiLight"
                                        Foreground="{DynamicResource text-faded}"
                                        Text="{lang:Translate main.sidebar.accounts.loggedin}" />
                                    <!--  Username  -->
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource base-content}"
                                        Text="{Binding AccountName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  Main Content  -->
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource base-200}"
                    CornerRadius="0, 14, 14, 0"
                    PointerPressed="DragStart_PointerPressed">
                    <Grid RowDefinitions="Auto, *">
                        <!--  Window Controls  -->
                        <Border HorizontalAlignment="Stretch">
                            <StackPanel Classes="WindowBtnPanel">
                                <!--  MINIMIZE  -->
                                <Button
                                    Classes="WindowBtn WarningBtn"
                                    Command="{Binding MinimizeWindowCommand}"
                                    ToolTip.Tip="{lang:Translate main.window.minimize}" />
                                <!--  MAXIMIZE / RESTORE  -->
                                <Button
                                    Classes="WindowBtn SuccessBtn"
                                    Command="{Binding MaximizeWindowCommand}"
                                    IsEnabled="{Binding $parent[Window].CanResize}"
                                    ToolTip.Tip="{lang:Translate main.window.maximize}" />
                                <!--  CLOSE  -->
                                <Button
                                    Classes="WindowBtn ErrorBtn"
                                    Command="{Binding CloseWindowCommand}"
                                    ToolTip.Tip="{lang:Translate main.window.close}" />
                            </StackPanel>
                        </Border>

                        <!--  Content Area  -->
                        <Border Grid.Row="1" Margin="0,0,0,20">
                            <Carousel SelectedIndex="{Binding CurrentPageIndex}">
                                <Carousel.PageTransition>
                                    <CompositePageTransition>
                                        <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                                    </CompositePageTransition>
                                </Carousel.PageTransition>
                                <Carousel.Items>
                                    <!--  Play Page  -->
                                    <Grid
                                        Margin="20,20,5,0"
                                        Classes="MainContentArea"
                                        RowDefinitions="Auto, *">
                                        <Grid
                                            Grid.Row="0"
                                            Margin="0,0,15,20"
                                            ColumnDefinitions="*, Auto">
                                            <!--  Title  -->
                                            <TextBlock
                                                Margin="0"
                                                Classes="MainContentTitle"
                                                Text="{lang:Translate main.page.play.title}" />
                                            <!--  Add instance button  -->
                                            <Button
                                                Grid.Column="1"
                                                Classes="IconBtn PrimaryBtn"
                                                Command="{Binding AddInstanceBtnCommand}">
                                                <TextBlock Classes="FontAwesome" Text="&#x2b;" />
                                            </Button>
                                        </Grid>
                                        <!--  No instances text  -->
                                        <TextBlock
                                            Grid.Row="1"
                                            IsVisible="{Binding !HasInstances}"
                                            Text="{lang:Translate main.page.play.empty}" />
                                        <!--  Instances on Play Page  -->
                                        <Grid Grid.Row="1">
                                            <ScrollViewer Padding="0,0,15,0">
                                                <ItemsControl ItemsSource="{Binding InstanceGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander
                                                                Classes="InstanceExpander"
                                                                Header="{Binding GroupName}"
                                                                IsExpanded="True">
                                                                <ItemsControl ItemsSource="{Binding Instances}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Classes="PlayPageWrapper" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="10" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                    
                                    <!--  Patch Page  -->
                                    <Grid
                                        Margin="20,20,10,0"
                                        Classes="MainContentArea"
                                        RowDefinitions="Auto, Auto, *">
                                        <!--  Title  -->
                                        <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.patch.title}" />
                                        <!--  Empty text  -->
                                        <TextBlock
                                            Grid.Row="1"
                                            IsVisible="{Binding !HasPatches}"
                                            Text="{lang:Translate main.page.patch.empty}" />
                                        <!--  News Grid  -->
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Patches}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Classes="NewsPageWrapper" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    
                                    <!--  Accounts Page  -->
                                    <StackPanel Classes="MainContentArea">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <!--  Title  -->
                                            <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.accounts.title}" />
                                            <!--  Add account button  -->
                                            <Button
                                                Grid.Column="1"
                                                Classes="IconBtn PrimaryBtn"
                                                Command="{Binding AddAccountBtnCommand}">
                                                <TextBlock Classes="FontAwesome" Text="&#xf234;" />
                                            </Button>
                                        </Grid>
                                        <!--  No accounts text  -->
                                        <TextBlock IsVisible="{Binding !AccountData.HasAccounts}" Text="{lang:Translate main.page.accounts.empty}" />
                                        <!--  Accounts Grid  -->
                                        <Grid>
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding AccountData.Accounts}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Classes="AccountsPageWrapper" Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!--  Settings Page  -->
                                    <Grid Margin="20,20,20,0" RowDefinitions="Auto, Auto, *">
                                        <!--  Title  -->
                                        <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.settings.title}" />
                                        
                                        <!--  Settings Buttons  -->
                                        <Border Grid.Row="1" Classes="SettingsTabBorder">
                                            <WrapPanel Classes="SettingsTabWrapper">
                                                <Button
                                                    Name="LauncherSettingsBtn"
                                                    Classes="SettingsTabBtn SettingsTabBtnActive"
                                                    Command="{Binding HandleSettingsBtnCommand}"
                                                    CommandParameter="{x:Static enums:ESettingsTab.LAUNCHER}">
                                                    <TextBlock Text="{lang:Translate settings.tab.launcher}" />
                                                </Button>
                                                <Button
                                                    Name="MinecraftSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding HandleSettingsBtnCommand}"
                                                    CommandParameter="{x:Static enums:ESettingsTab.MINECRAFT}">
                                                    <TextBlock Text="{lang:Translate settings.tab.minecraft}" />
                                                </Button>
                                                <Button
                                                    Name="JavaSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding HandleSettingsBtnCommand}"
                                                    CommandParameter="{x:Static enums:ESettingsTab.JAVA}">
                                                    <TextBlock Text="{lang:Translate settings.tab.java}" />
                                                </Button>
                                                <Button
                                                    Name="MiscSettingsBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding HandleSettingsBtnCommand}"
                                                    CommandParameter="{x:Static enums:ESettingsTab.MISC}">
                                                    <TextBlock Text="{lang:Translate settings.tab.misc}" />
                                                </Button>
                                            </WrapPanel>
                                        </Border>

                                        <!--  Settings Content  -->
                                        <Carousel
                                            Grid.Row="2"
                                            Margin="0,15,0,0"
                                            SelectedIndex="{Binding CurrentSettingsTab}">
                                            <Carousel.PageTransition>
                                                <CompositePageTransition>
                                                    <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                                                </CompositePageTransition>
                                            </Carousel.PageTransition>
                                            <Carousel.Items>
                                                <!--  Launcher  -->
                                                <ScrollViewer>
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <!--  General Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.launcher.subtitle.general}" />

                                                                <!--  Enable Launcher Updates  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.autoUpdate}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Launcher.EnableAutomaticUpdates, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Update Interval  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.updateInterval}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\h"
                                                                        Increment="1"
                                                                        IsEnabled="{Binding CoreConfig.Launcher.EnableAutomaticUpdates}"
                                                                        Maximum="8760"
                                                                        Minimum="1"
                                                                        Value="{Binding CoreConfig.Launcher.UpdateInterval, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Language  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.language}" />
                                                                    <ComboBox
                                                                        Grid.Column="1"
                                                                        Classes="TextDropdown"
                                                                        ItemsSource="{Binding CoreConfig.AvailableLanguages}"
                                                                        SelectedIndex="0"
                                                                        SelectionChanged="Language_OnSelected">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Margin="0" Text="{Binding Name}" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>

                                                                <!--  Theme  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.theme}" />
                                                                    <ComboBox
                                                                        Grid.Column="1"
                                                                        Classes="TextDropdown"
                                                                        SelectedIndex="{Binding CoreConfig.Launcher.Theme, Mode=TwoWay}">
                                                                        <ComboBoxItem Content="Light" />
                                                                        <ComboBoxItem Content="Dark" />
                                                                    </ComboBox>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!--  Directories Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.launcher.subtitle.directories}" />

                                                                <!--  Assets Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.assets}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.AssetsDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="0">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Cache Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.cache}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.CacheDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="1">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Icons Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.icons}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.IconsDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="3">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Instances Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.instances}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.InstancesDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="2">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Java Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.java}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.JavaDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="4">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Libraries Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.libraries}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.LibrariesDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="5">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Manifests Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.manifests}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.ManifestsDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="6">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Translations Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.translations}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.TranslationsDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="7">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>

                                                                <!--  Versions Directory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.launcher.dir.versions}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Launcher.VersionsDirectoryPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <Button
                                                                        Grid.Column="2"
                                                                        Classes="IconBtn"
                                                                        Command="{Binding ConfigDirSelectCommand}"
                                                                        CommandParameter="8">
                                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  Minecraft  -->
                                                <ScrollViewer>
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <!--  General Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.launcher.subtitle.general}" />

                                                                <!--  Start Maximized  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.startMaximized}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Minecraft.StartMaximized, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Window Width  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.windowWidth}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0"
                                                                        Increment="10"
                                                                        IsEnabled="{Binding !CoreConfig.Minecraft.StartMaximized}"
                                                                        Maximum="{x:Static local:App.ScreenWidth}"
                                                                        Minimum="100"
                                                                        Value="{Binding CoreConfig.Minecraft.WindowWidth, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Window Height  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.windowHeight}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0"
                                                                        Increment="10"
                                                                        IsEnabled="{Binding !CoreConfig.Minecraft.StartMaximized}"
                                                                        Maximum="{x:Static local:App.ScreenHeight}"
                                                                        Minimum="100"
                                                                        Value="{Binding CoreConfig.Minecraft.WindowHeight, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Close Launcher after game opens  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.closeOpen}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Minecraft.CloseLauncherOnGameStart, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Close Launcher after game closes  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.minecraft.closeExit}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Minecraft.CloseLauncherOnGameExit, Mode=TwoWay}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  Java  -->
                                                <ScrollViewer>
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <!--  General Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.launcher.subtitle.general}" />

                                                                <!--  Minimum Memory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.minMemory}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\ MB"
                                                                        Increment="128"
                                                                        Maximum="{Binding CoreConfig.Java.MaxMemory}"
                                                                        Minimum="512"
                                                                        Value="{Binding CoreConfig.Java.MinMemory, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Maximum Memory  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.maxMemory}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\ MB"
                                                                        Increment="128"
                                                                        Maximum="131072"
                                                                        Minimum="512"
                                                                        Value="{Binding CoreConfig.Java.MaxMemory, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  PermGen  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.permaGen}" />
                                                                    <NumericUpDown
                                                                        Grid.Column="1"
                                                                        Classes="NumericInput"
                                                                        FormatString="0\ MB"
                                                                        Increment="128"
                                                                        Maximum="1024"
                                                                        Minimum="8"
                                                                        Value="{Binding CoreConfig.Java.PermaGen, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Java Path  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 350, Auto">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.java.path}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Java.DefaultJavaPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.directory}" />
                                                                    <StackPanel
                                                                        Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="5">
                                                                        <Button
                                                                            Classes="IconBtn"
                                                                            Command="{Binding ConfigDirSelectCommand}"
                                                                            CommandParameter="9">
                                                                            <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                                        </Button>
                                                                        <Button Classes="IconBtn" Command="{Binding JavaPathSelectorCommand}">
                                                                            <TextBlock Classes="FontAwesome" Text="&#xf126;" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!--  JVM Arguments  Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel Spacing="10">
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.java.jvmArgs}" />

                                                                <!--  Input  -->
                                                                <TextBox
                                                                    MinHeight="128"
                                                                    MaxLines="512"
                                                                    Text="{Binding CoreConfig.Java.JvmArguments, Mode=TwoWay}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!--  Misc  -->
                                                <ScrollViewer>
                                                    <StackPanel Classes="SettingsWrapper">
                                                        <!--  Custom Commands Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.misc.subtitle.customCommands}" />

                                                                <!--  Pre-launch Command  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <StackPanel MaxWidth="200" HorizontalAlignment="Left">
                                                                        <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.prelaunchCommand}" />
                                                                        <TextBlock
                                                                            Classes="SettingsDescription"
                                                                            Text="{lang:Translate settings.misc.prelaunchCommand.description}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Misc.PreLaunchCommand, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Wrapper Command  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <StackPanel MaxWidth="200" HorizontalAlignment="Left">
                                                                        <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.wrapperCommand}" />
                                                                        <TextBlock
                                                                            Classes="SettingsDescription"
                                                                            Text="{lang:Translate settings.misc.wrapperCommand.description}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Misc.WrapperCommand, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  Post-exit Command  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <StackPanel MaxWidth="200" HorizontalAlignment="Left">
                                                                        <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.postExitCommand}" />
                                                                        <TextBlock
                                                                            Classes="SettingsDescription"
                                                                            Text="{lang:Translate settings.misc.postExitCommand.description}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        Text="{Binding CoreConfig.Misc.PostExitCommand, Mode=TwoWay}" />
                                                                </Grid>

                                                            </StackPanel>
                                                        </Border>

                                                        <!--  Native Libraries Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.misc.subtitle.nativeLibraries}" />

                                                                <!--  Use custom GLFW  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.customGLFW}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Misc.UseCustomGlfw, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  GLFW library path  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.pathGLFW}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        IsEnabled="{Binding CoreConfig.Misc.UseCustomGlfw}"
                                                                        Text="{Binding CoreConfig.Misc.CustomGlfwPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.file}" />
                                                                </Grid>

                                                                <!--  Use custom OpenAL  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.customOpenAL}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Misc.UseCustomOpenAl, Mode=TwoWay}" />
                                                                </Grid>

                                                                <!--  OpenAL library path  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 400">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.pathOpenAL}" />
                                                                    <TextBox
                                                                        Grid.Column="1"
                                                                        Classes="TextInput"
                                                                        IsEnabled="{Binding CoreConfig.Misc.UseCustomOpenAl}"
                                                                        Text="{Binding CoreConfig.Misc.CustomOpenAlPath, Mode=TwoWay}"
                                                                        PlaceholderText="{lang:Translate common.select.file}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!--  Performance Category  -->
                                                        <Border Classes="SettingsCategoryBorder">
                                                            <StackPanel>
                                                                <!--  Category Title  -->
                                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate settings.misc.subtitle.performance}" />

                                                                <!--  Enable Feral GameMode  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.enableGameMode}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Misc.EnableFeralGameMode, Mode=TwoWay}"
                                                                        IsEnabled="{Binding IsLinux}" />
                                                                </Grid>

                                                                <!--  Enable MangoHud  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.enableMangoHud}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Misc.EnableMangoHud, Mode=TwoWay}"
                                                                        IsEnabled="{Binding IsLinux}" />
                                                                </Grid>

                                                                <!--  Use dedicated GPU  -->
                                                                <Grid Classes="SettingsContentGrid" ColumnDefinitions="*, 150">
                                                                    <TextBlock Classes="SettingsName" Text="{lang:Translate settings.misc.useDedicatedGpu}" />
                                                                    <ToggleSwitch
                                                                        Grid.Column="1"
                                                                        Classes="SettingsSwitch"
                                                                        IsChecked="{Binding CoreConfig.Misc.UseDedicatedGpu, Mode=TwoWay}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Carousel.Items>
                                        </Carousel>
                                    </Grid>
                                    
                                    <!--  About Page  -->
                                    <Grid Margin="20,20,20,0" RowDefinitions="Auto, Auto, *">
                                        <!-- Title -->
                                        <TextBlock Classes="MainContentTitle" Text="{lang:Translate about.tab.about}" />
                                        
                                        <!--  Tab Buttons  -->
                                        <Border Grid.Row="1" Classes="SettingsTabBorder">
                                            <WrapPanel Classes="SettingsTabWrapper">
                                                <Button
                                                    Name="AboutInfoBtn"
                                                    Classes="SettingsTabBtn SettingsTabBtnActive"
                                                    Command="{Binding SwitchAboutTabCommand}"
                                                    CommandParameter="{x:Static enums:EAboutTab.ABOUT}">
                                                    <TextBlock Text="{lang:Translate about.tab.about}" />
                                                </Button>
                                                <Button
                                                    Name="CreditsInfoBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding SwitchAboutTabCommand}"
                                                    CommandParameter="{x:Static enums:EAboutTab.CREDITS}">
                                                    <TextBlock Text="{lang:Translate about.tab.credits}" />
                                                </Button>
                                                <Button
                                                    Name="LicenseInfoBtn"
                                                    Classes="SettingsTabBtn"
                                                    Command="{Binding SwitchAboutTabCommand}"
                                                    CommandParameter="{x:Static enums:EAboutTab.LICENSE}">
                                                    <TextBlock Text="{lang:Translate about.tab.license}" />
                                                </Button>
                                            </WrapPanel>
                                        </Border>

                                        <!--  Content  -->
                                        <Carousel
                                            Grid.Row="2"
                                            Margin="0,15,0,0"
                                            SelectedIndex="{Binding CurrentAboutTab}">
                                            <Carousel.PageTransition>
                                                <CompositePageTransition>
                                                    <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                                                </CompositePageTransition>
                                            </Carousel.PageTransition>
                                            <Carousel.Items>

                                                <!-- About -->
                                                <ScrollViewer>
                                                    <Grid Classes="AboutWrapper" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                                        <!--  Logo  -->
                                                        <Image Classes="AboutLogo" Source="avares://Desktop/Assets/Images/logo.png" />
                                                        <!--  Description  -->
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Classes="CreditText"
                                                            Text="{lang:Translate about.description}" />
                                                        <!--  Github Link  -->
                                                        <HyperlinkButton
                                                            Grid.Row="2"
                                                            HorizontalAlignment="Center"
                                                            NavigateUri="https://github.com/TavstalDev/KonkordLauncher">
                                                            <TextBlock Classes="LinkText">
                                                                https://github.com/TavstalDev/KonkordLauncher
                                                            </TextBlock>
                                                        </HyperlinkButton>
                                                        <!--  Website Link  -->
                                                        <HyperlinkButton
                                                            Grid.Row="3"
                                                            HorizontalAlignment="Center"
                                                            NavigateUri="https://tavstaldev.github.io/KonkordLauncher">
                                                            <TextBlock Classes="LinkText">
                                                                https://tavstaldev.github.io/KonkordLauncher
                                                            </TextBlock>
                                                        </HyperlinkButton>
                                                        <!--  Line  -->
                                                        <Border Grid.Row="4" Classes="BreakLine" />
                                                        <!--  Version  -->
                                                        <WrapPanel Grid.Row="5" Classes="AboutVersionWrapper">
                                                            <TextBlock Classes="CreditText" Text="{lang:Translate about.version}" />
                                                            <TextBlock Classes="CreditText" Text="{Binding Version}" />
                                                        </WrapPanel>
                                                        <!--  Build Date  -->
                                                        <WrapPanel Grid.Row="6" Classes="AboutVersionWrapper">
                                                            <TextBlock Classes="CreditText" Text="{lang:Translate about.buildDate}" />
                                                            <TextBlock Classes="CreditText" Text="{Binding BuildDate}" />
                                                        </WrapPanel>
                                                        <!--  Branch  -->
                                                        <WrapPanel Grid.Row="7" Classes="AboutVersionWrapper">
                                                            <TextBlock Classes="CreditText" Text="{lang:Translate about.branch}" />
                                                            <TextBlock Classes="CreditText" Text="{Binding Branch}" />
                                                        </WrapPanel>
                                                    </Grid>
                                                </ScrollViewer>
                                                
                                                <!-- Credits -->
                                                <ScrollViewer>
                                                    <Grid Classes="AboutWrapper" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                                        <!--  Project Maintainers  -->
                                                        <WrapPanel Classes="CreditWrapper">
                                                            <!--  Subtitle  -->
                                                            <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.projectMaintainers}" />
                                                            <TextBlock Classes="CreditText">
                                                                Tavstal
                                                            </TextBlock>
                                                        </WrapPanel>
                                                        <!--  Line  -->
                                                        <Border Grid.Row="1" Classes="BreakLine" />
                                                        <!--  Contributors  -->
                                                        <WrapPanel Grid.Row="2" Classes="CreditWrapper">
                                                            <!--  Subtitle  -->
                                                            <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.contributors}" />
                                                            <TextBlock Classes="CreditText">
                                                                -
                                                            </TextBlock>
                                                        </WrapPanel>
                                                        <!--  Line  -->
                                                        <Border
                                                            Grid.Row="3"
                                                            Height="1"
                                                            Classes="BreakLine" />
                                                        <!--  Special Thanks  -->
                                                        <WrapPanel Grid.Row="4" Classes="CreditWrapper">
                                                            <!--  Subtitle  -->
                                                            <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.specialThanks}" />
                                                            <TextBlock Classes="CreditText">
                                                                -
                                                            </TextBlock>
                                                        </WrapPanel>
                                                        <!--  Line  -->
                                                        <Border
                                                            Grid.Row="5"
                                                            Height="1"
                                                            Classes="BreakLine" />
                                                        <!--  Third-Party  -->
                                                        <WrapPanel Grid.Row="6" Classes="CreditWrapper">
                                                            <!--  Subtitle  -->
                                                            <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.thirdParty}" />
                                                            <!--  AvaloniaUI  -->
                                                            <TextBlock Classes="CreditText">
                                                                AvaloniaUI: Cross-platform UI framework.
                                                            </TextBlock>
                                                            <!--  CommunityToolkit.Mvvm  -->
                                                            <TextBlock Classes="CreditText">
                                                                CommunityToolkit.Mvvm: MVVM helper types.
                                                            </TextBlock>
                                                            <!--  Newtonsoft.Json  -->
                                                            <TextBlock Classes="CreditText">
                                                                Newtonsoft.Json: JSON serialization.
                                                            </TextBlock>
                                                            <!--  Markdown.Avalonia & ReverseMarkdown  -->
                                                            <TextBlock Classes="CreditText">
                                                                Markdown.Avalonia and ReverseMarkdown: Markdown handling.
                                                            </TextBlock>
                                                            <!--  SharpZipLib  -->
                                                            <TextBlock Classes="CreditText">
                                                                SharpZipLib: File compression library.
                                                            </TextBlock>
                                                            <!--  CmlLib  -->
                                                            <TextBlock Classes="CreditText">
                                                                CmlLib: Provided a reference for the Forge installation logic.
                                                            </TextBlock>
                                                            <!--  Modrinth & CurseForge  -->
                                                            <TextBlock Classes="CreditText">
                                                                Modrinth and CurseForge: Used for mod, modpack, and resource pack downloads.
                                                            </TextBlock>
                                                            <!--  Mojang  -->
                                                            <TextBlock Classes="CreditText">
                                                                Mojang: Makers of Minecraft.
                                                            </TextBlock>
                                                            <!--  FontAwesome  -->
                                                            <TextBlock Classes="CreditText">
                                                                FontAwesome: Icon library.
                                                            </TextBlock>
                                                            <!--  TextStudio  -->
                                                            <TextBlock Classes="CreditText">
                                                                TextStudio: Minecraft 3D text creator.
                                                            </TextBlock>
                                                            <!--  Minecraft Block Icons  -->
                                                            <TextBlock Classes="CreditText">
                                                                Minecraft Block Icons: Sourced from Minecraft and its wiki.
                                                            </TextBlock>
                                                            <!--    -->
                                                            <TextBlock Classes="CreditText">
                                                                PrismLauncher: A major source of inspiration for the launcher's functionality.
                                                            </TextBlock>
                                                        </WrapPanel>
                                                    </Grid>
                                                </ScrollViewer>
                                                
                                                <!-- License -->
                                                <ScrollViewer Classes="LicenseScrollViewer">
                                                    <TextBlock Classes="LicenseText" Text="{Binding License}" />
                                                </ScrollViewer>
                                                
                                            </Carousel.Items>
                                        </Carousel>
                                    </Grid>
                                    
                                    <!--  Skins Page  -->
                                    <Grid
                                        Margin="20"
                                        RowDefinitions="Auto, *"
                                        RowSpacing="10">
                                        <!--  Title  -->
                                        <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.skins.title}" />
                                        <!--  Content  -->
                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*, *"
                                            ColumnSpacing="10">
                                            <!--  Preview  -->
                                            <StackPanel Spacing="10">
                                                <!--  Skin Preview  -->
                                                <Border
                                                    Padding="20"
                                                    Background="{DynamicResource base-300}"
                                                    CornerRadius="14">
                                                    <StackPanel Spacing="10">
                                                        <!--  Title  -->
                                                        <TextBlock Classes="Muted" Text="{lang:Translate main.page.skins.preview}" />
                                                        <!--  Options  -->
                                                        <Viewbox MaxHeight="280" Classes="SkinViewBox">
                                                            <Image Classes="SkinPreview" Source="{Binding AccountSkinPreview}" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Border>
                                                <!--  Model Type Selection  -->
                                                <Border
                                                    Padding="20"
                                                    Background="{DynamicResource base-300}"
                                                    CornerRadius="14">
                                                    <StackPanel Spacing="10">
                                                        <!--  Title  -->
                                                        <TextBlock Classes="Muted" Text="{lang:Translate main.page.skins.model}" />
                                                        <!--  Options  -->
                                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                                            <!--  Wide Model  -->
                                                            <Button
                                                                Classes="SkinModelBtn"
                                                                Classes.selected="{Binding IsAccountHasWideModel}"
                                                                Command="{Binding ModelSelectCommand}"
                                                                CommandParameter="classic"
                                                                IsEnabled="{Binding !IsAccountSkinProcessing}">
                                                                <TextBlock Foreground="{DynamicResource base-content}" Text="{lang:Translate main.page.skins.model.wide}" />
                                                            </Button>
                                                            <!--  Slim Model  -->
                                                            <Button
                                                                Grid.Column="1"
                                                                Classes="SkinModelBtn"
                                                                Classes.selected="{Binding !IsAccountHasWideModel}"
                                                                Command="{Binding ModelSelectCommand}"
                                                                CommandParameter="slim"
                                                                IsEnabled="{Binding !IsAccountSkinProcessing}">
                                                                <TextBlock Foreground="{DynamicResource base-content}" Text="{lang:Translate main.page.skins.model.slim}" />
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <!--  Content  -->
                                            <ScrollViewer Grid.Column="1" Padding="0,0,20,0">
                                                <StackPanel Spacing="10">
                                                    <!--  Skin Selection  -->
                                                    <Border
                                                        Padding="20"
                                                        Background="{DynamicResource base-300}"
                                                        CornerRadius="14">
                                                        <StackPanel Spacing="10">
                                                            <!--  Title  -->
                                                            <Grid ColumnDefinitions="*, Auto">
                                                                <TextBlock Classes="Muted" Text="{lang:Translate main.page.skins.skins}" />
                                                                <!--  Upload Button  -->
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Classes="IconBtn PrimaryBtn"
                                                                    Command="{Binding SkinUploadCommand}"
                                                                    IsEnabled="{Binding !IsAccountSkinProcessing}">
                                                                    <TextBlock Classes="FontAwesome" Text="&#xf093;" />
                                                                </Button>
                                                            </Grid>
                                                            <!--  Options  -->
                                                            <ItemsControl ItemsSource="{Binding Skins}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel ItemSpacing="10" LineSpacing="10" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                    <!--  Cape Selection  -->
                                                    <Border
                                                        Padding="20"
                                                        Background="{DynamicResource base-300}"
                                                        CornerRadius="14">
                                                        <StackPanel Spacing="10">
                                                            <!--  Title  -->
                                                            <TextBlock Classes="Muted" Text="{lang:Translate main.page.skins.capes}" />
                                                            <!--  Options  -->
                                                            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Capes}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel
                                                                            HorizontalAlignment="Center"
                                                                            ItemSpacing="10"
                                                                            LineSpacing="10" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Carousel.Items>
                            </Carousel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Resize overlay (8px grips)  -->
        <Grid ColumnDefinitions="8,*,8" RowDefinitions="8,*,8">
            <!--  Edges  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="Transparent"
                Cursor="TopSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="North" />
            <Border
                Grid.Row="2"
                Grid.Column="1"
                Background="Transparent"
                Cursor="BottomSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="South" />
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Background="Transparent"
                Cursor="LeftSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="West" />
            <Border
                Grid.Row="1"
                Grid.Column="2"
                Background="Transparent"
                Cursor="RightSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="East" />

            <!--  Corners  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                Cursor="TopLeftCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="NorthWest" />
            <Border
                Grid.Row="0"
                Grid.Column="2"
                Background="Transparent"
                Cursor="TopRightCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="NorthEast" />
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Background="Transparent"
                Cursor="BottomLeftCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="SouthWest" />
            <Border
                Grid.Row="2"
                Grid.Column="2"
                Background="Transparent"
                Cursor="BottomRightCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="SouthEast" />
        </Grid>
    </Grid>
</Window>