<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.JavaSelectorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    Title="{lang:Translate java.title}"
    Width="500"
    Height="410"
    MinWidth="500"
    MinHeight="410"
    d:DesignHeight="410"
    d:DesignWidth="500"
    x:DataType="models:JavaSelectorViewModel"
    Background="Transparent"
    CanResize="False"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="True"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <!--  Main Window Content  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <Border HorizontalAlignment="Stretch" PointerPressed="DragStart_PointerPressed">
                    <Grid ColumnDefinitions="*, Auto">
                        <!--  Window Title  -->
                        <TextBlock Classes="WindowTitle" Text="{Binding $parent[Window].Title}" />

                        <!--  Window Buttons  -->
                        <StackPanel Grid.Column="1" Classes="WindowBtnPanel">
                            <!--  MINIMIZE  -->
                            <Button
                                Classes="WindowBtn WarningBtn"
                                Command="{Binding MinimizeWindowCommand}"
                                ToolTip.Tip="{lang:Translate main.window.minimize}" />
                            <!--  MAXIMIZE / RESTORE  -->
                            <Button
                                Classes="WindowBtn SuccessBtn"
                                Command="{Binding MaximizeWindowCommand}"
                                IsEnabled="{Binding $parent[Window].CanResize}"
                                ToolTip.Tip="{lang:Translate main.window.maximize}" />
                            <!--  CLOSE  -->
                            <Button
                                Classes="WindowBtn ErrorBtn"
                                Command="{Binding CloseWindowCommand}"
                                ToolTip.Tip="{lang:Translate main.window.close}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto">

                    <!--  Title  -->
                    <Border Classes="ModalTitleBorder">
                        <StackPanel>
                            <TextBlock Text="{lang:Translate java.select}" />
                            <TextBlock Classes="ModalSubTitle" Text="{lang:Translate java.select.subtitle}" />
                        </StackPanel>
                    </Border>

                    <!--  Content  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="20,15,20,0"
                        Classes="TableScrollViewer">
                        <DataGrid
                            Name="VersionTable"
                            Background="{DynamicResource base-100}"
                            Classes="InstanceTable"
                            ItemsSource="{Binding Versions}"
                            SelectedItem="{Binding SelectedJavaVersion, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <!--  Major  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Major}"
                                    Header="{lang:Translate java.table.major}" />
                                <!--  Version  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Version}"
                                    Header="{lang:Translate java.table.version}" />
                                <!--  Architecture  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Architecture}"
                                    Header="{lang:Translate java.table.architecture}" />
                                <!--  Path  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Path}"
                                    Header="{lang:Translate java.table.path}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <!--  Buttons  -->
                    <Border Grid.Row="2" Classes="InstanceButtonBorder">
                        <!--  Buttons  -->
                        <StackPanel HorizontalAlignment="Center" Classes="InstanceButtonWrapper">

                            <!--  Ok Button  -->
                            <Button
                                Classes="IconBtn SuccessBtn"
                                Command="{Binding SelectedBtnCommand}"
                                IsEnabled="{Binding HasSelectedJavaVersion}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf00c;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="500"
                                        Text="{lang:Translate common.ok}" />
                                </WrapPanel>
                            </Button>

                            <!--  Cancel Button  -->
                            <Button Classes="IconBtn ErrorBtn" Command="{Binding CancelBtnCommand}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf00d;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="500"
                                        Text="{lang:Translate common.cancel}" />
                                </WrapPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay (8px grips)  -->
        <Grid ColumnDefinitions="8,*,8" RowDefinitions="8,*,8">
            <!--  Edges  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="Transparent"
                Cursor="TopSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="North" />
            <Border
                Grid.Row="2"
                Grid.Column="1"
                Background="Transparent"
                Cursor="BottomSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="South" />
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Background="Transparent"
                Cursor="LeftSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="West" />
            <Border
                Grid.Row="1"
                Grid.Column="2"
                Background="Transparent"
                Cursor="RightSide"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="East" />

            <!--  Corners  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                Cursor="TopLeftCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="NorthWest" />
            <Border
                Grid.Row="0"
                Grid.Column="2"
                Background="Transparent"
                Cursor="TopRightCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="NorthEast" />
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Background="Transparent"
                Cursor="BottomLeftCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="SouthWest" />
            <Border
                Grid.Row="2"
                Grid.Column="2"
                Background="Transparent"
                Cursor="BottomRightCorner"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="SouthEast" />
        </Grid>
    </Grid>
</Window>
