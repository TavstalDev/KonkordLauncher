<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.AlertWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate alert.title}"
    Width="300"
    MinWidth="300"
    d:DesignWidth="300"
    x:DataType="models:AlertViewModel"
    Background="Transparent"
    CanResize="False"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="True"
    SizeToContent="Height"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
    </Window.Resources>

    <Border
        Background="{DynamicResource base-200}"
        BorderBrush="{DynamicResource border-one}"
        BorderThickness="1"
        CornerRadius="14"
        PointerPressed="DragStart_PointerPressed">
        <Grid RowDefinitions="Auto, *">
            <!--  Window Controls  -->
            <templates:CustomTitleBar/>
            
            <!--  Main Content  -->
            <Grid
                Grid.Row="1"
                Classes="AlertView"
                RowDefinitions="*, Auto, *"
                RowSpacing="20">
                <TextBlock
                    Name="AlertIcon"
                    Classes="FontAwesome AlertIcon"
                    Text="{Binding GetIcon}" />
                <Grid
                    Grid.Row="1"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="5">
                    <TextBlock
                        Grid.Row="0"
                        Classes="AlertTitle"
                        Text="{Binding Title}" />
                    <TextBlock
                        Grid.Row="1"
                        Classes="AlertMessage"
                        Text="{Binding Message}" />
                </Grid>
                <WrapPanel Grid.Row="2" Classes="AlertButtonWrapper">
                    <Button
                        Padding="10,5"
                        Classes="IconBtn PrimaryBtn"
                        Command="{Binding YesButtonClickCommand}"
                        CommandParameter="{StaticResource True}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf00c;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.ok}" />
                        </WrapPanel>
                    </Button>
                    <Button
                        Padding="10,5"
                        Classes="IconBtn"
                        Command="{Binding CloseWindowCommand}"
                        CommandParameter="{StaticResource False}"
                        IsVisible="{Binding HasCancelButton}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf00d;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.cancel}" />
                        </WrapPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
