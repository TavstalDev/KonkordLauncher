<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="Grid.AboutWrapper">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="RowSpacing" Value="5" />
        <Setter Property="Margin" Value="25" />
    </Style>
    
    <Style Selector="Image.AboutLogo">
        <Setter Property="MaxWidth" Value="142" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,-5,0,10" />
    </Style>
    
    <Style Selector="TextBlock.AboutCategory">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="WrapPanel.AboutVersionWrapper">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ItemSpacing" Value="5" />
    </Style>
    
    <Style Selector="TextBlock.LinkText">
        <Setter Property="Foreground" Value="{DynamicResource primary}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontWeight" Value="500" />
        
    </Style>
    
    <Style Selector="WrapPanel.CreditWrapper">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ItemsAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="ItemSpacing" Value="15" />
    </Style>
    
    <Style Selector="TextBlock.CreditText">
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    
    <Style Selector="Border.BreakLine">
        <Setter Property="Background" Value="Gray" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,10" />
    </Style>
    
    <Style Selector="ScrollViewer.LicenseScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Margin" Value="15, 15, 0, 15" />
    </Style>
    
    <Style Selector="TextBlock.LicenseText">
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 0, 25, 0" />
    </Style>
</Styles>
