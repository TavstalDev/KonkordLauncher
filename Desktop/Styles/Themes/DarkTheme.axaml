<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="base-100" Color="#1d1d1d" />
    <SolidColorBrush x:Key="base-200" Color="#161616" />
    <SolidColorBrush x:Key="base-300" Color="#111111" />
    <SolidColorBrush x:Key="base-content" Color="#FFFFFF" />
    <SolidColorBrush x:Key="base-overlay" Color="#B3000000" />
    <SolidColorBrush x:Key="border-one" Color="#222222" />
    <SolidColorBrush x:Key="border-two" Color="#272727" />

    <SolidColorBrush x:Key="default" Color="#191919" />
    <SolidColorBrush x:Key="default-border" Color="#3F3F3F" />

    <SolidColorBrush x:Key="primary" Color="#007853" />
    <SolidColorBrush x:Key="primary-border" Color="#005F42" />
    <SolidColorBrush x:Key="primary-content" Color="#FFFFFF" />
    <SolidColorBrush x:Key="secondary" Color="#5E6472" />
    <SolidColorBrush x:Key="secondary-border" Color="#3F4451" />
    <SolidColorBrush x:Key="secondary-content" Color="#FFFFFF" />

    <SolidColorBrush x:Key="accent" Color="#009689" />
    <SolidColorBrush x:Key="accent-content" Color="#084d49" />

    <SolidColorBrush x:Key="neutral" Color="#0F1115" />
    <SolidColorBrush x:Key="neutral-content" Color="#FFF" />

    <SolidColorBrush x:Key="info" Color="#0EA5E9" />
    <SolidColorBrush x:Key="info-content" Color="#03263D" />

    <SolidColorBrush x:Key="success" Color="#009764" />
    <SolidColorBrush x:Key="success-content" Color="#004c39" />

    <SolidColorBrush x:Key="warning" Color="#fcb700" />
    <SolidColorBrush x:Key="warning-content" Color="#793205" />

    <SolidColorBrush x:Key="error" Color="#ff6266" />
    <SolidColorBrush x:Key="error-content" Color="#4d0218" />

    <SolidColorBrush x:Key="text-faded" Color="#9CA3AF" />
    <SolidColorBrush x:Key="text-muted" Color="#626773" />
</ResourceDictionary>