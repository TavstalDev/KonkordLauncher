<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Tavstal.KonkordLauncher.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
        x:Class="Tavstal.KonkordLauncher.Desktop.Views.CreateInstanceWindow"
        Title="Create Instance"
        CanResize="False"
        ShowInTaskbar="False"
        Icon="../Assets/Images/logo.png"
        MinHeight="500"
        MinWidth="900"
        Height="500"
        Width="900">
    
    <Border Classes="ModalView">
        <StackPanel>
            <TextBlock Classes="ModalTitle" HorizontalAlignment="Left" Text="New Instance" />
        </StackPanel>
    </Border>
</Window>
