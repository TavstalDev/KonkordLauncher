<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.JavaSelectorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    Title="{lang:Translate java.title}"
    Width="500"
    Height="410"
    MinWidth="500"
    MinHeight="410"
    d:DesignHeight="410"
    d:DesignWidth="500"
    x:DataType="models:JavaSelectorViewModel"
    Background="Transparent"
    CanResize="False"
    CornerRadius="14"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="True"
    SystemDecorations="None"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border
        Background="{DynamicResource base-200}"
        BorderBrush="{DynamicResource border-one}"
        BorderThickness="1"
        CornerRadius="14"
        PointerPressed="DragStart_PointerPressed">
        <Grid RowDefinitions="Auto, *">
            <!--  Window Controls  -->
            <Border HorizontalAlignment="Stretch" PointerPressed="DragStart_PointerPressed">
                <StackPanel Classes="WindowBtnPanel">
                    <!--  MINIMIZE  -->
                    <Button
                        Classes="WindowBtn WarningBtn"
                        Command="{Binding MinimizeWindowCommand}"
                        ToolTip.Tip="{lang:Translate main.window.minimize}" />
                    <!--  MAXIMIZE / RESTORE  -->
                    <Button
                        Classes="WindowBtn SuccessBtn"
                        Command="{Binding MaximizeWindowCommand}"
                        IsEnabled="{Binding $parent[Window].CanResize}"
                        ToolTip.Tip="{lang:Translate main.window.maximize}" />
                    <!--  CLOSE  -->
                    <Button
                        Classes="WindowBtn ErrorBtn"
                        Command="{Binding CloseWindowCommand}"
                        ToolTip.Tip="lang:Translate main.window.close" />
                </StackPanel>
            </Border>
            <!--  Main Content  -->
            <Grid
                Grid.Row="1"
                Margin="20"
                RowDefinitions="Auto, *, Auto">
                <TextBlock Classes="ModalTitle" Text="{lang:Translate java.select}" />
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    Classes="TableScrollViewer">
                    <DataGrid
                        Name="VersionTable"
                        Background="{DynamicResource base-100}"
                        Classes="InstanceTable"
                        ItemsSource="{Binding Versions}"
                        SelectedItem="{Binding SelectedJavaVersion, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <!--  Major  -->
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Major}"
                                Header="{lang:Translate java.table.major}" />
                            <!--  Version  -->
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Version}"
                                Header="{lang:Translate java.table.version}" />
                            <!--  Architecture  -->
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Architecture}"
                                Header="{lang:Translate java.table.architecture}" />
                            <!--  Path  -->
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Path}"
                                Header="{lang:Translate java.table.path}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
                <WrapPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    ItemSpacing="5">
                    <!--  Ok Button  -->
                    <Button
                        MinWidth="90"
                        Classes="IconBtn"
                        Command="{Binding SelectedBtnCommand}"
                        IsEnabled="{Binding HasSelectedJavaVersion}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf00c;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.ok}" />
                        </WrapPanel>

                    </Button>
                    <!--  Cancel Button  -->
                    <Button
                        MinWidth="90"
                        Classes="IconBtn"
                        Command="{Binding CancelBtnCommand}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf00d;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate common.cancel}" />
                        </WrapPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
