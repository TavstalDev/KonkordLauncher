<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>KonkordLauncher</AssemblyTitle>
        <ApplicationId>KonkordLauncher</ApplicationId>
        <AssemblyName>KonkordLauncher</AssemblyName>
        <Description>A modern, user-friendly launcher for Minecraft, designed to enhance the gaming experience with a sleek interface and powerful features.</Description>
        <Company>Tavstal</Company>
        <Product>KonkordLauncher</Product>
        <ApplicationIcon>$(MSBuildProjectDirectory)\favicon.ico</ApplicationIcon>
        <Copyright>Copyright © 2026 Tavstal</Copyright>
        <ComVisible>false</ComVisible>
        <Guid>5C0F1C0A-2258-4DD5-B454-0ED8FFF9E5A8</Guid>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0</FileVersion>
        <Version>2.0.0</Version>

        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Tavstal.KonkordLauncher.Desktop</RootNamespace>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <IsAotCompatible>false</IsAotCompatible>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <EnableUnsafeUTF8Json>true</EnableUnsafeUTF8Json>

        <ServerGarbageCollection>false</ServerGarbageCollection>
        <RetainVM>false</RetainVM>
        <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    </PropertyGroup>

    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
        <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.HtmlRenderer" Version="12.0.0"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
        <PackageReference Include="BeaconSDK" Version="0.1.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="DiscordRichPresence" Version="1.6.1.70"/>
        <PackageReference Include="DynamicData" Version="9.5.0"/>
        <PackageReference Include="Markdig" Version="1.5.1" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageReference Include="MinecraftSkinRender" Version="1.2.0"/>
        <PackageReference Include="MinecraftSkinRender.Image" Version="1.2.0"/>
        <PackageReference Include="Modrinth.Net" Version="3.8.2"/>
        <PackageReference Include="NbtLib" Version="1.0.1"/>
        <PackageReference Include="Optris.LoadingIndicators.Avalonia" Version="12.0.4"/>
        <PackageReference Include="QRCoder" Version="1.8.1"/>
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6"/>
        <PackageReference Include="ReverseMarkdown" Version="6.3.0"/>
        <PackageReference Include="Velopack" Version="1.2.161"/>
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="favicon.ico"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\MainWindow.axaml.cs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\AccountsWindow.axaml.cs">
            <DependentUpon>AccountsWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\CreateInstanceWindow.axaml.cs">
            <DependentUpon>CreateInstanceWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\StartupWindow.axaml.cs">
            <DependentUpon>StartupWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\EditInstanceWindow.axaml.cs">
            <DependentUpon>EditInstanceWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Modals\IconSelectorWindow.axaml.cs">
            <DependentUpon>IconSelectorWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Modals\JavaSelectorWindow.axaml.cs">
            <DependentUpon>JavaSelectorWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Modals\AlertWindow.axaml.cs">
            <DependentUpon>AlertWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Modals\InstallWindow.axaml.cs">
            <DependentUpon>InstallWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Dialogs\InstanceLogsWindow.axaml.cs">
            <DependentUpon>InstanceLogsWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Dialogs\InputWindow.axaml.cs">
            <DependentUpon>InputWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Dialogs\ResourceDownloadWindow.axaml.cs">
            <DependentUpon>ResourceDownloadWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Dialogs\InstanceVersionSelectorWindow.axaml.cs">
            <DependentUpon>InstanceVersionSelectorWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\LICENSE">
            <Link>Assets\LICENSE</Link>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\Icons\**\*"/>
        <EmbeddedResource Include="Assets\Fmllib\**\*"/>
        <EmbeddedResource Include="Assets\Lang\**\*"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Modrinth.Net">
            <HintPath>..\libs/Modrinth.Net.dll</HintPath>
            <Private>True</Private>
        </Reference>
    </ItemGroup>
</Project>
