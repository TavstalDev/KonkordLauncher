<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models"
    xmlns:local="clr-namespace:Tavstal.KonkordLauncher.Desktop"
    Title="Konkord Launcher"
    Width="900"
    Height="550"
    d:DesignHeight="550"
    d:DesignWidth="900"
    x:DataType="vm:MainViewModel"
    CanResize="False"
    Icon="../Assets/Images/logo.png"
    Loaded="MainWindow_Loaded"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <!--  Play Card  -->
        <DataTemplate DataType="models:PlayCardModel">
            <Border Classes="PlayCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Icon  -->
                    <Image
                        Grid.Row="0"
                        Classes="PlayCardImage"
                        Source="{Binding IconPath}" />
                    <!--  Name  -->
                    <TextBlock
                        Grid.Row="1"
                        Classes="PlayCardText"
                        Text="{Binding Title}" />
                    <!--  Buttons  -->
                    <WrapPanel Grid.Row="2" Classes="PlayCardButtonWrapper">
                        <!--  Launch Button  -->
                        <Button Classes="IconBtn PrimaryBtn">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf04b;" />
                        </Button>
                        <!--  Edit Button  -->
                        <Button Classes="IconBtn InfoBtn">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf304;" />
                        </Button>
                        <!--  Menu Button  -->
                        <Button Classes="IconBtn SecondaryBtn">
                            <TextBlock
                                Padding="6,0"
                                Classes="FontAwesome"
                                Text="&#xf142;" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  News Card  -->
        <DataTemplate DataType="models:NewsCardModel">
            <Border Classes="NewsCard">
                <StackPanel>
                    <!--  News Card Title  -->
                    <TextBlock Classes="NewsCardTitle" Text="{Binding Title}" />
                    <!--  News Card Description  -->
                    <TextBlock Classes="NewsCardDescription" Text="{Binding Description}" />
                    <!--  Read More Button  -->
                    <!-- TODO: Translate -->
                    <Button Classes="IconBtn InfoBtn" Content="Read More" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!--  Account Card  -->
        <DataTemplate DataType="models:AccountCardModel">
            <Border Classes="AccountsCard">
                <Grid Width="450">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Name & Type  -->
                    <WrapPanel Orientation="Vertical">
                        <TextBlock Classes="AccountsCardName" Text="{Binding Name}" />
                        <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                    </WrapPanel>

                    <!--  Buttons  -->
                    <WrapPanel Grid.Column="1" Classes="AccountsCardWrapper">
                        <Button Classes="IconBtn SuccessBtn">
                            <TextBlock Classes="FontAwesome" Text="&#xf00c;" />
                        </Button>
                        <Button Classes="IconBtn WarningBtn">
                            <TextBlock Classes="FontAwesome" Text="&#xf2f9;" />
                        </Button>
                        <Button Classes="IconBtn ErrorBtn">
                            <TextBlock Classes="FontAwesome" Text="&#xf1f8;" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar Content  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Logo and Welcome Text  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <Image Source="../Assets/Images/logo2.png" />
                <Label
                    Name="WelcomeLabel"
                    HorizontalAlignment="Center"
                    Content="Ready for Adventure?" />
            </StackPanel>

            <!--  Navigation Buttons  -->
            <StackPanel Grid.Row="1">
                <Button
                    Name="PlaySideBtn"
                    Classes="SidebarBtn PrimaryBtn"
                    Click="OnPlaySideButtonClick"
                    Content="Play" />
                <Button
                    Name="NewsSideBtn"
                    Classes="SidebarBtn SecondaryBtn"
                    Click="OnNewsSideButtonClick"
                    Content="News" />
                <Button
                    Name="AccountsSideBtn"
                    Classes="SidebarBtn SecondaryBtn"
                    Click="OnAccountsSideButtonClick"
                    Content="Accounts" />
                <Button
                    Name="SettingsSideBtn"
                    Classes="SidebarBtn SecondaryBtn"
                    Click="OnSettingsSideButtonClick"
                    Content="Settings" />
            </StackPanel>

            <!--  Footer with Version and Copyright  -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Label
                    Name="VersionLabel"
                    Classes="SidebarLabel"
                    Content="Ready to launch. No update available." />
                <Label Classes="SidebarLabel" Content="© 2025 Konkord Launcher" />
            </StackPanel>
        </Grid>

        <!--  Main Content Area  -->
        <Border Grid.Column="2" Classes="MainContentArea">
            <Carousel SelectedIndex="{Binding CurrentPageIndex}">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <!--  Play Page  -->
                    <StackPanel Classes="MainContentArea">
                        <Grid Width="480">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Title  -->
                            <TextBlock
                                Name="PlayPageTitleTextBlock"
                                Classes="MainContentTitle"
                                Text="Launch Game" />
                            <!--  Add instance button  -->
                            <Button
                                Name="AddInstanceBtn"
                                Grid.Column="1"
                                Classes="IconBtn InfoBtn"
                                Click="AddInstance_OnClick">
                                <TextBlock Classes="FontAwesome" Text="&#x2b;" />
                            </Button>
                        </Grid>
                        <!--  No instances text  -->
                        <TextBlock Name="PlayPageInstancesEmptyTb" Text="You don't have instances yet." />
                        <!--  Instances on Play Page  -->
                        <Grid MaxHeight="440">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Instances}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Classes="PlayPageWrapper" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                    <!--  News Page  -->
                    <StackPanel Classes="MainContentArea">
                        <!--  Title  -->
                        <TextBlock
                            Name="NewsPageTitleTextBlock"
                            Classes="MainContentTitle"
                            Text="News" />
                        <!--  No news text  -->
                        <TextBlock Name="NoNewsTextBlock" Text="We do not have news." />
                        <!--  News Grid  -->
                        <Grid MaxHeight="440">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding News}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Classes="NewsPageWrapper" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                    <!--  Accounts Page  -->
                    <StackPanel Classes="MainContentArea">
                        <Grid Width="480">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  Title  -->
                            <TextBlock
                                Name="AccountsPageTitleTextBlock"
                                Classes="MainContentTitle"
                                Text="Accounts" />
                            <!--  Add account button  -->
                            <Button
                                Name="AddAccountBtn"
                                Grid.Column="1"
                                Classes="IconBtn InfoBtn"
                                Click="AddAccount_OnClick">
                                <TextBlock
                                    Name="AddAccountTb"
                                    Classes="FontAwesome"
                                    Text="&#xf234;" />
                            </Button>
                        </Grid>
                        <!--  No accounts text  -->
                        <TextBlock Name="NoAccountsTextBlock" Text="You don't have accounts yet." />
                        <!--  Accounts Grid  -->
                        <Grid MaxHeight="440">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Accounts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Classes="AccountsPageWrapper" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                    <!--  Settings Page  -->
                    <Grid Classes="MainContentArea" RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Name="SettingsPageTitleTb" Classes="MainContentTitle" Text="Settings" />
                        <TabControl Grid.Row="1" Classes="SettingsTab">
                            <!--  Launcher Settings  -->
                            <TabItem Name="SettingsLauncherTab" Classes="SettingsTabItem" Header="Launcher">
                                <ScrollViewer Margin="0, 0, 10, 0">
                                    <WrapPanel Classes="SettingsWrapper">
                                        <!--  Enable Launcher Updates  -->
                                        <CheckBox Name="StEnableUpdatesCb" IsChecked="{Binding CoreConfig.Launcher.EnableAutomaticUpdates, Mode=TwoWay}">
                                            <TextBlock Name="StEnableUpdatesTb" Text="Enable automatic updates" />
                                        </CheckBox>
                                        <!--  Update Interval  -->
                                        <Grid ColumnDefinitions="Auto, *">
                                            <!--  Text  -->
                                            <TextBlock Name="StUpdateIntervalTb" Classes="NumericInput">Update Interval</TextBlock>
                                            <!--  Input  -->
                                            <NumericUpDown
                                                Name="StUpdateIntervalInput"
                                                Grid.Column="1"
                                                Classes="NumericInput"
                                                FormatString="0\h"
                                                Increment="1"
                                                Maximum="8760"
                                                Minimum="1"
                                                Value="{Binding CoreConfig.Launcher.UpdateInterval, Mode=TwoWay}"
                                                IsEnabled="{Binding CoreConfig.Launcher.EnableAutomaticUpdates}"/>
                                        </Grid>
                                        <!--  Language  -->
                                        <Grid ColumnDefinitions="Auto, *">
                                            <!--  Text  -->
                                            <TextBlock Name="StLanguageTb" Classes="TextDropdown">Language</TextBlock>
                                            <!--  Input  -->
                                            <ComboBox
                                                Name="StLanguageInput"
                                                Grid.Column="1"
                                                Classes="TextDropdown"
                                                SelectedIndex="0"
                                                SelectionChanged="Language_OnSelected"
                                                ItemsSource="{Binding CoreConfig.AvailableLanguages}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <!--  Theme  -->
                                        <Grid ColumnDefinitions="Auto, *">
                                            <!--  Text  -->
                                            <TextBlock Name="StThemeTb" Classes="TextDropdown">Theme</TextBlock>
                                            <!--  Input  -->
                                            <ComboBox
                                                Name="StThemeInput"
                                                Grid.Column="1"
                                                Classes="TextDropdown"
                                                SelectedIndex="{Binding CoreConfig.Launcher.Theme, Mode=TwoWay}">
                                                <ComboBoxItem Content="Automatic" />
                                                <ComboBoxItem Content="Light" />
                                                <ComboBoxItem Content="Dark" />
                                            </ComboBox>
                                        </Grid>
                                        <!--  Directories  -->
                                        <TextBlock Name="StDirectoriesSubTitle" Classes="SettingsCategory">
                                            Directories
                                        </TextBlock>
                                        <!--  Assets Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StAssetsTb" Classes="TextInput">Assets</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StAssetsInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.AssetsDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StAssetsBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="AssetsDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  Cache Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StCacheTb" Classes="TextInput">Cache</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StCacheInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.CacheDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StCacheBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="CacheDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  Instances Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StInstancesTb" Classes="TextInput">Instances</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StInstancesInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.InstancesDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StInstancesBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="InstancesDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!-- Icons Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StIconsTb" Classes="TextInput">Icons</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StIconsInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.IconsDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StIconsBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="IconsDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  Libraries Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StLibrariesTb" Classes="TextInput">Libraries</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StLibrariesInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.LibrariesDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StLibrariesBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="LibrariesDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  Manifests Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StManifestsTb" Classes="TextInput">Manifests</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StManifestsInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.ManifestsDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StManifestsBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="ManifestsDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  Translations Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StTranslationsTb" Classes="TextInput">Translations</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StTranslationsInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.TranslationsDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StTranslationsBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="TranslationsDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  Versions Directory  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StVersionsTb" Classes="TextInput">Versions</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StVersionsInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Launcher.VersionsDirectoryPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <!--  Button  -->
                                            <Button
                                                Name="StVersionsBtn"
                                                Grid.Column="2"
                                                Classes="IconBtn"
                                                Click="VersionsDirSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                    </WrapPanel>
                                </ScrollViewer>
                            </TabItem>
                            <!--  Minecraft Settings  -->
                            <TabItem Name="SettingsMinecraftTab" Classes="SettingsTabItem" Header="Minecraft">
                                <ScrollViewer Margin="0, 0, 10, 0">
                                    <WrapPanel Classes="SettingsWrapper">
                                        <!--  Minecraft Maximized  -->
                                        <CheckBox Name="StMinecraftMaximizedCb" IsChecked="{Binding CoreConfig.Minecraft.StartMaximized, Mode=TwoWay}">
                                            <TextBlock Name="StMinecraftMaximizedTb" Text="Start Minecraft maximized" />
                                        </CheckBox>
                                        <!--  Window Width  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Text  -->
                                            <TextBlock Name="StWindowWidthTb" Classes="NumericInput">Window width</TextBlock>
                                            <!--  Input  -->
                                            <NumericUpDown
                                                Name="StWindowWidthInput"
                                                Grid.Column="1"
                                                Classes="NumericInput"
                                                FormatString="0"
                                                Increment="10"
                                                Maximum="{x:Static local:App.ScreenWidth}"
                                                Minimum="100"
                                                Value="{Binding CoreConfig.Minecraft.WindowWidth, Mode=TwoWay}"
                                                IsEnabled="{Binding !CoreConfig.Minecraft.StartMaximized}"/>
                                        </Grid>
                                        <!--  Window Height  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Text  -->
                                            <TextBlock Name="StWindowHeightTb" Classes="NumericInput">Window height</TextBlock>
                                            <!--  Input  -->
                                            <NumericUpDown
                                                Name="StWindowHeightInput"
                                                Grid.Column="1"
                                                Classes="NumericInput"
                                                FormatString="0"
                                                Increment="10"
                                                Maximum="{x:Static local:App.ScreenHeight}"
                                                Minimum="100"
                                                Value="{Binding CoreConfig.Minecraft.WindowHeight, Mode=TwoWay}"
                                                IsEnabled="{Binding !CoreConfig.Minecraft.StartMaximized}"/>
                                        </Grid>
                                        <!--  Close Launcher after game opens  -->
                                        <CheckBox Name="StCloseAfterOpenCb" IsChecked="{Binding CoreConfig.Minecraft.CloseLauncherOnGameStart, Mode=TwoWay}">
                                            <TextBlock Name="StCloseAfterOpenTb" Text="Close launcher after game opens" />
                                        </CheckBox>
                                        <!--  Close Launcher after game closes  -->
                                        <CheckBox Name="StCloseAfterExitCb" IsChecked="{Binding CoreConfig.Minecraft.CloseLauncherOnGameExit, Mode=TwoWay}">
                                            <TextBlock Name="StCloseAfterExitTb" Text="Close launcher after game closes" />
                                        </CheckBox>
                                    </WrapPanel>
                                </ScrollViewer>
                            </TabItem>
                            <!--  Java Settings  -->
                            <TabItem Name="SettingsJavaTab" Classes="SettingsTabItem" Header="Java">
                                <ScrollViewer Margin="0, 0, 10, 0">
                                    <WrapPanel Classes="SettingsWrapper">
                                        <!--  Minimum Memory  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Text  -->
                                            <TextBlock Name="StMinMemoryTb" Classes="NumericInput">Minimum memory</TextBlock>
                                            <!--  Input  -->
                                            <NumericUpDown
                                                Name="StMinMemoryInput"
                                                Grid.Column="1"
                                                Classes="NumericInput"
                                                FormatString="0\ MB"
                                                Increment="128"
                                                Maximum="{Binding CoreConfig.Java.MaxMemory}"
                                                Minimum="512"
                                                Value="{Binding CoreConfig.Java.MinMemory, Mode=TwoWay}" />
                                        </Grid>
                                        <!--  Maximum Memory  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Text  -->
                                            <TextBlock Name="StMaxMemoryTb" Classes="NumericInput">Maximum memory</TextBlock>
                                            <!--  Input  -->
                                            <NumericUpDown
                                                Name="StMaxMemoryInput"
                                                Grid.Column="1"
                                                Classes="NumericInput"
                                                FormatString="0\ MB"
                                                Increment="128"
                                                Maximum="131072"
                                                Minimum="512"
                                                Value="{Binding CoreConfig.Java.MaxMemory, Mode=TwoWay}" />
                                        </Grid>
                                        <!--  PermGen  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Text  -->
                                            <TextBlock Name="StPermaGenTb" Classes="NumericInput">PermGen</TextBlock>
                                            <!--  Input  -->
                                            <NumericUpDown
                                                Name="StPermaGenInput"
                                                Grid.Column="1"
                                                Classes="NumericInput"
                                                FormatString="0\ MB"
                                                Increment="128"
                                                Maximum="1024"
                                                Minimum="8"
                                                Value="{Binding CoreConfig.Java.PermaGen, Mode=TwoWay}" />
                                        </Grid>
                                        <!--  Java Path  -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StJavaPathTb" Classes="TextInput">Java path</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StJavaPathInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Java.DefaultJavaPath, Mode=TwoWay}"
                                                Watermark="Select a directory..." />
                                            <Button Grid.Column="2" Classes="IconBtn" Click="JavaPathSelect_OnClick">
                                                <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                            </Button>
                                        </Grid>
                                        <!--  JVM Arguments  -->
                                        <TextBlock Name="StJvmArgsTb" Classes="SettingsCategory">
                                            JVM Arguments
                                        </TextBlock>
                                        <TextBox
                                            Name="StJvmArgsInput"
                                            MinHeight="128"
                                            MaxLines="512"
                                            Text="{Binding CoreConfig.Java.JvmArguments, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </WrapPanel>
                                </ScrollViewer>
                            </TabItem>
                            <!--  Misc Settings  -->
                            <TabItem Name="SettingsMiscTab" Classes="SettingsTabItem" Header="Misc">
                                <ScrollViewer Margin="0, 0, 10, 0">
                                    <WrapPanel Classes="SettingsWrapper">
                                        <!--  Subtitle  -->
                                        <TextBlock Name="StCustomCommandsTb" Classes="SettingsCategory">
                                            Custom Commands
                                        </TextBlock>
                                        <!--  Pre-launch Command  -->
                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StPreLaunchTb" Classes="TextInput">Pre-launch</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StPreLaunchInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Misc.PreLaunchCommand, Mode=TwoWay}" />
                                        </Grid>
                                        <!--  Wrapper Command  -->
                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StWrapperTb" Classes="TextInput">Wrapper</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StWrapperInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Misc.WrapperCommand, Mode=TwoWay}" />
                                        </Grid>
                                        <!--  Post-exit Command  -->
                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StPostExitTb" Classes="TextInput">Post-exit</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StPostExitInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Misc.PostExitCommand, Mode=TwoWay}" />
                                        </Grid>
                                        <!--  Subtitle  -->
                                        <TextBlock Name="StNativeLibrariesTb" Classes="SettingsCategory">
                                            Native libraries
                                        </TextBlock>
                                        <!--  Use custom GLFW  -->
                                        <CheckBox Name="StUseCustomGlfwCb" IsChecked="{Binding CoreConfig.Misc.UseCustomGlfw, Mode=TwoWay}">
                                            <TextBlock Name="StUseCustomGlfwTb" Text="Use custom GLFW" />
                                        </CheckBox>
                                        <!--  GLFW library path  -->
                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StGlfwPathTb" Classes="TextInput">GLFW library path</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StGlfwPathInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Misc.CustomGlfwPath, Mode=TwoWay}"
                                                IsEnabled="{Binding CoreConfig.Misc.UseCustomGlfw}"/>
                                        </Grid>
                                        <!--  Use custom OpenAL  -->
                                        <CheckBox Name="StUseCustomOpenAlCb" IsChecked="{Binding CoreConfig.Misc.UseCustomOpenAl, Mode=TwoWay}">
                                            <TextBlock Name="StUseCustomOpenAlTb" Text="Use custom OpenAL" />
                                        </CheckBox>
                                        <!--  OpenAL library path  -->
                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                            <!--  Text  -->
                                            <TextBlock Name="StOpenAlPathTb" Classes="TextInput">OpenAL library path</TextBlock>
                                            <!--  Input  -->
                                            <TextBox
                                                Name="StOpenAlPathInput"
                                                Grid.Column="1"
                                                Classes="TextInput"
                                                Text="{Binding CoreConfig.Misc.CustomOpenAlPath, Mode=TwoWay}"
                                                IsEnabled="{Binding CoreConfig.Misc.UseCustomOpenAl}" />
                                        </Grid>
                                        <!--  Subtitle  -->
                                        <TextBlock Name="StPerformanceTb" Classes="SettingsCategory">
                                            Performance
                                        </TextBlock>
                                        <!--  Enable Feral GameMode  -->
                                        <CheckBox Name="StFeralGameModeCb" IsChecked="{Binding CoreConfig.Misc.EnableFeralGameMode, Mode=TwoWay}">
                                            <TextBlock Name="StFeralGameModeTb" Text="Enable Feral GameMode" />
                                        </CheckBox>
                                        <!--  Enable MangoHud  -->
                                        <CheckBox Name="StEnableMangoHudCb" IsChecked="{Binding CoreConfig.Misc.EnableMangoHud, Mode=TwoWay}">
                                            <TextBlock Name="StEnableMangoHudTb" Text="Enable MangoHud" />
                                        </CheckBox>
                                        <!--  Use dedicated GPU  -->
                                        <CheckBox Name="StUseDedicatedGpuCb" IsChecked="{Binding CoreConfig.Misc.UseDedicatedGpu, Mode=TwoWay}">
                                            <TextBlock Name="StUseDedicatedGpuTb" Text="Use dedicated GPU" />
                                        </CheckBox>
                                    </WrapPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Carousel.Items>
            </Carousel>
        </Border>
    </Grid>
</Window>