<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
        xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
        x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.ResourceReviewWindow"
        Title="Konkord Launcher - Resource Downloader Review"
        Width="600"
        Height="500"
        MinWidth="600"
        MinHeight="500"
        d:DesignHeight="500"
        d:DesignWidth="600"
        x:DataType="vm:ResourceReviewViewModel"
        Background="Transparent"
        CanResize="True"
        CornerRadius="14"
        ExtendClientAreaToDecorationsHint="True"
        Icon="avares://Desktop/Assets/Images/logo.png"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
        <Grid>
            <!--  Main window body  -->
            <Border
                Background="{DynamicResource base-200}"
                BorderBrush="{DynamicResource border-one}"
                BorderThickness="1"
                CornerRadius="14"
                PointerPressed="DragStart_PointerPressed">
                <Grid RowDefinitions="Auto, *">
                    <!--  Window Controls  -->
                    <Border HorizontalAlignment="Stretch" PointerPressed="DragStart_PointerPressed">
                        <Grid ColumnDefinitions="*, Auto">
                            <!--  Window Title  -->
                            <TextBlock Classes="WindowTitle" Text="{Binding $parent[Window].Title}" />

                            <!--  Window Buttons  -->
                            <StackPanel Grid.Column="1" Classes="WindowBtnPanel">
                                <!--  MINIMIZE  -->
                                <Button
                                    Classes="WindowBtn WarningBtn"
                                    Command="{Binding MinimizeWindowCommand}"
                                    ToolTip.Tip="{lang:Translate main.window.minimize}" />
                                <!--  MAXIMIZE / RESTORE  -->
                                <Button
                                    Classes="WindowBtn SuccessBtn"
                                    Command="{Binding MaximizeWindowCommand}"
                                    IsEnabled="{Binding $parent[Window].CanResize}"
                                    ToolTip.Tip="{lang:Translate main.window.maximize}" />
                                <!--  CLOSE  -->
                                <Button
                                    Classes="WindowBtn ErrorBtn"
                                    Command="{Binding CloseWindowCommand}"
                                    ToolTip.Tip="{lang:Translate main.window.close}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <Grid Grid.Row="1" RowDefinitions="Auto, *">
                        <!--  Title  -->
                        <Border Classes="ModalTitleBorder">
                            <StackPanel>
                                <TextBlock Text="Review Selection" />
                                <TextBlock Classes="ModalSubTitle" Text="You are about to download the following content:" />
                            </StackPanel>
                        </Border>

                        <!-- Content  -->
                        <Grid Grid.Row="1" RowDefinitions="*, Auto">
                            <ScrollViewer Margin="15, 10, 15, 15">
                                <ItemsControl ItemsSource="{Binding InstanceResources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Classes="InstanceResource">
                                                <Expander.Header>
                                                    <CheckBox Content="{Binding Name}"  />
                                                </Expander.Header>

                                                <StackPanel Margin="45, 5, 0, 5">
                                                    <StackPanel Spacing="5" Orientation="Horizontal">
                                                        <TextBlock Text="File:"/>
                                                        <TextBlock Text="{Binding Path}"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="5" Orientation="Horizontal">
                                                        <TextBlock Text="Provider:"/>
                                                        <TextBlock Text="Modrinth"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            
                            <!--  Buttons  -->
                            <Border Grid.Row="1" Classes="InstanceButtonBorder">
                                <StackPanel Classes="InstanceButtonWrapper">
                                    <!--  Cancel Button  -->
                                    <Button Classes="IconBtn ErrorBtn" Command="{Binding CloseWindowCommand}">
                                        <WrapPanel Classes="IconBtnWrapper">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="FontAwesome"
                                                Text="&#xf00d;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="500"
                                                Text="{lang:Translate common.cancel}" />
                                        </WrapPanel>
                                    </Button>
                                    <!--  Ok Button  -->
                                    <Button Classes="IconBtn SuccessBtn">
                                        <WrapPanel Classes="IconBtnWrapper">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="FontAwesome"
                                                Text="&#xf00c;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="500"
                                                Text="{lang:Translate common.ok}" />
                                        </WrapPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
                
            <!--  Resize overlay (8px grips)  -->
            <Grid ColumnDefinitions="8,*,8" RowDefinitions="8,*,8">
                <!--  Edges  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    Cursor="TopSide"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="North" />
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Background="Transparent"
                    Cursor="BottomSide"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="South" />
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="Transparent"
                    Cursor="LeftSide"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="West" />
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Background="Transparent"
                    Cursor="RightSide"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="East" />

                <!--  Corners  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    Cursor="TopLeftCorner"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="NorthWest" />
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Background="Transparent"
                    Cursor="TopRightCorner"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="NorthEast" />
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Background="Transparent"
                    Cursor="BottomLeftCorner"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="SouthWest" />
                <Border
                    Grid.Row="2"
                    Grid.Column="2"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="ResizeHandle_PointerPressed"
                    Tag="SouthEast" />
            </Grid>
        </Grid>
</Window>
