<Window
    CanResize="False"
    Height="175"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="True"
    Title="Starting..."
    Width="400"
    d:DesignHeight="175"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.InstallWindow"
    x:DataType="models:InstallViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common">

    <Border Classes="ModalView">
        <StackPanel
            Classes="ModalWrapper"
            Spacing="15">
            <!-- Title -->
            <TextBlock Classes="InstallTitleText" Text="{lang:Translate instance.install.title}" />
            <!-- Step -->
            <TextBlock Classes="InstallStepText" Text="{Binding ProgressText}" />
            <!-- Progress bar -->
            <ProgressBar Name="ProgressBar" Classes="InstallProgress" Value="{Binding ProgressValue}" />
        </StackPanel>
    </Border>
</Window>
