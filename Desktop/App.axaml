<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tavstal.KonkordLauncher.Desktop.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <FontFamily x:Key="FontAwesome">Assets/Fonts/fa-solid-900.ttf#Font Awesome 6 Free</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/Themes/DarkTheme.axaml" />
        <StyleInclude Source="Styles/Style.axaml" />
    </Application.Styles>
</Application>