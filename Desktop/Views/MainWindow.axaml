<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Tavstal.KonkordLauncher.Core.Models;assembly=Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Enums"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:local="clr-namespace:Tavstal.KonkordLauncher.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models"
    xmlns:models1="clr-namespace:Tavstal.KonkordLauncher.Common.Models;assembly=Common"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    Title="{lang:Translate main.title}"
    Width="950"
    Height="600"
    d:DesignHeight="600"
    d:DesignWidth="950"
    x:DataType="vm:MainViewModel"
    CanResize="True"
    UseLayoutRounding="True"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ShowInTaskbar="True"
    SystemDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterScreen"
    CornerRadius="14"
    Background="Transparent"
    Icon="avares://Desktop/Assets/Images/logo.png"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <!--  Play Card  -->
        <DataTemplate DataType="models:InstanceModel">
            <Border Classes="PlayCard">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!--  Icon  -->
                    <Image
                        Grid.Row="0"
                        Classes="PlayCardImage"
                        Source="{Binding Icon}" />
                    <!--  Name  -->
                    <TextBlock
                        Grid.Row="1"
                        Classes="PlayCardText"
                        Text="{Binding Name}" />
                    <!--  Buttons  -->
                    <WrapPanel Grid.Row="2" Classes="PlayCardButtonWrapper">
                        <!--  Launch Button  -->
                        <Button
                            Width="32"
                            MaxWidth="32"
                            HorizontalContentAlignment="Center"
                            Classes="IconBtn PrimaryBtn"
                            Command="{Binding $parent[Window].DataContext.LaunchInstanceCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding !IsGameRunning}">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf04b;" />
                        </Button>
                        <!--  Stop Button  -->
                        <Button
                            Width="32"
                            MaxWidth="32"
                            HorizontalContentAlignment="Center"
                            Classes="IconBtn ErrorBtn"
                            Command="{Binding $parent[Window].DataContext.StopInstanceCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding IsGameRunning}">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf04d;" />
                        </Button>
                        <!--  Edit Button  -->
                        <Button
                            Width="34"
                            MaxWidth="34"
                            Classes="IconBtn InfoBtn"
                            Command="{Binding $parent[Window].DataContext.EditInstanceCommand}"
                            CommandParameter="{Binding .}">
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf304;" />
                        </Button>
                        <!--  Menu Button  -->
                        <Button
                            Width="32"
                            MaxWidth="32"
                            Classes="IconBtn SecondaryBtn">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <!--  Name  -->
                                    <MenuItem Header="{Binding Name}" IsEnabled="False" />
                                    <!--  Launch Btn  -->
                                    <MenuItem
                                        Command="{Binding $parent[Window].DataContext.LaunchInstanceCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding !IsGameRunning}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf04b;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.launch}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Stop Btn  -->
                                    <MenuItem
                                        Command="{Binding $parent[Window].DataContext.StopInstanceCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding IsGameRunning}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf04d;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.stop}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Logs Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.ViewInstanceLogsCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf15c;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate instance.view.logs}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <Separator />
                                    <!--  Rename Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.RenameInstanceCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf044;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.rename}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Change Icon Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.ChangeInstanceIconCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf03e;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate instance.change.icon}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Change Group Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.ChangeInstanceGroupCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf5fd;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate instance.change.group}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <Separator />
                                    <!--  Open Folder Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.OpenInstanceDirCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf07c;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.open.directory}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                    <!--  Export Btn  -->
                                    <MenuItem Header="Export">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf56e;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.export}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                        <MenuItem
                                            Command="{Binding $parent[Window].DataContext.ExportNativeInstanceCommand}"
                                            CommandParameter="{Binding .}"
                                            Header="Konkord Launcher" />
                                        <MenuItem
                                            Command="{Binding $parent[Window].DataContext.ExportModrinthInstanceCommand}"
                                            CommandParameter="{Binding .}"
                                            Header="Modrinth" />
                                        <MenuItem
                                            Command="{Binding $parent[Window].DataContext.ExportCurseForgeInstanceCommand}"
                                            CommandParameter="{Binding .}"
                                            Header="CurseForge" />
                                    </MenuItem>
                                    <Separator />
                                    <!--  Delete Btn  -->
                                    <MenuItem Command="{Binding $parent[Window].DataContext.DeleteInstanceCommand}" CommandParameter="{Binding .}">
                                        <MenuItem.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Padding="4,0"
                                                        Classes="FontAwesome"
                                                        Text="&#xf1f8;" />
                                                    <TextBlock Margin="5,0,0,0" Text="{lang:Translate common.delete}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.HeaderTemplate>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <!--  Button Icon  -->
                            <TextBlock
                                Padding="4,0"
                                Classes="FontAwesome"
                                Text="&#xf142;" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  Patch Card  -->
        <DataTemplate DataType="models1:PatchNote">
            <Border Classes="NewsCard">
                <Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto, Auto">
                    <!--  News Card Title  -->
                    <TextBlock Classes="NewsCardTitle" Text="{Binding Title}" />
                    <!--  News Card Description  -->
                    <TextBlock
                        Grid.Row="1"
                        Classes="NewsCardDescription"
                        Text="{Binding Content}"
                        TextWrapping="Wrap" />
                    <!--  Read More Button  -->
                    <HyperlinkButton
                        Grid.Row="2"
                        Classes="IconBtn DefaultBtn"
                        NavigateUri="{Binding Url}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf02d;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.page.patch.read}" />
                        </WrapPanel>
                    </HyperlinkButton>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  Account Card  -->
        <DataTemplate DataType="core:Account">
            <Border Classes="AccountsCard" Classes.selected="{Binding IsSelected}">
                <Grid Width="450" ColumnDefinitions="*, Auto">
                    <!--  Name & Type  -->
                    <WrapPanel Orientation="Vertical">
                        <TextBlock Classes="AccountsCardName" Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                    </WrapPanel>

                    <!--  Buttons  -->
                    <WrapPanel Grid.Column="1" Classes="AccountsCardWrapper">
                        <Button
                            Classes="IconBtn SuccessBtn"
                            Command="{Binding $parent[Window].DataContext.SelectAccountBtnCommand}"
                            CommandParameter="{Binding Id}"
                            IsVisible="{Binding !IsSelected}">
                            <TextBlock Classes="FontAwesome" Text="&#xf00c;" />
                        </Button>
                        <Button
                            Classes="IconBtn WarningBtn"
                            Command="{Binding $parent[Window].DataContext.RefreshAccountBtnCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding CanExpire}">
                            <TextBlock Classes="FontAwesome" Text="&#xf2f9;" />
                        </Button>
                        <Button
                            Classes="IconBtn ErrorBtn"
                            Command="{Binding $parent[Window].DataContext.RemoveAccountBtnCommand}"
                            CommandParameter="{Binding .}">
                            <TextBlock Classes="FontAwesome" Text="&#xf1f8;" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>
    
    <Border CornerRadius="14" BorderBrush="{DynamicResource border-one}" BorderThickness="1">
    <Grid ColumnDefinitions="250, *">
        <!-- Sidebar  -->
        <Border CornerRadius="14, 0, 0, 14" Background="{DynamicResource base-300}" BorderThickness="0, 0, 1, 0" BorderBrush="{DynamicResource border-one}">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20,40, 20, 30">
                <!-- Title -->
                <TextBlock Text="KONKORD"
                           FontWeight="Black"
                           FontSize="20"
                           LetterSpacing="4"
                           Foreground="{DynamicResource primary}"
                           Margin="10,0,0,40" />
                
                <!-- Buttons -->
                <StackPanel Grid.Row="1">
                    <Button
                        Name="PlaySideBtn"
                        Classes="SidebarBtn SideBarActiveBtn"
                        Command="{Binding HandleSidebarBtnCommand}"
                        CommandParameter="{x:Static enums:ESidebarType.Play}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf04b;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.play}" />
                        </WrapPanel>
                    </Button>
                    <Button
                        Name="NewsSideBtn"
                        Classes="SidebarBtn"
                        Command="{Binding HandleSidebarBtnCommand}"
                        CommandParameter="{x:Static enums:ESidebarType.Patch}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf15c;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.patch}" />
                        </WrapPanel>
                    </Button>
                    <Button
                        Name="AccountsSideBtn"
                        Classes="SidebarBtn"
                        Command="{Binding HandleSidebarBtnCommand}"
                        CommandParameter="{x:Static enums:ESidebarType.Accounts}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf0c0;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.accounts}" />
                        </WrapPanel>
                    </Button>
                    <Button
                        Name="SettingsSideBtn"
                        Classes="SidebarBtn"
                        Command="{Binding HandleSidebarBtnCommand}"
                        CommandParameter="{x:Static enums:ESidebarType.Settings}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf013;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.settings}" />
                        </WrapPanel>
                    </Button>
                    <Button
                        Name="AboutSideBtn"
                        Classes="SidebarBtn"
                        Command="{Binding HandleSidebarBtnCommand}"
                        CommandParameter="{x:Static enums:ESidebarType.About}">
                        <WrapPanel Classes="IconBtnWrapper">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="FontAwesome"
                                Text="&#xf02d;" />
                            <TextBlock VerticalAlignment="Center" Text="{lang:Translate main.sidebar.about}" />
                        </WrapPanel>
                    </Button>
                </StackPanel>
                
                <!-- Account Info -->
                <Border Grid.Row="2" Background="{DynamicResource base-100}" CornerRadius="8" HorizontalAlignment="Stretch" Height="75" BorderBrush="{DynamicResource border-two}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto, *">
                        <!--  Avatar  -->
                        <Image Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center" Source="avares://Desktop/Assets/Images/placeholders/steve_head.png" />
                        <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Center">
                            <!--  Logged in text  -->
                            <TextBlock FontSize="10" FontWeight="SemiLight" Foreground="{DynamicResource text-faded}" Text="LOGGED IN AS" />
                            <!--  Username  -->
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource base-content}" Text="Abcdefghjkl123456" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
        <!-- Main Content  -->
        <Border Grid.Column="1" Background="{DynamicResource base-200}" CornerRadius="0, 14, 14, 0">
            <Grid RowDefinitions="Auto, *">
                <!-- Window Controls -->
                <Border HorizontalAlignment="Stretch" Height="20">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,12,12,0">
                        <!-- MINIMIZE -->
                        <Button Classes="WindowBtn WarningBtn"
                                Command="{Binding MinimizeWindowCommand}"
                                ToolTip.Tip="Minimize" />
                        <!-- MAXIMIZE / RESTORE -->
                        <Button Classes="WindowBtn SuccessBtn" 
                                Command="{Binding MaximizeWindowCommand}"
                                ToolTip.Tip="Maximize / Restore"
                                IsVisible="{Binding $parent[Window].CanResize}"/>
                        <!-- CLOSE -->
                        <Button Classes="WindowBtn ErrorBtn" 
                                Command="{Binding CloseWindowCommand}"
                                ToolTip.Tip="Close" />
                    </StackPanel>
                </Border>
                
                <!-- Content Area -->
                <!-- TODO: Finish redesigning the main content area -->
                <Border Grid.Row="1" Classes="MainContentArea">
                    <Carousel SelectedIndex="{Binding CurrentPageIndex}">
                        <Carousel.PageTransition>
                            <CompositePageTransition>
                                <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                            </CompositePageTransition>
                        </Carousel.PageTransition>
                        <Carousel.Items>
                            <!--  Play Page  -->
                            <StackPanel Margin="20,20,5,20" Classes="MainContentArea">
                                <Grid Width="480" ColumnDefinitions="*, Auto">
                                    <!--  Title  -->
                                    <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.play.title}" />
                                    <!--  Add instance button  -->
                                    <Button
                                        Grid.Column="1"
                                        Classes="IconBtn InfoBtn"
                                        Command="{Binding AddInstanceBtnCommand}">
                                        <TextBlock Classes="FontAwesome" Text="&#x2b;" />
                                    </Button>
                                </Grid>
                                <!--  No instances text  -->
                                <TextBlock IsVisible="{Binding !HasInstances}" Text="{lang:Translate main.page.play.empty}" />
                                <!--  Instances on Play Page  -->
                                <Grid MaxHeight="440">
                                    <ScrollViewer Padding="0,0,15,0">
                                        <ItemsControl ItemsSource="{Binding Instances}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Classes="PlayPageWrapper" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>
                            <!--  Patch Page  -->
                            <Grid
                                Margin="20,20,10,20"
                                Classes="MainContentArea"
                                RowDefinitions="Auto, Auto, *">
                                <!--  Title  -->
                                <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.patch.title}" />
                                <!--  Empty text  -->
                                <TextBlock
                                    Grid.Row="1"
                                    IsVisible="{Binding !HasPatches}"
                                    Text="{lang:Translate main.page.patch.empty}" />
                                <!--  News Grid  -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Patches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Classes="NewsPageWrapper" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                            <!--  Accounts Page  -->
                            <StackPanel Classes="MainContentArea">
                                <Grid Width="480" ColumnDefinitions="*, Auto">
                                    <!--  Title  -->
                                    <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.accounts.title}" />
                                    <!--  Add account button  -->
                                    <Button
                                        Grid.Column="1"
                                        Classes="IconBtn InfoBtn"
                                        Command="{Binding AddAccountBtnCommand}">
                                        <TextBlock Classes="FontAwesome" Text="&#xf234;" />
                                    </Button>
                                </Grid>
                                <!--  No accounts text  -->
                                <TextBlock IsVisible="{Binding !AccountData.HasAccounts}" Text="{lang:Translate main.page.accounts.empty}" />
                                <!--  Accounts Grid  -->
                                <Grid MaxHeight="440">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding AccountData.Accounts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Classes="AccountsPageWrapper" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>
                            <!--  Settings Page  -->
                            <TabControl Classes="SettingsMainTab">
                                <!--  Launcher Settings  -->
                                <TabItem Classes="SettingsMainTabItem" Header="{lang:Translate settings.tab.launcher}">
                                    <ScrollViewer Margin="0,0,10,0">
                                        <WrapPanel Classes="SettingsWrapper">
                                            <!--  Enable Launcher Updates  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Launcher.EnableAutomaticUpdates, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.launcher.autoUpdate}" />
                                            </CheckBox>
                                            <!--  Update Interval  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="NumericInput" Text="{lang:Translate settings.launcher.updateInterval}" />
                                                <!--  Input  -->
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Classes="NumericInput"
                                                    FormatString="0\h"
                                                    Increment="1"
                                                    IsEnabled="{Binding CoreConfig.Launcher.EnableAutomaticUpdates}"
                                                    Maximum="8760"
                                                    Minimum="1"
                                                    Value="{Binding CoreConfig.Launcher.UpdateInterval, Mode=TwoWay}" />
                                            </Grid>
                                            <!--  Language  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextDropdown" Text="{lang:Translate settings.launcher.language}" />
                                                <!--  Input  -->
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Classes="TextDropdown"
                                                    ItemsSource="{Binding CoreConfig.AvailableLanguages}"
                                                    SelectedIndex="0"
                                                    SelectionChanged="Language_OnSelected">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Margin="5,0,0,0" Text="{Binding Name}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <!--  Theme  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextDropdown" Text="{lang:Translate settings.launcher.theme}" />
                                                <!--  Input  -->
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Classes="TextDropdown"
                                                    SelectedIndex="{Binding CoreConfig.Launcher.Theme, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Light" />
                                                    <ComboBoxItem Content="Dark" />
                                                </ComboBox>
                                            </Grid>
                                            <!--  Directories  -->
                                            <TextBlock Classes="SettingsCategory" Text="{lang:Translate settings.launcher.subtitle.directories}" />
                                            <!--  Assets Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.assets}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.AssetsDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="0">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Cache Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.cache}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.CacheDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="1">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Icons Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.icons}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.IconsDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="3">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Instances Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.instances}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.InstancesDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="2">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Java Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.java}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.JavaDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="4">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Libraries Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.libraries}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.LibrariesDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="5">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Manifests Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.manifests}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.ManifestsDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="6">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Translations Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.translations}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.TranslationsDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="7">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                            <!--  Versions Directory  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.launcher.dir.versions}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Launcher.VersionsDirectoryPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <!--  Button  -->
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="IconBtn"
                                                    Command="{Binding ConfigDirSelectCommand}"
                                                    CommandParameter="8">
                                                    <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                </Button>
                                            </Grid>
                                        </WrapPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <!--  Minecraft Settings  -->
                                <TabItem Classes="SettingsMainTabItem" Header="{lang:Translate settings.tab.minecraft}">
                                    <ScrollViewer Margin="0,0,10,0">
                                        <WrapPanel Classes="SettingsWrapper">
                                            <!--  Minecraft Maximized  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Minecraft.StartMaximized, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.minecraft.startMaximized}" />
                                            </CheckBox>
                                            <!--  Window Width  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="NumericInput" Text="{lang:Translate settings.minecraft.windowWidth}" />
                                                <!--  Input  -->
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Classes="NumericInput"
                                                    FormatString="0"
                                                    Increment="10"
                                                    IsEnabled="{Binding !CoreConfig.Minecraft.StartMaximized}"
                                                    Maximum="{x:Static local:App.ScreenWidth}"
                                                    Minimum="100"
                                                    Value="{Binding CoreConfig.Minecraft.WindowWidth, Mode=TwoWay}" />
                                            </Grid>
                                            <!--  Window Height  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="NumericInput" Text="{lang:Translate settings.minecraft.windowHeight}" />
                                                <!--  Input  -->
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Classes="NumericInput"
                                                    FormatString="0"
                                                    Increment="10"
                                                    IsEnabled="{Binding !CoreConfig.Minecraft.StartMaximized}"
                                                    Maximum="{x:Static local:App.ScreenHeight}"
                                                    Minimum="100"
                                                    Value="{Binding CoreConfig.Minecraft.WindowHeight, Mode=TwoWay}" />
                                            </Grid>
                                            <!--  Close Launcher after game opens  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Minecraft.CloseLauncherOnGameStart, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.minecraft.closeOpen}" />
                                            </CheckBox>
                                            <!--  Close Launcher after game closes  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Minecraft.CloseLauncherOnGameExit, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.minecraft.closeExit}" />
                                            </CheckBox>
                                        </WrapPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <!--  Java Settings  -->
                                <TabItem Classes="SettingsMainTabItem" Header="{lang:Translate settings.tab.java}">
                                    <ScrollViewer Margin="0,0,10,0">
                                        <WrapPanel Classes="SettingsWrapper">
                                            <!--  Minimum Memory  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="NumericInput" Text="{lang:Translate settings.java.minMemory}" />
                                                <!--  Input  -->
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Classes="NumericInput"
                                                    FormatString="0\ MB"
                                                    Increment="128"
                                                    Maximum="{Binding CoreConfig.Java.MaxMemory}"
                                                    Minimum="512"
                                                    Value="{Binding CoreConfig.Java.MinMemory, Mode=TwoWay}" />
                                            </Grid>
                                            <!--  Maximum Memory  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="NumericInput" Text="{lang:Translate settings.java.maxMemory}" />
                                                <!--  Input  -->
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Classes="NumericInput"
                                                    FormatString="0\ MB"
                                                    Increment="128"
                                                    Maximum="131072"
                                                    Minimum="512"
                                                    Value="{Binding CoreConfig.Java.MaxMemory, Mode=TwoWay}" />
                                            </Grid>
                                            <!--  PermGen  -->
                                            <Grid ColumnDefinitions="Auto, *">
                                                <!--  Text  -->
                                                <TextBlock Classes="NumericInput" Text="{lang:Translate settings.java.permaGen}" />
                                                <!--  Input  -->
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Classes="NumericInput"
                                                    FormatString="0\ MB"
                                                    Increment="128"
                                                    Maximum="1024"
                                                    Minimum="8"
                                                    Value="{Binding CoreConfig.Java.PermaGen, Mode=TwoWay}" />
                                            </Grid>
                                            <!--  Java Path  -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.java.path}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Java.DefaultJavaPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.directory}" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <Button
                                                        Classes="IconBtn"
                                                        Command="{Binding ConfigDirSelectCommand}"
                                                        CommandParameter="9">
                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                    </Button>
                                                    <Button Classes="IconBtn" Command="{Binding JavaPathSelectorCommand}">
                                                        <TextBlock Classes="FontAwesome" Text="&#xf126;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <!--  JVM Arguments  -->
                                            <TextBlock Classes="SettingsCategory" Text="{lang:Translate settings.java.jvmArgs}" />
                                            <TextBox
                                                MinHeight="128"
                                                MaxLines="512"
                                                Text="{Binding CoreConfig.Java.JvmArguments, Mode=TwoWay}"
                                                TextWrapping="Wrap" />
                                        </WrapPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <!--  Misc Settings  -->
                                <TabItem Classes="SettingsMainTabItem" Header="{lang:Translate settings.tab.misc}">
                                    <ScrollViewer Margin="0,0,10,0">
                                        <WrapPanel Classes="SettingsWrapper">
                                            <!--  Subtitle  -->
                                            <TextBlock Classes="SettingsCategory" Text="{lang:Translate settings.misc.subtitle.customCommands}" />
                                            <!--  Pre-launch Command  -->
                                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.misc.prelaunchCommand}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Misc.PreLaunchCommand, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Classes="Muted" Text="{lang:Translate settings.misc.prelaunchCommand.description}" />
                                            <!--  Wrapper Command  -->
                                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.misc.wrapperCommand}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Misc.WrapperCommand, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Classes="Muted" Text="{lang:Translate settings.misc.wrapperCommand.description}" />
                                            <!--  Post-exit Command  -->
                                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.misc.postExitCommand}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    Text="{Binding CoreConfig.Misc.PostExitCommand, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Classes="Muted" Text="{lang:Translate settings.misc.postExitCommand.description}" />
                                            <!--  Subtitle  -->
                                            <TextBlock Classes="SettingsCategory" Text="{lang:Translate settings.misc.subtitle.nativeLibraries}" />
                                            <!--  Use custom GLFW  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Misc.UseCustomGlfw, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.misc.customGLFW}" />
                                            </CheckBox>
                                            <!--  GLFW library path  -->
                                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.misc.pathGLFW}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    IsEnabled="{Binding CoreConfig.Misc.UseCustomGlfw}"
                                                    Text="{Binding CoreConfig.Misc.CustomGlfwPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.file}" />
                                            </Grid>
                                            <!--  Use custom OpenAL  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Misc.UseCustomOpenAl, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.misc.customOpenAL}" />
                                            </CheckBox>
                                            <!--  OpenAL library path  -->
                                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                <!--  Text  -->
                                                <TextBlock Classes="TextInput" Text="{lang:Translate settings.misc.pathOpenAL}" />
                                                <!--  Input  -->
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="TextInput"
                                                    IsEnabled="{Binding CoreConfig.Misc.UseCustomOpenAl}"
                                                    Text="{Binding CoreConfig.Misc.CustomOpenAlPath, Mode=TwoWay}"
                                                    Watermark="{lang:Translate common.select.file}" />
                                            </Grid>
                                            <!--  Subtitle  -->
                                            <TextBlock Classes="SettingsCategory" Text="{lang:Translate settings.misc.subtitle.performance}" />
                                            <!--  Enable Feral GameMode  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Misc.EnableFeralGameMode, Mode=TwoWay}" IsVisible="{Binding IsLinux}">
                                                <TextBlock Text="{lang:Translate settings.misc.enableGameMode}" />
                                            </CheckBox>
                                            <!--  Enable MangoHud  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Misc.EnableMangoHud, Mode=TwoWay}" IsVisible="{Binding IsLinux}">
                                                <TextBlock Text="{lang:Translate settings.misc.enableMangoHud}" />
                                            </CheckBox>
                                            <!--  Use dedicated GPU  -->
                                            <CheckBox IsChecked="{Binding CoreConfig.Misc.UseDedicatedGpu, Mode=TwoWay}">
                                                <TextBlock Text="{lang:Translate settings.misc.useDedicatedGpu}" />
                                            </CheckBox>
                                        </WrapPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                            <!--  About Page  -->
                            <TabControl Classes="AboutTab">
                                <!--  About  -->
                                <TabItem Classes="AboutTabItem" Header="{lang:Translate about.tab.about}">
                                    <ScrollViewer>
                                        <Grid Classes="AboutWrapper" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                            <!--  Logo  -->
                                            <Image Classes="AboutLogo" Source="avares://Desktop/Assets/Images/logo.png" />
                                            <!--  Description  -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Classes="CreditText"
                                                Text="{lang:Translate about.description}" />
                                            <!--  Github Link  -->
                                            <HyperlinkButton
                                                Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                NavigateUri="https://github.com/TavstalDev/KonkordLauncher">
                                                <TextBlock Classes="LinkText">
                                                    https://github.com/TavstalDev/KonkordLauncher
                                                </TextBlock>
                                            </HyperlinkButton>
                                            <!--  Website Link  -->
                                            <HyperlinkButton
                                                Grid.Row="3"
                                                HorizontalAlignment="Center"
                                                NavigateUri="https://tavstaldev.github.io/KonkordLauncher">
                                                <TextBlock Classes="LinkText">
                                                    https://tavstaldev.github.io/KonkordLauncher
                                                </TextBlock>
                                            </HyperlinkButton>
                                            <!--  Line  -->
                                            <Border Grid.Row="4" Classes="BreakLine" />
                                            <!--  Version  -->
                                            <WrapPanel Grid.Row="5" Classes="AboutVersionWrapper">
                                                <TextBlock Classes="CreditText" Text="{lang:Translate about.version}" />
                                                <TextBlock Classes="CreditText" Text="{Binding Version}" />
                                            </WrapPanel>
                                            <!--  Build Date  -->
                                            <WrapPanel Grid.Row="6" Classes="AboutVersionWrapper">
                                                <TextBlock Classes="CreditText" Text="{lang:Translate about.buildDate}" />
                                                <TextBlock Classes="CreditText" Text="{Binding BuildDate}" />
                                            </WrapPanel>
                                            <!--  Branch  -->
                                            <WrapPanel Grid.Row="7" Classes="AboutVersionWrapper">
                                                <TextBlock Classes="CreditText" Text="{lang:Translate about.branch}" />
                                                <TextBlock Classes="CreditText" Text="{Binding Branch}" />
                                            </WrapPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                                <!--  Credits  -->
                                <TabItem Classes="AboutTabItem" Header="{lang:Translate about.tab.credits}">
                                    <ScrollViewer>
                                        <Grid Classes="AboutWrapper" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                            <!--  Project Maintainers  -->
                                            <WrapPanel Classes="CreditWrapper">
                                                <!--  Subtitle  -->
                                                <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.projectMaintainers}" />
                                                <TextBlock Classes="CreditText">
                                                    Tavstal
                                                </TextBlock>
                                            </WrapPanel>
                                            <!--  Line  -->
                                            <Border Grid.Row="1" Classes="BreakLine" />
                                            <!--  Contributors  -->
                                            <WrapPanel Grid.Row="2" Classes="CreditWrapper">
                                                <!--  Subtitle  -->
                                                <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.contributors}" />
                                                <TextBlock Classes="CreditText">
                                                    -
                                                </TextBlock>
                                            </WrapPanel>
                                            <!--  Line  -->
                                            <Border
                                                Grid.Row="3"
                                                Height="1"
                                                Classes="BreakLine" />
                                            <!--  Special Thanks  -->
                                            <WrapPanel Grid.Row="4" Classes="CreditWrapper">
                                                <!--  Subtitle  -->
                                                <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.specialThanks}" />
                                                <TextBlock Classes="CreditText">
                                                    -
                                                </TextBlock>
                                            </WrapPanel>
                                            <!--  Line  -->
                                            <Border
                                                Grid.Row="5"
                                                Height="1"
                                                Classes="BreakLine" />
                                            <!--  Third-Party  -->
                                            <WrapPanel Grid.Row="6" Classes="CreditWrapper">
                                                <!--  Subtitle  -->
                                                <TextBlock Classes="AboutCategory" Text="{lang:Translate about.credits.thirdParty}" />
                                                <!--  AvaloniaUI  -->
                                                <TextBlock Classes="CreditText">
                                                    AvaloniaUI: Cross-platform UI framework.
                                                </TextBlock>
                                                <!--  CommunityToolkit.Mvvm  -->
                                                <TextBlock Classes="CreditText">
                                                    CommunityToolkit.Mvvm: MVVM helper types.
                                                </TextBlock>
                                                <!--  Newtonsoft.Json  -->
                                                <TextBlock Classes="CreditText">
                                                    Newtonsoft.Json: JSON serialization.
                                                </TextBlock>
                                                <!--  Markdown.Avalonia & ReverseMarkdown  -->
                                                <TextBlock Classes="CreditText">
                                                    Markdown.Avalonia and ReverseMarkdown: Markdown handling.
                                                </TextBlock>
                                                <!--  SharpZipLib  -->
                                                <TextBlock Classes="CreditText">
                                                    SharpZipLib: File compression library.
                                                </TextBlock>
                                                <!--  CmlLib  -->
                                                <TextBlock Classes="CreditText">
                                                    CmlLib: Provided a reference for the Forge installation logic.
                                                </TextBlock>
                                                <!--  Modrinth & CurseForge  -->
                                                <TextBlock Classes="CreditText">
                                                    Modrinth and CurseForge: Used for mod, modpack, and resource pack downloads.
                                                </TextBlock>
                                                <!--  Mojang  -->
                                                <TextBlock Classes="CreditText">
                                                    Mojang: Makers of Minecraft.
                                                </TextBlock>
                                                <!--  FontAwesome  -->
                                                <TextBlock Classes="CreditText">
                                                    FontAwesome: Icon library.
                                                </TextBlock>
                                                <!--  TextStudio  -->
                                                <TextBlock Classes="CreditText">
                                                    TextStudio: Minecraft 3D text creator.
                                                </TextBlock>
                                                <!--  Minecraft Block Icons  -->
                                                <TextBlock Classes="CreditText">
                                                    Minecraft Block Icons: Sourced from Minecraft and its wiki.
                                                </TextBlock>
                                                <!--    -->
                                                <TextBlock Classes="CreditText">
                                                    PrismLauncher: A major source of inspiration for the launcher's functionality.
                                                </TextBlock>
                                            </WrapPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                                <!--  License  -->
                                <TabItem Classes="AboutTabItem" Header="{lang:Translate about.tab.license}">
                                    <ScrollViewer Classes="LicenseScrollViewer">
                                        <TextBlock Classes="LicenseText" Text="{Binding License}" />
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Carousel.Items>
                    </Carousel>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>