<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.EditInstanceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:local="clr-namespace:Tavstal.KonkordLauncher.Desktop"
    Title="Edit Instance"
    Width="900"
    Height="500"
    MinWidth="900"
    MinHeight="500"
    d:DesignHeight="500"
    d:DesignWidth="900"
    x:DataType="vm:EditInstanceViewModel"
    CanResize="True"
    Icon="../Assets/Images/logo.png"
    ShowInTaskbar="False"
    mc:Ignorable="d">

    <!--  Content  -->
    <Border Classes="InstanceView">
        <Grid RowDefinitions="Auto,*">
            <!--  Title  -->
            <TextBlock
                HorizontalAlignment="Left"
                Classes="InstanceTitle"
                Text="Editing Instance: My Pack" />

            <!--  Content  -->
            <Grid Grid.Row="1">
                <TabControl
                    Classes="ModalVerticalTab"
                    SelectedIndex="7"
                    TabStripPlacement="Left">
                    <!--  Logs  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Logs">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!--  Title  -->
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="500"
                                    Text="Latest Log" />
                                <!--  Log content  -->
                                <Border Grid.Row="1" Classes="GridInnerContent">
                                    <ScrollViewer>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            Opacity="0.8"
                                            Text="Loading..."
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                                <!--  Actions  -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*, Auto, Auto, Auto, Auto"
                                    ColumnSpacing="5">
                                    <!--  Search bar  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Classes="TextInput"
                                        Watermark="Search..." />
                                    <!--  Search button  -->
                                    <Button Grid.Column="1" Classes="IconBtn">
                                        <TextBlock Text="Search" />
                                    </Button>
                                    <!--  To bottom button  -->
                                    <Button Grid.Column="2" Classes="IconBtn">
                                        <TextBlock Text="Bottom" />
                                    </Button>
                                    <!--  Copy button  -->
                                    <Button Grid.Column="3" Classes="IconBtn">
                                        <TextBlock Text="Copy" />
                                    </Button>
                                    <!--  Clear button  -->
                                    <Button Grid.Column="4" Classes="IconBtn ErrorBtn">
                                        <TextBlock Text="Clear" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Mods  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Mods" IsVisible="{Binding !IsVanilla}">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!--  Title  -->
                                <TextBlock Classes="ModalGridTitle" Text="Mods" />
                                <!--  Content  -->
                                <Border Grid.Row="1">
                                    <ScrollViewer Classes="TableScrollViewer">
                                        <DataGrid
                                            Classes="InstanceMultiTable"
                                            ItemsSource="{Binding Mods}"
                                            LoadingRow="ModsDataGrid_OnLoading">
                                            <DataGrid.Columns>
                                                <!--  Enabled  -->
                                                <DataGridCheckBoxColumn
                                                    Width="Auto"
                                                    Binding="{Binding IsEnabled}"
                                                    Header="Enabled"
                                                    IsReadOnly="False" />
                                                <!--  Image  -->
                                                <DataGridTemplateColumn Width="Auto" Header="Image">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Image
                                                                Width="32"
                                                                Height="32"
                                                                Source="{Binding Icon}"
                                                                Stretch="UniformToFill" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!--  Name  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Name}"
                                                    Header="Name" />
                                                <!--  Version  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Version}"
                                                    Header="Version" />
                                                <!--  Last Modified  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding LastModified}"
                                                    Header="Last Modified" />
                                                <!--  Provider  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Provider}"
                                                    Header="Provider" />
                                                <!--  Size  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Size}"
                                                    Header="Size" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                                <!--  Actions  -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*, Auto, Auto, Auto"
                                    ColumnSpacing="5">
                                    <!--  Search bar  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Classes="TextInput"
                                        Watermark="Search..." />
                                    <!--  Search button  -->
                                    <Button Grid.Column="1" Classes="IconBtn">
                                        <TextBlock Text="Search" />
                                    </Button>
                                    <!--  Download  -->
                                    <Button Grid.Column="2" Classes="IconBtn">
                                        <TextBlock Text="Download Mods" />
                                    </Button>
                                    <!--  View Folder  -->
                                    <Button Grid.Column="3" Classes="IconBtn">
                                        <TextBlock Text="View Folder" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Resource packs  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Resource packs">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!--  Title  -->
                                <TextBlock Classes="ModalGridTitle" Text="Resource Packs" />
                                <!--  Content  -->
                                <Border Grid.Row="1">
                                    <ScrollViewer Classes="TableScrollViewer">
                                        <DataGrid
                                            Classes="InstanceMultiTable"
                                            ItemsSource="{Binding ResourcePacks}"
                                            LoadingRow="ResourcePacksDataGrid_OnLoading">
                                            <DataGrid.Columns>
                                                <!--  Enabled  -->
                                                <DataGridCheckBoxColumn
                                                    Width="Auto"
                                                    Binding="{Binding IsEnabled}"
                                                    Header="Enabled"
                                                    IsReadOnly="False" />
                                                <!--  Image  -->
                                                <DataGridTemplateColumn Width="Auto" Header="Image">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Image
                                                                Width="32"
                                                                Height="32"
                                                                Source="{Binding Icon}"
                                                                Stretch="UniformToFill" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!--  Name  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Name}"
                                                    Header="Name" />
                                                <!--  Version  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Version}"
                                                    Header="Version" />
                                                <!--  Last Modified  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding LastModified}"
                                                    Header="Last Modified" />
                                                <!--  Provider  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Provider}"
                                                    Header="Provider" />
                                                <!--  Size  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Size}"
                                                    Header="Size" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                                <!--  Actions  -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*, Auto, Auto, Auto"
                                    ColumnSpacing="5">
                                    <!--  Search bar  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Classes="TextInput"
                                        Watermark="Search..." />
                                    <!--  Search button  -->
                                    <Button Grid.Column="1" Classes="IconBtn">
                                        <TextBlock Text="Search" />
                                    </Button>
                                    <!--  Download  -->
                                    <Button Grid.Column="2" Classes="IconBtn">
                                        <TextBlock Text="Download Packs" />
                                    </Button>
                                    <!--  View Folder  -->
                                    <Button Grid.Column="3" Classes="IconBtn">
                                        <TextBlock Text="View Folder" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Shader packs  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Shader packs" IsVisible="{Binding !IsVanilla}">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!--  Title  -->
                                <TextBlock Classes="ModalGridTitle" Text="Shader Packs" />
                                <!--  Content  -->
                                <Border Grid.Row="1">
                                    <ScrollViewer Classes="TableScrollViewer">
                                        <DataGrid
                                            Classes="InstanceMultiTable"
                                            ItemsSource="{Binding ShaderPacks}"
                                            LoadingRow="ShaderDataGrid_OnLoading">
                                            <DataGrid.Columns>
                                                <!--  Enabled  -->
                                                <DataGridCheckBoxColumn
                                                    Width="Auto"
                                                    Binding="{Binding IsEnabled}"
                                                    Header="Enabled"
                                                    IsReadOnly="False" />
                                                <!--  Image  -->
                                                <DataGridTemplateColumn Width="Auto" Header="Image">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Image
                                                                Width="32"
                                                                Height="32"
                                                                Source="{Binding Icon}"
                                                                Stretch="UniformToFill" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!--  Name  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Name}"
                                                    Header="Name" />
                                                <!--  Version  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Version}"
                                                    Header="Version" />
                                                <!--  Last Modified  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding LastModified}"
                                                    Header="Last Modified" />
                                                <!--  Provider  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Provider}"
                                                    Header="Provider" />
                                                <!--  Size  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Size}"
                                                    Header="Size" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                                <!--  Actions  -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*, Auto, Auto, Auto"
                                    ColumnSpacing="5">
                                    <!--  Search bar  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Classes="TextInput"
                                        Watermark="Search..." />
                                    <!--  Search button  -->
                                    <Button Grid.Column="1" Classes="IconBtn">
                                        <TextBlock Text="Search" />
                                    </Button>
                                    <!--  Download  -->
                                    <Button Grid.Column="2" Classes="IconBtn">
                                        <TextBlock Text="Download Shaders" />
                                    </Button>
                                    <!--  View Folder  -->
                                    <Button Grid.Column="3" Classes="IconBtn">
                                        <TextBlock Text="View Folder" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Worlds  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Worlds">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!--  Title  -->
                                <TextBlock Classes="ModalGridTitle" Text="Worlds" />
                                <!--  Content  -->
                                <Border Grid.Row="1">
                                    <ScrollViewer Classes="TableScrollViewer">
                                        <DataGrid
                                            Classes="InstanceMultiTable"
                                            ItemsSource="{Binding Worlds}"
                                            LoadingRow="WorldDataGrid_OnLoading">
                                            <DataGrid.Columns>
                                                <!--  Icon & Name  -->
                                                <DataGridTemplateColumn Width="Auto" Header="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Image
                                                                    Height="48"
                                                                    MaxWidth="48"
                                                                    Margin="5"
                                                                    Source="{Binding Icon}"
                                                                    Stretch="UniformToFill" />
                                                                <TextBlock
                                                                    Margin="0,0,25,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Name}"
                                                                    TextAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!--  GameMode  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Gamemode}"
                                                    Header="GameMode" />
                                                <!--  Last Played  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding LastPlayed}"
                                                    Header="Last Played" />
                                                <!--  Size  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Size}"
                                                    Header="Size" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                                <!--  Actions  -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*, Auto, Auto"
                                    ColumnSpacing="5">
                                    <!--  Search bar  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Classes="TextInput"
                                        Watermark="Search..." />
                                    <!--  Search button  -->
                                    <Button Grid.Column="1" Classes="IconBtn">
                                        <TextBlock Text="Search" />
                                    </Button>
                                    <!--  View Folder  -->
                                    <Button Grid.Column="2" Classes="IconBtn">
                                        <TextBlock Text="View Folder" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Servers  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Servers">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!--  Title  -->
                                <TextBlock Classes="ModalGridTitle" Text="Servers" />
                                <!--  Content  -->
                                <Border Grid.Row="1">
                                    <ScrollViewer Classes="TableScrollViewer">
                                        <DataGrid
                                            Classes="InstanceMultiTable"
                                            ItemsSource="{Binding Servers}"
                                            LoadingRow="ServerDataGrid_OnLoading">
                                            <DataGrid.Columns>
                                                <!--  Icon & Name  -->
                                                <DataGridTemplateColumn Width="Auto" Header="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Image
                                                                    Height="48"
                                                                    MaxWidth="48"
                                                                    Margin="5"
                                                                    Source="{Binding Icon}"
                                                                    Stretch="UniformToFill" />
                                                                <TextBlock
                                                                    Margin="0,0,25,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Name}"
                                                                    TextAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!--  Address  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Address}"
                                                    Header="Address" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                                <!--  Actions  -->
                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*, *, Auto, Auto"
                                    ColumnSpacing="5">
                                    <!--  Name bar  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Classes="TextInput"
                                        Watermark="Name..." />
                                    <!--  Address bar  -->
                                    <TextBox
                                        Grid.Column="1"
                                        Classes="TextInput"
                                        Watermark="Address..." />
                                    <!--  Search button  -->
                                    <Button Grid.Column="2" Classes="IconBtn">
                                        <TextBlock Text="Save" />
                                    </Button>
                                    <!--  Add  -->
                                    <Button Grid.Column="3" Classes="IconBtn">
                                        <TextBlock Text="Add" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Screenshots  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Screenshots">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *">
                                <!--  Title  -->
                                <TextBlock Classes="ModalGridTitle" Text="Screenshots" />
                                <!--  Content  -->
                                <Border Grid.Row="1">
                                    <ScrollViewer Classes="TableScrollViewer">
                                        <DataGrid
                                            Classes="InstanceMultiTable"
                                            ItemsSource="{Binding Screenshots}"
                                            LoadingRow="ScreenshotDataGrid_OnLoading">
                                            <DataGrid.Columns>
                                                <!--  Icon & Name  -->
                                                <DataGridTemplateColumn Width="Auto" Header="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Image
                                                                    Height="48"
                                                                    MaxWidth="48"
                                                                    Margin="5"
                                                                    Source="{Binding Image}"
                                                                    Stretch="UniformToFill" />
                                                                <TextBlock
                                                                    Margin="0,0,25,0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Name}"
                                                                    TextAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!--  Size  -->
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Size}"
                                                    Header="Size" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!--  Settings  -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Settings">
                        <Border Classes="ModalScrollableWrapper" Padding="25">
                            <TabControl Classes="ModalTab">
                                <!-- Java Settings  -->
                                <TabItem Classes="ModalTabItem" Header="Java">
                                    <Border Classes="ModalInnerScrollableWrapper">
                                        <ScrollViewer Classes="ModalScrollViewer">
                                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                                                 <!-- Minimum Memory -->
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <!-- Text -->
                                                    <TextBlock Name="StMinMemoryTb" Classes="NumericInput">Minimum memory</TextBlock>
                                                    <!-- Input -->
                                                    <NumericUpDown
                                                        Grid.Column="1"
                                                        Name="StMinMemoryInput"
                                                        FormatString="0\ MB"
                                                        Classes="NumericInput"
                                                        Increment="1"
                                                        Minimum="512"
                                                        Maximum="{Binding InstanceConfig.Java.MaxMemory}"
                                                        Value="{Binding InstanceConfig.Java.MinMemory}" />
                                                </Grid>
                                                <!-- Maximum Memory -->
                                                <Grid Grid.Row="1" ColumnDefinitions="Auto, *">
                                                    <!-- Text -->
                                                    <TextBlock Name="StMaxMemoryTb" Classes="NumericInput">Maximum memory</TextBlock>
                                                    <!-- Input -->
                                                    <NumericUpDown
                                                        Grid.Column="1"
                                                        Name="StMaxMemoryInput"
                                                        FormatString="0\ MB"
                                                        Classes="NumericInput"
                                                        Increment="1"
                                                        Minimum="512"
                                                        Maximum="131072"
                                                        Value="{Binding InstanceConfig.Java.MaxMemory}" />
                                                </Grid>
                                                <!-- Java Path -->
                                                <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto">
                                                    <!-- Text -->
                                                    <TextBlock Name="StJavaPathTb" Classes="TextInput">Java path</TextBlock>
                                                    <!-- Input -->
                                                    <TextBox
                                                        Grid.Column="1"
                                                        Name="StJavaPathInput"
                                                        Classes="TextInput"
                                                        Watermark="Select a directory..."
                                                        Text="{Binding InstanceConfig.Java.DefaultJavaPath}"/>
                                                    <Button Grid.Column="2" Classes="IconBtn" Click="JavaPathSelect_OnClick">
                                                        <TextBlock Classes="FontAwesome" Text="&#xf07c;" />
                                                    </Button>
                                                    <Button Grid.Column="3" Classes="IconBtn" Click="JavaOpenPathSelector_OnClick">
                                                        <TextBlock Classes="FontAwesome" Text="&#xf126;" />
                                                    </Button>
                                                </Grid>
                                                <!-- JVM Arguments -->
                                                <TextBlock Grid.Row="4" Name="StJvmArgsTb" Classes="SettingsCategory">
                                                    JVM Arguments
                                                </TextBlock>
                                                <TextBox Grid.Row="5"
                                                         Name="StJvmArgsInput"
                                                         MaxLines="512"
                                                         MinHeight="128"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding InstanceConfig.Java.JvmArguments}"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <!-- Game Settings  -->
                                <TabItem Classes="ModalTabItem" Header="Game">
                                    <Border Classes="ModalInnerScrollableWrapper">
                                        <ScrollViewer Classes="ModalScrollViewer">
                                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                                                <!-- Window Settings  -->
                                                <TextBlock Name="StWindowSubtitleTb" Classes="SettingsCategory">
                                                    Window
                                                </TextBlock>
                                                <!--  Minecraft Maximized  -->
                                                <CheckBox Grid.Row="1" Name="StMinecraftMaximizedCb" IsChecked="{Binding InstanceConfig.Game.StartMaximized}">
                                                    <TextBlock Name="StMinecraftMaximizedTb" Text="Start Minecraft maximized" />
                                                </CheckBox>
                                                <!--  Window Width  -->
                                                <Grid Grid.Row="2" ColumnDefinitions="Auto, *">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StWindowWidthTb" Classes="NumericInput">Window width</TextBlock>
                                                    <!--  Input  -->
                                                    <NumericUpDown
                                                        Name="StWindowWidthInput"
                                                        Grid.Column="1"
                                                        Classes="NumericInput"
                                                        FormatString="0"
                                                        Increment="1"
                                                        Maximum="{x:Static local:App.ScreenWidth}"
                                                        Minimum="100"
                                                        Value="{Binding InstanceConfig.Game.WindowWidth, Mode=TwoWay}"
                                                        IsEnabled="{Binding !InstanceConfig.Game.StartMaximized}" />
                                                </Grid>
                                                <!--  Window Height  -->
                                                <Grid Grid.Row="3" ColumnDefinitions="Auto, *">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StWindowHeightTb" Classes="NumericInput">Window height</TextBlock>
                                                    <!--  Input  -->
                                                    <NumericUpDown
                                                        Name="StWindowHeightInput"
                                                        Grid.Column="1"
                                                        Classes="NumericInput"
                                                        FormatString="0"
                                                        Increment="1"
                                                        Maximum="{x:Static local:App.ScreenHeight}"
                                                        Minimum="100"
                                                        Value="{Binding InstanceConfig.Game.WindowHeight, Mode=TwoWay}"
                                                        IsEnabled="{Binding !InstanceConfig.Game.StartMaximized}" />
                                                </Grid>
                                                <!-- Console Settings  -->
                                                <TextBlock Grid.Row="4" Name="StConsoleSubtitleTb" Classes="SettingsCategory">
                                                    Console
                                                </TextBlock>
                                                <!--  Show console  -->
                                                <CheckBox Grid.Row="5" Name="StShowConsoleCb" IsChecked="{Binding InstanceConfig.Game.ShowConsoleWhileGameRunning}">
                                                    <TextBlock Name="StShowConsoleTb" Text="Show console while minecraft is running" />
                                                </CheckBox>
                                                <!--  Auto close console  -->
                                                <CheckBox Grid.Row="6" Name="StCloseConsoleOnQuitCb" IsChecked="{Binding InstanceConfig.Game.CloseConsoleOnGameExit}">
                                                    <TextBlock Name="StCloseConsoleOnQuitTb" Text="Close console when minecraft quits" />
                                                </CheckBox>
                                                <!-- Show console on crash  -->
                                                <CheckBox Grid.Row="7" Name="StShowConsoleOnCrashCb" IsChecked="{Binding InstanceConfig.Game.ShowConsoleWhenGameCrashes}">
                                                    <TextBlock Name="StShowConsoleOnCrashTb" Text="Show console when minecraft crashes" />
                                                </CheckBox>
                                                <!-- Performance Settings  -->
                                                <TextBlock Grid.Row="8" Name="StPerformanceSubtitleTb" Classes="SettingsCategory">
                                                    Performance
                                                </TextBlock>
                                                <!--  Enable Feral GameMode  -->
                                                <CheckBox Grid.Row="9" Name="StFeralGameModeCb" IsVisible="{Binding IsLinux}" IsChecked="{Binding InstanceConfig.Game.EnableFeralGameMode}">
                                                    <TextBlock Name="StFeralGameModeTb" Text="Enable Feral GameMode" />
                                                </CheckBox>
                                                <!--  Enable MangoHud  -->
                                                <CheckBox Grid.Row="10" Name="StEnableMangoHudCb" IsVisible="{Binding IsLinux}" IsChecked="{Binding InstanceConfig.Game.EnableMangoHud}">
                                                    <TextBlock Name="StEnableMangoHudTb" Text="Enable MangoHud" />
                                                </CheckBox>
                                                <!--  Use dedicated GPU  -->
                                                <CheckBox Grid.Row="11" Name="StUseDedicatedGpuCb" IsChecked="{Binding InstanceConfig.Game.UseDedicatedGpu}">
                                                    <TextBlock Name="StUseDedicatedGpuTb" Text="Use dedicated GPU" />
                                                </CheckBox>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <!-- Custom Commands Settings  -->
                                <TabItem Classes="ModalTabItem" Header="Custom Commands">
                                    <Border Classes="ModalInnerScrollableWrapper">
                                        <ScrollViewer Classes="ModalScrollViewer">
                                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                                                <!--  Pre-launch Command  -->
                                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StPreLaunchTb" Classes="TextInput">Pre-launch</TextBlock>
                                                    <!--  Input  -->
                                                    <TextBox
                                                        Name="StPreLaunchInput"
                                                        Grid.Column="1"
                                                        Classes="TextInput"
                                                        Watermark="echo Instance started"
                                                        Text="{Binding InstanceConfig.Commands.PreLaunchCommand}" />
                                                </Grid>
                                                <TextBlock Grid.Row="1" Name="StPreLaunchDescTb" Classes="Muted" Text="Runs before the instance starts. The instance will not begin until this command has completed." />
                                                <!--  Wrapper Command  -->
                                                <Grid Grid.Row="2" ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StWrapperTb" Classes="TextInput">Wrapper</TextBlock>
                                                    <!--  Input  -->
                                                    <TextBox
                                                        Name="StWrapperInput"
                                                        Grid.Column="1"
                                                        Classes="TextInput"
                                                        Watermark="gamemoderun %command%"
                                                        Text="{Binding InstanceConfig.Commands.WrapperCommand}" />
                                                </Grid>
                                                <TextBlock Name="StWrapperDescTb" Grid.Row="3" Classes="Muted" Text="Wraps the Java Virtual Machine. The %command% placeholder is replaced with the Java executable path and all the Minecraft arguments. %command% is optional." />
                                                <!--  Post-exit Command  -->
                                                <Grid Grid.Row="4" ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StPostExitTb" Classes="TextInput">Post-exit</TextBlock>
                                                    <!--  Input  -->
                                                    <TextBox
                                                        Name="StPostExitInput"
                                                        Grid.Column="1"
                                                        Classes="TextInput"
                                                        Watermark="echo Instance stopped"
                                                        Text="{Binding InstanceConfig.Commands.PostExitCommand}" />
                                                </Grid>
                                                <TextBlock Name="StPostExitDescTb" Grid.Row="5" Classes="Muted" Text="Runs after the instance has stopped." />
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <!-- Environment Settings  -->
                                <TabItem Classes="ModalTabItem" Header="Environment">
                                    <Border Classes="ModalInnerScrollableWrapper">
                                        <ScrollViewer Classes="ModalScrollViewer">
                                            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
                                                <!--  Enable Env vars -->
                                                <CheckBox Name="StUseEnvVarsCb" IsChecked="{Binding InstanceConfig.EnableEnvironment}">
                                                    <TextBlock Name="StUseEnvVarsTb" Text="Enable Environment Variables" />
                                                </CheckBox>
                                                <!--  Content  -->
                                                <Border Grid.Row="1">
                                                    <ScrollViewer Classes="TableScrollViewer">
                                                        <DataGrid
                                                            Classes="InstanceMultiTable"
                                                            IsReadOnly="False"
                                                            RowEditEnded="EnvironmentDataGrid_OnRowEditEnded"
                                                            ItemsSource="{Binding InstanceConfig.Environment}"
                                                            SelectedIndex="{Binding  SelectedEnvironmentVariableIndex}"
                                                            IsEnabled="{Binding InstanceConfig.EnableEnvironment}">
                                                            <DataGrid.Columns>
                                                                <!-- Name  -->
                                                                <DataGridTextColumn
                                                                    Width="Auto"
                                                                    Binding="{Binding Key}"
                                                                    Header="Name" />
                                                                <!-- Value -->
                                                                <DataGridTextColumn
                                                                    Width="Auto"
                                                                    Binding="{Binding Value}"
                                                                    Header="Value" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ScrollViewer>
                                                </Border>
                                                <!--  Actions  -->
                                                <Grid
                                                    Grid.Row="2"
                                                    ColumnDefinitions="Auto, Auto, Auto"
                                                    ColumnSpacing="5">
                                                    <!--  Add button  -->
                                                    <Button Classes="IconBtn" Click="AddEnvironmentRow_OnClick" IsEnabled="{Binding InstanceConfig.EnableEnvironment}">
                                                        <TextBlock Text="Add" />
                                                    </Button>
                                                    <!--  Remove button  -->
                                                    <Button Grid.Column="1" Classes="IconBtn" Click="RemoveEnvironmentRow_OnClick" IsEnabled="{Binding CanRemoveEnvironmentVariable}">
                                                        <TextBlock Text="Remove" />
                                                    </Button>
                                                    <!--  Clear button  -->
                                                    <Button Grid.Column="2" Classes="IconBtn" Click="ClearEnvironmentTable_OnClick" IsEnabled="{Binding InstanceConfig.EnableEnvironment}">
                                                        <TextBlock Text="Clear" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                                <!-- Misc Settings  -->
                                <TabItem Classes="ModalTabItem" Header="Misc">
                                    <Border Classes="ModalInnerScrollableWrapper">
                                        <ScrollViewer Classes="ModalScrollViewer">
                                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                                                <!--  Subtitle  -->
                                                <TextBlock Name="StNativeLibrariesTb" Classes="SettingsCategory">
                                                    Native libraries
                                                </TextBlock>
                                                <!--  Use custom GLFW  -->
                                                <CheckBox Grid.Row="1" Name="StUseCustomGlfwCb" IsChecked="{Binding InstanceConfig.Misc.UseCustomGlfw}">
                                                    <TextBlock Name="StUseCustomGlfwTb" Text="Use custom GLFW" />
                                                </CheckBox>
                                                <!--  GLFW library path  -->
                                                <Grid Grid.Row="2" ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StGlfwPathTb" Classes="TextInput">GLFW library path</TextBlock>
                                                    <!--  Input  -->
                                                    <TextBox
                                                        Name="StGlfwPathInput"
                                                        Grid.Column="1"
                                                        Classes="TextInput"
                                                        Text="{Binding InstanceConfig.Misc.CustomGlfwPath}"
                                                        IsEnabled="{Binding InstanceConfig.Misc.UseCustomGlfw}"/>
                                                </Grid>
                                                <!--  Use custom OpenAL  -->
                                                <CheckBox Grid.Row="3" Name="StUseCustomOpenAlCb" IsChecked="{Binding InstanceConfig.Misc.UseCustomOpenAL}">
                                                    <TextBlock Name="StUseCustomOpenAlTb" Text="Use custom OpenAL" />
                                                </CheckBox>
                                                <!--  OpenAL library path  -->
                                                <Grid Grid.Row="4" ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StOpenAlPathTb" Classes="TextInput">OpenAL library path</TextBlock>
                                                    <!--  Input  -->
                                                    <TextBox
                                                        Name="StOpenAlPathInput"
                                                        Grid.Column="1"
                                                        Classes="TextInput"
                                                        Text="{Binding InstanceConfig.Misc.CustomOpenALPath}"
                                                        IsEnabled="{Binding InstanceConfig.Misc.UseCustomOpenAL}" />
                                                </Grid>
                                                <!-- Preference Settings  -->
                                                <TextBlock Grid.Row="5" Name="StPreferenceSubtitleTb" Classes="SettingsCategory">
                                                    Preferences
                                                </TextBlock>
                                                <!--  Override Account  -->
                                                <CheckBox Grid.Row="6" Name="StOverrideAccountCb" IsChecked="{Binding InstanceConfig.Misc.OverrideAccount}">
                                                    <TextBlock Name="StOverrideAccountTb" Text="Override default account" />
                                                </CheckBox>
                                                <!--  Account  -->
                                                <Grid Grid.Row="7" ColumnDefinitions="Auto, *">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StOverridenAccountTb" Classes="TextDropdown">Account</TextBlock>
                                                    <!--  Input  -->
                                                    <ComboBox
                                                        Name="StOverridenAccountInput"
                                                        Grid.Column="1"
                                                        Classes="TextDropdown"
                                                        IsEnabled="{Binding InstanceConfig.Misc.OverrideAccount}"
                                                        ItemsSource="{Binding Accounts}"
                                                        SelectionChanged="OverridenAccount_SelectionChanged"
                                                        DisplayMemberBinding="{Binding DisplayName}">
                                                    </ComboBox>
                                                </Grid>
                                                <!--  Set target server  -->
                                                <CheckBox Grid.Row="8" Name="StTargetServerCb" IsChecked="{Binding InstanceConfig.Misc.JoinServerOnLaunch}">
                                                    <TextBlock Name="StTargetServerTb" Text="Set server address to join on launch" />
                                                </CheckBox>
                                                <!--  Server address  -->
                                                <Grid Grid.Row="9" ColumnDefinitions="Auto, *">
                                                    <!--  Text  -->
                                                    <TextBlock Name="StServerAddressTb" Classes="TextDropdown">Server address</TextBlock>
                                                    <!--  Input  -->
                                                    <TextBox
                                                        Name="StServerAddressInput"
                                                        Grid.Column="1"
                                                        Classes="TextInput"
                                                        Text="{Binding InstanceConfig.Misc.ServerAddress}"
                                                        IsEnabled="{Binding InstanceConfig.Misc.JoinServerOnLaunch}"/>
                                                </Grid>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>