<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.ResourceDownloadWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:LoadingIndicators.Avalonia;assembly=LoadingIndicators.Avalonia"
    xmlns:converters="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate instance.resource.download.window}"
    Width="900"
    Height="500"
    MinWidth="900"
    MinHeight="500"
    d:DesignHeight="500"
    d:DesignWidth="900"
    x:DataType="vm:ResourceDownloadViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://Desktop/Assets/Images/logo.png"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </Window.Resources>

    <Grid>
        <!--  Main window body  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar/>

                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, *">
                    <!--  Title  -->
                    <Border Classes="ModalTitleBorder">
                        <StackPanel>
                            <TextBlock Text="{lang:Translate instance.resource.download.title}" />
                            <TextBlock Classes="ModalSubTitle" Text="{lang:Translate instance.resource.download.description}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="*, Auto">
                        <!--  Content  -->
                        <Grid
                            Margin="15"
                            Classes="SettingsWrapper"
                            ColumnDefinitions="180, *">
                            <!--  Filters  -->
                            <Border Classes="SettingsCategoryBorder">
                                <ScrollViewer>
                                    <Grid
                                        Margin="0,0,10,0"
                                        RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                                        RowSpacing="10">
                                        <!--  Search  -->
                                        <TextBox
                                            MinHeight="30"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            Classes="TextInput"
                                            FontSize="12"
                                            IsReadOnly="{Binding !AllowScrollbarRefresh}"
                                            PlaceholderText="{lang:Translate common.search}"
                                            Text="{Binding SearchQuery, Delay=500}" />

                                        <!--  Platform  -->
                                        <Grid
                                            Grid.Row="1"
                                            RowDefinitions="Auto, Auto"
                                            RowSpacing="8">
                                            <!--  Text  -->
                                            <TextBlock
                                                Classes="TextInput"
                                                FontSize="12"
                                                Foreground="{DynamicResource text-muted}"
                                                Text="{lang:Translate instance.create.modpack.platform}" />
                                            <!--  Input  -->
                                            <ComboBox
                                                Grid.Row="1"
                                                MinHeight="30"
                                                Classes="TextDropdown"
                                                FontSize="12"
                                                IsEnabled="False"
                                                IsHitTestVisible="{Binding AllowScrollbarRefresh}"
                                                ItemsSource="{Binding AvailablePlatforms}"
                                                SelectedItem="{Binding SelectedPlatform}"
                                                SelectionChanged="Filter_OnSelectionChanged" />
                                        </Grid>

                                        <!--  Minecraft Version  -->
                                        <Grid
                                            Grid.Row="2"
                                            RowDefinitions="Auto, Auto"
                                            RowSpacing="8">
                                            <!--  Text  -->
                                            <TextBlock
                                                Classes="TextInput"
                                                FontSize="12"
                                                Foreground="{DynamicResource text-muted}"
                                                Text="{lang:Translate instance.create.modpack.minecraft.version}" />
                                            <!--  Input  -->
                                            <ComboBox
                                                Grid.Row="1"
                                                MinHeight="30"
                                                Classes="TextDropdown"
                                                FontSize="12"
                                                IsHitTestVisible="{Binding AllowScrollbarRefresh}"
                                                ItemsSource="{Binding VersionFilterSource}"
                                                SelectedIndex="{Binding VersionFilterIndex}"
                                                SelectedValue="{Binding MinecraftVersion}"
                                                SelectionChanged="Filter_OnSelectionChanged" />
                                        </Grid>

                                        <!--  ModLoader  -->
                                        <Grid
                                            Grid.Row="3"
                                            IsVisible="{Binding IsMod}"
                                            RowDefinitions="Auto, Auto"
                                            RowSpacing="8">
                                            <!--  Text  -->
                                            <TextBlock
                                                Classes="TextInput"
                                                FontSize="12"
                                                Foreground="{DynamicResource text-muted}"
                                                Text="{lang:Translate instance.create.modpack.mod.loader}" />
                                            <!--  Input  -->
                                            <ComboBox
                                                Grid.Row="1"
                                                MinHeight="30"
                                                Classes="TextDropdown"
                                                FontSize="12"
                                                IsHitTestVisible="{Binding AllowScrollbarRefresh}"
                                                SelectedIndex="{Binding ModLoaderIndex}"
                                                SelectedValue="{Binding ModLoader}"
                                                SelectionChanged="Filter_OnSelectionChanged">
                                                <ComboBoxItem Content="Any" />
                                                <ComboBoxItem Content="NeoForge" />
                                                <ComboBoxItem Content="Forge" />
                                                <ComboBoxItem Content="Fabric" />
                                                <ComboBoxItem Content="Quilt" />
                                            </ComboBox>
                                        </Grid>

                                        <!--  Categories  -->
                                        <StackPanel Grid.Row="4" IsVisible="{Binding IsMod}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource text-muted}"
                                                Text="{lang:Translate common.categories}" />

                                            <ItemsControl ItemsSource="{Binding Categories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox
                                                            Classes="InstanceModCategory"
                                                            Content="{Binding DisplayName}"
                                                            IsChecked="{Binding IsChecked}"
                                                            IsCheckedChanged="Category_OnIsCheckedChanged"
                                                            IsHitTestVisible="{Binding $parent[Window].DataContext.AllowScrollbarRefresh}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!--  Content  -->
                            <Grid
                                Grid.Column="1"
                                ColumnDefinitions="*, Auto, *"
                                ColumnSpacing="10">
                                <!--  Mod List  -->
                                <Border Classes="SettingsCategoryBorder">
                                    <Grid>
                                        <ScrollViewer ScrollChanged="ScrollViewer_OnScrollChanged">
                                            <!--  Content  -->
                                            <ListBox
                                                Margin="0,0,10,0"
                                                Background="Transparent"
                                                ItemsSource="{Binding Resources}"
                                                Opacity="{Binding AllowScrollbarRefresh, Converter={StaticResource BoolToOpacityConverter}}"
                                                SelectedItem="{Binding SelectedResource}"
                                                SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="InstanceModCard" Opacity="{Binding !IsInstalled, Converter={StaticResource BoolToOpacityConverter}}">
                                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                                                <Image Width="35" Source="{Binding Icon.Value}" />
                                                                <Grid Grid.Column="1" RowDefinitions="Auto, Auto">
                                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                                        <TextBlock Classes="InstanceModTitle" Text="{Binding Name}" />
                                                                        <TextBlock Grid.Column="1" Classes="InstanceModTitle" IsVisible="{Binding IsSelected}" Text="{lang:Translate instance.resource.download.selected}" />
                                                                        <TextBlock Grid.Column="1" Classes="InstanceModTitle" IsVisible="{Binding IsInstalled}" Text="{lang:Translate instance.resource.download.installed}" />
                                                                    </Grid>
                                                                        <TextBlock
                                                                            Grid.Row="1"
                                                                            Classes="InstanceModDescription"
                                                                            Text="{Binding Description}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <avalonia:LoadingIndicator
                                            Height="150"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource primary-content}"
                                            IsActive="{Binding !AllowScrollbarRefresh}"
                                            Mode="Arc"
                                            SpeedRatio="1.2" />
                                    </Grid>
                                </Border>

                                <!--  Grid Splitter  -->
                                <GridSplitter Grid.Column="1" Classes="InstanceSplitter" />

                                <!--  Preview  -->
                                <Border
                                    Grid.Column="2"
                                    Padding="10,0"
                                    Classes="SettingsCategoryBorder">
                                    <Grid RowDefinitions="*, Auto" RowSpacing="10">

                                        <!--  Preview Content  -->
                                        <ScrollViewer>
                                            <HtmlLabel
                                                MaxWidth="{Binding $parent[Border].Bounds.Width}"
                                                Margin="0,0,10,0"
                                                BaseStylesheet="{DynamicResource HtmlBaseStyle}"
                                                Text="{Binding ModPreview}" />
                                        </ScrollViewer>

                                        <!--  Version Selector  -->
                                        <Grid
                                            Grid.Row="1"
                                            Margin="0,0,0,10"
                                            ColumnDefinitions="*, Auto"
                                            ColumnSpacing="10"
                                            IsVisible="{Binding SelectedResource, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <!--  Version Selector  -->
                                            <ComboBox
                                                VerticalAlignment="Center"
                                                Classes="TextDropdown"
                                                ItemsSource="{Binding SelectedResource.Versions}"
                                                PlaceholderText=""
                                                SelectedIndex="{Binding SelectedResourceVersionIndex}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!--  Select Button  -->
                                            <Button
                                                Grid.Column="1"
                                                Classes="IconBtn SuccessBtn"
                                                Command="{Binding ToggleResourceSelectCommand}"
                                                IsVisible="{Binding !IsResourceSelected}"
                                                IsEnabled="{Binding !SelectedResource.IsInstalled}">
                                                <WrapPanel Classes="IconBtnWrapper">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="FontAwesome"
                                                        Text="&#xf00c;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="500"
                                                        Text="Select" />
                                                </WrapPanel>
                                            </Button>

                                            <!--  Unselect Button  -->
                                            <Button
                                                Grid.Column="1"
                                                Classes="IconBtn WarningBtn"
                                                Command="{Binding ToggleResourceSelectCommand}"
                                                IsVisible="{Binding IsResourceSelected}"
                                                IsEnabled="{Binding !SelectedResource.IsInstalled}">
                                                <WrapPanel Classes="IconBtnWrapper">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="FontAwesome"
                                                        Text="&#xf00d;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="500"
                                                        Text="Unselect" />
                                                </WrapPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!--  Buttons  -->
                        <Border Grid.Row="1" Classes="InstanceButtonBorder">
                            <Grid ColumnDefinitions="250, 200, *" ColumnSpacing="10">
                                <!--  Action buttons  -->
                                <StackPanel Grid.Column="2" Classes="InstanceButtonWrapper">
                                    <!--  Cancel Button  -->
                                    <Button Classes="IconBtn ErrorBtn" Command="{Binding CloseWindowCommand}">
                                        <WrapPanel Classes="IconBtnWrapper">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="FontAwesome"
                                                Text="&#xf00d;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="500"
                                                Text="{lang:Translate common.cancel}" />
                                        </WrapPanel>
                                    </Button>
                                    <!--  Review Button  -->
                                    <Button Classes="IconBtn SuccessBtn" 
                                            IsEnabled="{Binding HasResources}"
                                            Command="{Binding ReviewInstallCommand}">
                                        <WrapPanel Classes="IconBtnWrapper">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="FontAwesome"
                                                Text="&#xf061;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="500"
                                                Text="Review" />
                                        </WrapPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        
        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>