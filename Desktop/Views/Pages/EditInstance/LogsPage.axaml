<UserControl
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Pages.EditInstance.LogsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:EditInstanceViewModel"
    mc:Ignorable="d">
    <Border Margin="25,0,25,25" Classes="SettingsCategoryBorder">
        <Grid RowDefinitions="Auto, *, Auto">
            <!--  Title  -->
            <TextBlock
                Margin="5,5,5,10"
                Classes="SettingsCategoryText"
                Text="{lang:Translate instance.edit.latestLog}" />

            <!--  Log content  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,15"
                Classes="GridInnerContent">
                <ListBox
                    Name="LogsScrollViewer"
                    Classes="InstancesPageContainer"
                    ItemsSource="{Binding Logs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Opacity="0.8"
                                Text="{Binding .}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!--  Actions  -->
            <Grid
                Grid.Row="2"
                Margin="4,0"
                ColumnDefinitions="*, Auto, Auto, Auto"
                ColumnSpacing="5">
                <!--  Search bar  -->
                <TextBox
                    Grid.Column="0"
                    Classes="TextInput"
                    PlaceholderText="{lang:Translate common.search}" />
                <!--  To bottom button  -->
                <Button
                    Grid.Column="1"
                    Classes="IconBtn"
                    Command="{Binding ScrollLogsToEndCommand}">
                    <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="FontAwesome"
                            Text="&#xe4b8;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{lang:Translate common.bottom}" />
                    </Grid>
                </Button>
                <!--  Copy button  -->
                <Button
                    Grid.Column="2"
                    Classes="IconBtn"
                    Command="{Binding CopyLogsCommand}">
                    <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="FontAwesome"
                            Text="&#xf0c5;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{lang:Translate common.copy}" />
                    </Grid>
                </Button>
                <!--  Clear button  -->
                <Button
                    Grid.Column="3"
                    Classes="IconBtn ErrorBtn"
                    Command="{Binding ClearLogsCommand}">
                    <Grid Classes="IconBtnWrapper" ColumnDefinitions="Auto, Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="FontAwesome"
                            Text="&#xf1b8;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{lang:Translate common.clear}" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>

