<Window
    CanResize="True"
    Height="500"
    Icon="../Assets/Images/logo.png"
    MinHeight="500"
    MinWidth="900"
    ShowInTaskbar="False"
    Title="Edit Instance"
    Width="900"
    d:DesignHeight="500"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.EditInstanceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia.Tight"
    xmlns:vm="using:Tavstal.KonkordLauncher.Desktop.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Classes="InstanceView">
        <Grid RowDefinitions="Auto,*">
            <!--  Title  -->
            <TextBlock
                Classes="InstanceTitle"
                HorizontalAlignment="Left"
                Text="Editing Instance: My Pack" />

            <!--  Content  -->
            <Grid Grid.Row="1">
                <TabControl Classes="ModalVerticalTab" TabStripPlacement="Left">
                    <!--  Logs -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Logs">
                        <Border Classes="ModalScrollableWrapper">
                            <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, *, Auto">
                                <!-- Title -->
                                <TextBlock FontWeight="500" FontSize="20" Text="Latest Log" />
                                <!-- Log content -->
                                <Border Grid.Row="1" Background="{StaticResource base-200}" CornerRadius="8" Padding="15">
                                    <ScrollViewer>
                                        <TextBlock Opacity="0.8" FontFamily="Consolas" TextWrapping="Wrap" Text="Loading..." />
                                    </ScrollViewer>
                                </Border>
                                <!-- Actions -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="5">
                                    <!-- Search bar -->
                                    <TextBox Grid.Column="0" Name="StAssetsInput" Classes="TextInput" Watermark="Search..." />
                                    <!-- Search button -->
                                    <Button Grid.Column="1" Classes="IconBtn InfoBtn">
                                        <TextBlock Text="Search" />
                                    </Button>
                                    <!-- To bottom button -->
                                    <Button Grid.Column="2" Classes="IconBtn InfoBtn">
                                        <TextBlock Text="Bottom" />
                                    </Button>
                                    <!-- Copy button -->
                                    <Button Grid.Column="3" Classes="IconBtn WarningBtn">
                                        <TextBlock Text="Copy" />
                                    </Button>
                                    <!-- Clear button -->
                                    <Button Grid.Column="4" Classes="IconBtn ErrorBtn">
                                        <TextBlock Text="Clear" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!-- Version -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Version">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!-- Mods -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Mods">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!--  Resource packs -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Resource packs">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!--  Shader packs -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Shader packs">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!--  Worlds -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Worlds">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!-- Servers -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Servers">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!--  Screenshots -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Screenshots">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!--  Settings -->
                    <TabItem Classes="ModalVerticalTabItem" Header="Settings">
                        <Border Classes="ModalScrollableWrapper">
                            <ScrollViewer>
                                <Grid Classes="ModalScrollableWrapper" RowDefinitions="Auto, Auto, Auto, Auto">
                                   
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
