<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.JavaSelectorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate java.title}"
    Width="500"
    Height="410"
    MinWidth="500"
    MinHeight="410"
    d:DesignHeight="410"
    d:DesignWidth="500"
    x:DataType="models:JavaSelectorViewModel"
    Background="Transparent"
    CanResize="False"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://KonkordLauncher/Assets/Images/logo.png"
    ShowInTaskbar="True"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <!--  Main Window Content  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar/>

                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto">

                    <!--  Title  -->
                    <Border Classes="ModalTitleBorder">
                        <StackPanel>
                            <TextBlock Text="{lang:Translate java.select}" />
                            <TextBlock Classes="ModalSubTitle" Text="{lang:Translate java.select.subtitle}" />
                        </StackPanel>
                    </Border>

                    <!--  Content  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="20,15,20,0"
                        Classes="TableScrollViewer">
                        <DataGrid
                            Name="VersionTable"
                            Background="{DynamicResource base-100}"
                            Classes="InstanceTable"
                            ItemsSource="{Binding Versions}"
                            SelectedItem="{Binding SelectedJavaVersion, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <!--  Major  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Major}"
                                    Header="{lang:Translate java.table.major}" />
                                <!--  Version  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Version}"
                                    Header="{lang:Translate java.table.version}" />
                                <!--  Architecture  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Architecture}"
                                    Header="{lang:Translate java.table.architecture}" />
                                <!--  Path  -->
                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding Path}"
                                    Header="{lang:Translate java.table.path}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <!--  Buttons  -->
                    <Border Grid.Row="2" Classes="InstanceButtonBorder">
                        <!--  Buttons  -->
                        <StackPanel HorizontalAlignment="Center" Classes="InstanceButtonWrapper">

                            <!--  Ok Button  -->
                            <Button
                                Classes="IconBtn SuccessBtn"
                                Command="{Binding SelectedBtnCommand}"
                                IsEnabled="{Binding HasSelectedJavaVersion}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf00c;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="500"
                                        Text="{lang:Translate common.ok}" />
                                </WrapPanel>
                            </Button>

                            <!--  Cancel Button  -->
                            <Button Classes="IconBtn ErrorBtn" Command="{Binding CancelBtnCommand}">
                                <WrapPanel Classes="IconBtnWrapper">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="FontAwesome"
                                        Text="&#xf00d;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="500"
                                        Text="{lang:Translate common.cancel}" />
                                </WrapPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>
