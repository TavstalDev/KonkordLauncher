<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BG-Body}"/>
    </Style>

    <!-- region Side Bar -->
    <!-- Button -->
    <Style Selector="Button.SidebarBtn">
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="240"/>
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4"></Setter>
        <Setter Property="Margin" Value="0, 0, 0, 10"/>
        <Setter Property="Background" Value="{StaticResource Btn-Secondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Secondary-Border}" />
        <Setter Property="BorderThickness" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Button Hover -->
    <Style Selector="Button.SidebarBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Btn-Secondary-Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Secondary-Hover-Border}" />
        <Setter Property="BorderThickness" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Button Active -->
    <Style Selector="Button.SidebarBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Btn-Secondary-Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Secondary-Hover-Border}" />
        <Setter Property="BorderThickness" Value="0,0,2,2" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <!-- Selected Button -->
    <Style Selector="Button.SidebarSelectedBtn">
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="240"/>
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4"></Setter>
        <Setter Property="Margin" Value="0, 0, 0, 10"/>
        <Setter Property="Background" Value="{StaticResource Btn-Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Primary-Border}" />
        <Setter Property="BorderThickness" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Selected Button Hover -->
    <Style Selector="Button.SidebarSelectedBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Btn-Primary-Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Primary-Hover-Border}" />
        <Setter Property="BorderThickness" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Selected Button Active -->
    <Style Selector="Button.SidebarSelectedBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Btn-Primary-Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Primary-Hover-Border}" />
        <Setter Property="BorderThickness" Value="0,0,2,2" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <!-- Label -->
    <Style Selector="Label.SidebarLabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Text-Muted}"/>
    </Style>
    <!-- endregion -->
    
    <!-- region Main Content Area -->
    
    <Style Selector="Border.MainContentArea">
        <Setter Property="Background" Value="{StaticResource BG-Surface-Medium}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BG-Border-Secondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    
    <Style Selector="StackPanel.MainContentArea">
        <Setter Property="Margin" Value="20"/>
    </Style>
    
    <Style Selector="TextBlock.MainContentTitle">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="Margin" Value="0, 0, 0, 10"/>
        
    </Style>

    <!-- region Play Page -->
    <Style Selector="ScrollViewer.PlayPageScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        
    </Style>
    
    <Style Selector="WrapPanel.PlayPageWrapper">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="ItemSpacing" Value="15"/>
        <Setter Property="LineSpacing" Value="15"/>
        <Setter Property="Margin" Value="0, 0, 0, 20"/>
        
    </Style>
    
    <Style Selector="Border.PlayCard">
        <Setter Property="Background" Value="{StaticResource BG-Surface-Dark}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Width" Value="150"/>
    </Style>
    
    <Style Selector="Image.PlayCardImage">
        <Setter Property="Height" Value="50"/>
        <Setter Property="Width" Value="50"/>
        
    </Style>
    
    <Style Selector="TextBlock.PlayCardText">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        
    </Style>
    
    <!-- Play Button -->
    <Style Selector="Button.PlayCardLaunchButton">
        <Setter Property="Background" Value="{StaticResource Btn-Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Primary-Border}" />
        <Setter Property="Foreground" Value="{StaticResource Text-Primary}"/>
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,2,2" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Play Button Hover -->
    <Style Selector="Button.PlayCardLaunchButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Btn-Primary-Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Primary-Hover-Border}" />
        <Setter Property="BorderThickness" Value="0,0,2,2" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Play Button Active -->
    <Style Selector="Button.PlayCardLaunchButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Btn-Primary-Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn-Primary-Hover-Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="StackPanel.PlayCardLaunchButton">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="10, 0"></Setter>
    </Style>
    
    <Style Selector="TextBlock.PlayCardLaunchButtonIcon">
        <Setter Property="FontFamily" Value="{StaticResource FontAwesome}" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- endregion -->
    
    
    <!-- endregion -->
</Styles>