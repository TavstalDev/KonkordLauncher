<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.CreateInstanceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:LoadingIndicators.Avalonia;assembly=LoadingIndicators.Avalonia"
    xmlns:converters="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Enums"
    xmlns:enumsc="clr-namespace:Tavstal.KonkordLauncher.Core.Enums;assembly=Core"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate instance.create.title}"
    Width="900"
    Height="500"
    MinWidth="900"
    MinHeight="500"
    d:DesignHeight="500"
    d:DesignWidth="900"
    x:DataType="vm:CreateInstanceViewModel"
    Background="Transparent"
    CanResize="True"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://KonkordLauncher/Assets/Images/logo.png"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </Window.Resources>

    <Grid>
        <!--  Main window body  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar/>
                
                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">
                    <!--  Title  -->
                    <TextBlock
                        Margin="25,0,25,15"
                        HorizontalAlignment="Left"
                        Classes="InstanceTitle"
                        Text="{lang:Translate instance.create.instance.title}" />

                    <!--  Tab Buttons  -->
                    <Border
                        Grid.Row="1"
                        Margin="25,0,25,0"
                        Classes="SettingsTabBorder">
                        <WrapPanel Classes="SettingsTabWrapper">
                            <Button
                                Name="CustomTabBtn"
                                Classes="SettingsTabBtn SettingsTabBtnActive"
                                Command="{Binding HandleTabBtnCommand}"
                                CommandParameter="{x:Static enums:ECreateInstanceTab.CUSTOM}">
                                <TextBlock Text="{lang:Translate instance.create.tab.custom}" />
                            </Button>
                            <Button
                                Name="ModpackTabBtn"
                                Classes="SettingsTabBtn"
                                Command="{Binding HandleTabBtnCommand}"
                                CommandParameter="{x:Static enums:ECreateInstanceTab.MODPACK}">
                                <TextBlock Text="{lang:Translate instance.create.tab.modpacks}" />
                            </Button>
                            <Button
                                Name="ImportTabBtn"
                                Classes="SettingsTabBtn"
                                Command="{Binding HandleTabBtnCommand}"
                                CommandParameter="{x:Static enums:ECreateInstanceTab.IMPORT}">
                                <TextBlock Text="{lang:Translate instance.create.tab.import}" />
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!--  Content  -->
                    <Carousel
                        Grid.Row="2"
                        Margin="0,15,0,0"
                        SelectedIndex="{Binding SelectedTab}">
                        <Carousel.PageTransition>
                            <CompositePageTransition>
                                <PageSlide Orientation="Vertical" Duration="0:00:00.200" />
                            </CompositePageTransition>
                        </Carousel.PageTransition>
                        <Carousel.Items>
                            <!--  Custom  -->
                            <Grid RowDefinitions="*, Auto">
                                <!--  Content  -->
                                <ScrollViewer Margin="25,0,25,0">
                                    <Grid
                                        Margin="0,0,15,0"
                                        Classes="SettingsWrapper"
                                        RowDefinitions="Auto, Auto, Auto">
                                        <!--  Basic Information  -->
                                        <Border Classes="SettingsCategoryBorder">
                                            <Grid RowDefinitions="Auto, Auto">
                                                <!--  Category Title  -->
                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.category.information.title}" />

                                                <!--  Icon, Name & Group  -->
                                                <Grid
                                                    Grid.Row="1"
                                                    Margin="5,5,5,0"
                                                    ColumnDefinitions="100,*,*"
                                                    ColumnSpacing="20">
                                                    <!--  Icon  -->
                                                    <Button Command="{Binding Custom.CustomIconSelectorCommand}">
                                                        <Image Classes="InstanceIcon" Source="{Binding Custom.InstanceIcon.Value}" />
                                                    </Button>
                                                    <!--  Name  -->
                                                    <Grid
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        RowDefinitions="Auto, Auto"
                                                        RowSpacing="8">
                                                        <!--  Text  -->
                                                        <TextBlock Classes="TextInput" Text="{lang:Translate instance.create.name}" />
                                                        <!--  Input  -->
                                                        <TextBox
                                                            Grid.Row="1"
                                                            Classes="TextInput"
                                                            PlaceholderText="My Instance"
                                                            Text="{Binding Custom.InstanceName, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                    <!--  Group  -->
                                                    <Grid
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        RowDefinitions="Auto, Auto"
                                                        RowSpacing="8">
                                                        <!--  Text  -->
                                                        <TextBlock Classes="TextInput" Text="{lang:Translate instance.create.group}" />
                                                        <!--  Input  -->
                                                        <ComboBox
                                                            Grid.Row="1"
                                                            Classes="TextDropdown"
                                                            SelectedIndex="0">
                                                            <ComboBoxItem Content="None" />
                                                        </ComboBox>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!--  Minecraft Version  -->
                                        <Border Grid.Row="1" Classes="SettingsCategoryBorder">
                                            <Grid RowDefinitions="Auto, Auto">
                                                <!--  Category Title  -->
                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.category.minecraft.version.title}" />

                                                <!--  Version Selector  -->
                                                <Grid
                                                    Grid.Row="1"
                                                    Margin="0,5,0,0"
                                                    ColumnDefinitions="*, Auto"
                                                    ColumnSpacing="15">
                                                    <!--  Input  -->
                                                    <DataGrid
                                                        Name="CustomMinecraftVersionDataTable"
                                                        Grid.Column="0"
                                                        MaxHeight="250"
                                                        Classes="InstanceTable"
                                                        GridLinesVisibility="None"
                                                        ItemsSource="{Binding Custom.MinecraftVersions}"
                                                        RowBackground="Transparent"
                                                        SelectedItem="{Binding Custom.SelectedMinecraftVersion, Mode=TwoWay}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding Id}"
                                                                Header="{lang:Translate instance.create.table.version}" />
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding ReleaseTime}"
                                                                Header="{lang:Translate instance.create.table.released}" />
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding Type}"
                                                                Header="{lang:Translate instance.create.table.type}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <!--  Version Options  -->
                                                    <StackPanel Grid.Column="1" MaxWidth="175">
                                                        <!--  Release  -->
                                                        <CheckBox Content="{lang:Translate instance.create.releases}" IsChecked="{Binding Custom.ShowReleases, Mode=TwoWay}" />
                                                        <!--  Snapshot  -->
                                                        <CheckBox Content="{lang:Translate instance.create.snapshots}" IsChecked="{Binding Custom.ShowSnapshots, Mode=TwoWay}" />
                                                        <!--  Beta  -->
                                                        <CheckBox Content="{lang:Translate instance.create.betas}" IsChecked="{Binding Custom.ShowBetas, Mode=TwoWay}" />
                                                        <!--  Alpha  -->
                                                        <CheckBox Content="{lang:Translate instance.create.alphas}" IsChecked="{Binding Custom.ShowAlphas, Mode=TwoWay}" />
                                                        <!--  Experiment  -->
                                                        <CheckBox Content="{lang:Translate instance.create.experiments}" IsChecked="{Binding Custom.ShowExperiments, Mode=TwoWay}" />

                                                        <!--  Search Box  -->
                                                        <TextBox
                                                            Classes="InstanceSearch"
                                                            PlaceholderText="{lang:Translate common.search}"
                                                            Text="{Binding Custom.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!--  ModLoader  -->
                                        <Border Grid.Row="2" Classes="SettingsCategoryBorder">
                                            <Grid RowDefinitions="Auto, Auto">
                                                <!--  Category Title  -->
                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.category.mod_loader.title}" />

                                                <Grid
                                                    Grid.Row="1"
                                                    Margin="0,5,0,0"
                                                    ColumnDefinitions="*, Auto"
                                                    ColumnSpacing="15">
                                                    <!--  Input  -->
                                                    <DataGrid
                                                        Grid.Column="0"
                                                        MaxHeight="250"
                                                        Classes="InstanceTable"
                                                        GridLinesVisibility="None"
                                                        ItemsSource="{Binding Custom.ModLoaderVersionResult}"
                                                        RowBackground="Transparent"
                                                        SelectedItem="{Binding Custom.SelectedModLoader}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn
                                                                Width="*"
                                                                Binding="{Binding Version}"
                                                                Header="{lang:Translate instance.create.table.version}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <!--  Mod Loader Options  -->
                                                    <StackPanel Grid.Column="1" MaxWidth="175">
                                                        <!--  None  -->
                                                        <RadioButton
                                                            Command="{Binding Custom.CustomModLoaderTypeCommand}"
                                                            CommandParameter="{x:Static enumsc:EMinecraftKind.VANILLA}"
                                                            Content="{lang:Translate common.none}"
                                                            IsChecked="True" />
                                                        <!--  NeoForge  -->
                                                        <RadioButton
                                                            Command="{Binding Custom.CustomModLoaderTypeCommand}"
                                                            CommandParameter="{x:Static enumsc:EMinecraftKind.NEOFORGE}"
                                                            Content="NeoForge" />
                                                        <!--  Forge  -->
                                                        <RadioButton
                                                            Command="{Binding Custom.CustomModLoaderTypeCommand}"
                                                            CommandParameter="{x:Static enumsc:EMinecraftKind.FORGE}"
                                                            Content="Forge" />
                                                        <!--  Fabric  -->
                                                        <RadioButton
                                                            Command="{Binding Custom.CustomModLoaderTypeCommand}"
                                                            CommandParameter="{x:Static enumsc:EMinecraftKind.FABRIC}"
                                                            Content="Fabric" />
                                                        <!--  Quilt  -->
                                                        <RadioButton
                                                            Command="{Binding Custom.CustomModLoaderTypeCommand}"
                                                            CommandParameter="{x:Static enumsc:EMinecraftKind.QUILT}"
                                                            Content="Quilt" />

                                                        <!--  Search Box  -->
                                                        <TextBox
                                                            Classes="InstanceSearch"
                                                            PlaceholderText="{lang:Translate common.search}"
                                                            Text="{Binding Custom.ModLoaderSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>

                                <!--  Buttons  -->
                                <Border Grid.Row="1" Classes="InstanceButtonBorder">
                                    <StackPanel Classes="InstanceButtonWrapper">
                                        <!--  Cancel Button  -->
                                        <Button Classes="IconBtn ErrorBtn" Command="{Binding Custom.CustomCancelCreateCommand}">
                                            <WrapPanel Classes="IconBtnWrapper">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="FontAwesome"
                                                    Text="&#xf00d;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="500"
                                                    Text="{lang:Translate common.cancel}" />
                                            </WrapPanel>
                                        </Button>
                                        <!--  Create Instance Button  -->
                                        <Button
                                            Classes="IconBtn SuccessBtn"
                                            Command="{Binding Custom.CustomCreateCommand}"
                                            IsEnabled="{Binding Custom.CanCreateCustomInstance}">
                                            <WrapPanel Classes="IconBtnWrapper">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="FontAwesome"
                                                    Text="&#xf0c7;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="500"
                                                    Text="{lang:Translate instance.create.button}" />
                                            </WrapPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  Modpacks  -->
                            <Grid RowDefinitions="*, Auto">
                                <!--  Content  -->
                                <Grid
                                    Margin="25,0,25,15"
                                    Classes="SettingsWrapper"
                                    ColumnDefinitions="180, *">
                                    <!--  Filters  -->
                                    <Border Classes="SettingsCategoryBorder">
                                        <ScrollViewer>
                                            <Grid
                                                Margin="0,0,10,0"
                                                RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                                                RowSpacing="10">
                                                <!--  Search  -->
                                                <TextBox
                                                    MinHeight="30"
                                                    Margin="0"
                                                    HorizontalAlignment="Stretch"
                                                    Classes="TextInput"
                                                    FontSize="12"
                                                    IsReadOnly="{Binding !Modpack.AllowScrollbarRefresh}"
                                                    PlaceholderText="{lang:Translate common.search}"
                                                    Text="{Binding Modpack.SearchQuery, Delay=500}" />

                                                <!--  Platform  -->
                                                <Grid
                                                    Grid.Row="1"
                                                    RowDefinitions="Auto, Auto"
                                                    RowSpacing="8">
                                                    <!--  Text  -->
                                                    <TextBlock
                                                        Classes="TextInput"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource text-muted}"
                                                        Text="{lang:Translate instance.create.modpack.platform}" />
                                                    <!--  Input  -->
                                                    <ComboBox
                                                        Grid.Row="1"
                                                        MinHeight="30"
                                                        Classes="TextDropdown"
                                                        FontSize="12"
                                                        IsEnabled="False"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}"
                                                        ItemsSource="{Binding Modpack.AvailablePlatforms}"
                                                        SelectedItem="{Binding Modpack.SelectedPlatform}"
                                                        SelectionChanged="ModPackFilter_OnSelectionChanged" />
                                                </Grid>

                                                <!--  ModLoader  -->
                                                <Grid
                                                    Grid.Row="2"
                                                    RowDefinitions="Auto, Auto"
                                                    RowSpacing="8">
                                                    <!--  Text  -->
                                                    <TextBlock
                                                        Classes="TextInput"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource text-muted}"
                                                        Text="{lang:Translate instance.create.modpack.mod.loader}" />
                                                    <!--  Input  -->
                                                    <ComboBox
                                                        Grid.Row="1"
                                                        MinHeight="30"
                                                        Classes="TextDropdown"
                                                        FontSize="12"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}"
                                                        SelectedIndex="0"
                                                        SelectedValue="{Binding Modpack.ModLoader}"
                                                        SelectionChanged="ModPackFilter_OnSelectionChanged">
                                                        <ComboBoxItem Content="Any" />
                                                        <ComboBoxItem Content="NeoForge" />
                                                        <ComboBoxItem Content="Forge" />
                                                        <ComboBoxItem Content="Fabric" />
                                                        <ComboBoxItem Content="Quilt" />
                                                    </ComboBox>
                                                </Grid>

                                                <!--  Minecraft Version  -->
                                                <Grid
                                                    Grid.Row="3"
                                                    RowDefinitions="Auto, Auto"
                                                    RowSpacing="8">
                                                    <!--  Text  -->
                                                    <TextBlock
                                                        Classes="TextInput"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource text-muted}"
                                                        Text="{lang:Translate instance.create.modpack.minecraft.version}" />
                                                    <!--  Input  -->
                                                    <ComboBox
                                                        Grid.Row="1"
                                                        MinHeight="30"
                                                        Classes="TextDropdown"
                                                        FontSize="12"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}"
                                                        ItemsSource="{Binding Modpack.VersionFilterSource}"
                                                        SelectedIndex="{Binding Modpack.VersionFilterIndex}"
                                                        SelectedValue="{Binding Modpack.MinecraftVersion}"
                                                        SelectionChanged="ModPackFilter_OnSelectionChanged" />
                                                </Grid>

                                                <!--  Categories  -->
                                                <StackPanel Grid.Row="4">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource text-muted}"
                                                        Text="{lang:Translate common.categories}" />

                                                    <!--  Adventure Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.adventure}"
                                                        IsChecked="{Binding Modpack.CategoryAdventure}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Challenging Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.challenging}"
                                                        IsChecked="{Binding Modpack.CategoryChallenging}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Combat Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.combat}"
                                                        IsChecked="{Binding Modpack.CategoryCombat}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Kitchen Sink Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.kitchenSink}"
                                                        IsChecked="{Binding Modpack.CategoryKitchenSink}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Lightweight Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.lightweight}"
                                                        IsChecked="{Binding Modpack.CategoryLightweight}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Magic Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.magic}"
                                                        IsChecked="{Binding Modpack.CategoryMagic}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Multiplayer Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.multiplayer}"
                                                        IsChecked="{Binding Modpack.CategoryMultiplayer}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Optimization Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.optimization}"
                                                        IsChecked="{Binding Modpack.CategoryOptimization}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Quests Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.quests}"
                                                        IsChecked="{Binding Modpack.CategoryQuests}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                    <!--  Technology Checkbox  -->
                                                    <CheckBox
                                                        Classes="InstanceModCategory"
                                                        Content="{lang:Translate instance.create.category.technology}"
                                                        IsChecked="{Binding Modpack.CategoryTechnology}"
                                                        IsCheckedChanged="ModPackCategory_OnIsCheckedChanged"
                                                        IsHitTestVisible="{Binding Modpack.AllowScrollbarRefresh}" />
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>

                                    <!--  Content  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnDefinitions="*, Auto, *"
                                        ColumnSpacing="10">
                                        <!--  Modpack List  -->
                                        <Border Classes="SettingsCategoryBorder">
                                            <Grid>
                                                <ScrollViewer ScrollChanged="ScrollViewer_OnScrollChanged">
                                                    <!--  Content  -->
                                                    <ListBox
                                                        Margin="0,0,10,0"
                                                        Background="Transparent"
                                                        ItemsSource="{Binding Modpack.Modpacks}"
                                                        Opacity="{Binding Modpack.AllowScrollbarRefresh, Converter={StaticResource BoolToOpacityConverter}}"
                                                        SelectedItem="{Binding Modpack.SelectedModpack}"
                                                        SelectionMode="Single">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Classes="InstanceModCard">
                                                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                                                        <Image Width="35" Source="{Binding Icon.Value}" />
                                                                        <Grid Grid.Column="1" RowDefinitions="Auto, Auto">
                                                                            <TextBlock Classes="InstanceModTitle" Text="{Binding Name}" />
                                                                            <TextBlock
                                                                                Grid.Row="1"
                                                                                Classes="InstanceModDescription"
                                                                                Text="{Binding Description}" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>

                                                <avalonia:LoadingIndicator
                                                    Height="150"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource primary-content}"
                                                    IsActive="{Binding !Modpack.AllowScrollbarRefresh}"
                                                    Mode="Arc"
                                                    SpeedRatio="1.2" />
                                            </Grid>
                                        </Border>

                                        <!--  Grid Splitter  -->
                                        <GridSplitter Grid.Column="1" Classes="InstanceSplitter" />

                                        <!--  Modpack preview  -->
                                        <Border
                                            Grid.Column="2"
                                            Padding="10,0"
                                            Classes="SettingsCategoryBorder">
                                            <ScrollViewer>
                                                <HtmlLabel
                                                    MaxWidth="{Binding $parent[Border].Bounds.Width}"
                                                    Margin="0,0,10,0"
                                                    BaseStylesheet="{DynamicResource HtmlBaseStyle}"
                                                    Text="{Binding Modpack.ModpackPreview}" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!--  Buttons  -->
                                <Border Grid.Row="1" Classes="InstanceButtonBorder">
                                    <Grid ColumnDefinitions="250, 200, *" ColumnSpacing="10">
                                        <!--  Modpack Version  -->
                                        <ComboBox
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Classes="TextDropdown"
                                            ItemsSource="{Binding Modpack.SelectedModpack.Versions}"
                                            PlaceholderText="{lang:Translate instance.create.modpack.select}"
                                            SelectedIndex="{Binding Modpack.SelectedModpackVersionIndex}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!--  Instance Name  -->
                                        <TextBox
                                            Grid.Column="1"
                                            Classes="TextInput"
                                            PlaceholderText="My Instance Name"
                                            Text="{Binding Modpack.InstanceName, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Action buttons  -->
                                        <StackPanel Grid.Column="2" Classes="InstanceButtonWrapper">
                                            <!--  Cancel Button  -->
                                            <Button Classes="IconBtn ErrorBtn" Command="{Binding Custom.CustomCancelCreateCommand}">
                                                <WrapPanel Classes="IconBtnWrapper">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="FontAwesome"
                                                        Text="&#xf00d;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="500"
                                                        Text="{lang:Translate common.cancel}" />
                                                </WrapPanel>
                                            </Button>
                                            <!--  Create Instance Button  -->
                                            <Button
                                                Classes="IconBtn SuccessBtn"
                                                Command="{Binding Modpack.CreateInstanceCommand}"
                                                IsEnabled="{Binding Modpack.CanCreateInstance}">
                                                <WrapPanel Classes="IconBtnWrapper">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="FontAwesome"
                                                        Text="&#xf0c7;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="500"
                                                        Text="{lang:Translate instance.create.button}" />
                                                </WrapPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  Import  -->
                            <Grid RowDefinitions="*, Auto">
                                <!--  Content  -->
                                <ScrollViewer Margin="25,0,25,0">
                                    <Grid
                                        Classes="SettingsWrapper"
                                        ColumnDefinitions="*, Auto"
                                        ColumnSpacing="20">
                                        <!--  Input Area  -->
                                        <Grid Classes="SettingsWrapper" RowDefinitions="Auto, Auto, Auto">
                                            <!--  Import Type  -->
                                            <Border Classes="SettingsCategoryBorder">
                                                <Grid RowDefinitions="Auto, Auto">
                                                    <!--  Category Title  -->
                                                    <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.import.type}" />

                                                    <Grid
                                                        Grid.Row="1"
                                                        ColumnDefinitions="*, *"
                                                        ColumnSpacing="10">

                                                        <!--  From File Button  -->
                                                        <Button
                                                            Name="ImportFromFileTabBtn"
                                                            HorizontalAlignment="Stretch"
                                                            Classes="SuccessBtn"
                                                            Command="{Binding Import.ChangeImportTypeCommand}">
                                                            <Button.CommandParameter>
                                                                <x:Int32>0</x:Int32>
                                                            </Button.CommandParameter>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Text="{lang:Translate instance.create.import.source.file}"
                                                                TextAlignment="Center" />
                                                        </Button>

                                                        <!--  From URL Button  -->
                                                        <Button
                                                            Name="ImportFromUrlTabBtn"
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding Import.ChangeImportTypeCommand}">
                                                            <Button.CommandParameter>
                                                                <x:Int32>1</x:Int32>
                                                            </Button.CommandParameter>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Text="{lang:Translate instance.create.import.source.url}"
                                                                TextAlignment="Center" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!--  Import From File  -->
                                            <Border
                                                Grid.Row="1"
                                                Classes="SettingsCategoryBorder"
                                                IsVisible="{Binding Import.IsSourceFromFile}">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <!--  Category Title  -->
                                                    <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.import.select_file.title}" />

                                                    <!--  Input  -->
                                                    <Grid
                                                        Grid.Row="1"
                                                        Margin="5,0,5,0"
                                                        ColumnDefinitions="*, Auto">
                                                        <!--  Input  -->
                                                        <TextBox
                                                            Grid.Column="0"
                                                            Classes="TextInput"
                                                            IsReadOnly="True"
                                                            PlaceholderText="{lang:Translate common.select.file}"
                                                            Text="{Binding Import.ImportPath}" />
                                                        <!--  Button  -->
                                                        <Button
                                                            Grid.Column="1"
                                                            Classes="IconBtn SuccessBtn"
                                                            Command="{Binding Import.SelectFileToImportCommand}">
                                                            <TextBlock Classes="FontAwesome" Text="&#xf56f;" />
                                                        </Button>
                                                    </Grid>
                                                    <!--  Note  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Margin="5,5,5,0"
                                                        Opacity="0.5"
                                                        Text="{lang:Translate instance.create.import.formats}" />
                                                </Grid>
                                            </Border>

                                            <!--  Import From URL  -->
                                            <Border
                                                Grid.Row="1"
                                                Classes="SettingsCategoryBorder"
                                                IsVisible="{Binding !Import.IsSourceFromFile}">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <!--  Category Title  -->
                                                    <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.import.import_from_url.title}" />

                                                    <!--  Input  -->
                                                    <TextBox
                                                        Grid.Row="1"
                                                        Margin="5,0,5,0"
                                                        Classes="TextInput"
                                                        PlaceholderText="e.g., https://example.com/my-modpack.mrpack"
                                                        Text="{Binding Import.ImportPath, Delay=500}" />

                                                    <!--  Note  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Margin="5,5,5,0"
                                                        Opacity="0.5"
                                                        Text="{lang:Translate instance.create.import.formats}" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!--  Preview  -->
                                        <!--<Border
                                            Grid.Column="1"
                                            Margin="0,0,0,20"
                                            Classes="SettingsCategoryBorder">
                                            <Grid
                                                MinWidth="200"
                                                RowDefinitions="Auto, Auto, Auto, Auto"
                                                RowSpacing="10">
                                                !-  Subtitle  -
                                                <TextBlock Classes="SettingsCategoryText" Text="{lang:Translate instance.create.import.preview.title}" />

                                                !-  Name  -
                                                <Grid
                                                    Grid.Row="1"
                                                    Margin="5,0"
                                                    ColumnDefinitions="Auto, Auto">
                                                    <TextBlock Opacity="0.5" Text="{lang:Translate instance.create.import.preview.name}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Opacity="0.5"
                                                        Text="{Binding Import.ImportPreviewName}" />
                                                </Grid>

                                                !-  Version  -
                                                <Grid
                                                    Grid.Row="2"
                                                    Margin="5,0"
                                                    ColumnDefinitions="Auto, Auto">
                                                    <TextBlock Opacity="0.5" Text="{lang:Translate instance.create.import.preview.version}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Opacity="0.5"
                                                        Text="{Binding Import.ImportPreviewVersion}" />
                                                </Grid>

                                                !-  Mod Loader  -
                                                <Grid
                                                    Grid.Row="3"
                                                    Margin="5,0"
                                                    ColumnDefinitions="Auto, Auto">
                                                    <TextBlock Opacity="0.5" Text="{lang:Translate instance.create.import.preview.mod.loader}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Opacity="0.5"
                                                        Text="{Binding Import.ImportPreviewModLoader}" />
                                                </Grid>
                                            </Grid>
                                        </Border>-->
                                    </Grid>
                                </ScrollViewer>

                                <!--  Buttons  -->
                                <Border Grid.Row="1" Classes="InstanceButtonBorder">
                                    <StackPanel Classes="InstanceButtonWrapper">
                                        <!--  Cancel Button  -->
                                        <Button Classes="IconBtn ErrorBtn" Command="{Binding Custom.CustomCancelCreateCommand}">
                                            <WrapPanel Classes="IconBtnWrapper">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="FontAwesome"
                                                    Text="&#xf00d;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="500"
                                                    Text="{lang:Translate common.cancel}" />
                                            </WrapPanel>
                                        </Button>
                                        <!--  Create Instance Button  -->
                                        <Button
                                            Classes="IconBtn SuccessBtn"
                                            Command="{Binding Import.CreateInstanceFromImportCommand}"
                                            IsEnabled="{Binding Import.HasImportPath}">
                                            <WrapPanel Classes="IconBtnWrapper">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="FontAwesome"
                                                    Text="&#xf0c7;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="500"
                                                    Text="{lang:Translate instance.create.button}" />
                                            </WrapPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Carousel.Items>
                    </Carousel>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>
