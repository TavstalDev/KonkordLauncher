<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.InstanceView">
        <Setter Property="Padding" Value="30" />
    </Style>
    
    <Style Selector="TextBlock.InstanceTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Foreground" Value="{StaticResource primary-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    
    <Style Selector="TextBlock.InstanceCategory">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <Style Selector="Border.InstanceWrapper">
        <Setter Property="Background" Value="{StaticResource base-100}" />
        <Setter Property="BorderBrush" Value="{StaticResource border-two}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0, 8, 8, 8" />
        <Setter Property="Margin" Value="0,-2,0,0" />
    </Style>
    
    <Style Selector="Grid.InstanceWrapper">
        <Setter Property="ColumnSpacing" Value="15" />
        <Setter Property="RowSpacing" Value="15" />
        <Setter Property="Margin" Value="25,20,50,25" />
    </Style>
    
    <Style Selector="Image.InstanceIcon">
        <Setter Property="Height" Value="60" />
        <Setter Property="Width" Value="60" />
    </Style>
    
    <Style Selector="DataGrid.InstanceTable">
        <Setter Property="MaxHeight" Value="200" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{StaticResource base-200}" />
        <Setter Property="BorderBrush" Value="{StaticResource border-one}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource base-300}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <Style Selector="TextBox.InstanceSearch">
        <Setter Property="Width" Value="175" />
        <Setter Property="MaxWidth" Value="175" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    
    <Style Selector="StackPanel.InstanceButtonWrapper">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="10" />
    </Style>
    
    <Style Selector="TextBlock.InstanceButtonText">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Foreground" Value="{StaticResource primary-content}" />
        <Setter Property="Padding" Value="5" />
    </Style>
</Styles>