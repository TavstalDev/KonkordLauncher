<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Window Style  -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource base-200}" />
    </Style>

    <!--  FontAwesome Icon Style  -->
    <Style Selector="TextBlock.FontAwesome">
        <Setter Property="FontFamily" Value="{DynamicResource FontAwesome}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="Image.StartupLogo">
        <Setter Property="Width" Value="200" />
        <Setter Property="Margin" Value="0,20" />
    </Style>
    
    <Style Selector="ProgressBar.StartupProgress">
        <Setter Property="Margin" Value="0, 0, 0, 10" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    
    <Style Selector="TextBlock.StartupProgressText">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
    </Style>
    
    <Style Selector="Border.ModalView">
        <Setter Property="Padding" Value="25" />
    </Style>
    
    <Style Selector="WrapPanel.ModalWrapper">
        <Setter Property="LineSpacing" Value="10" />
        <Setter Property="ItemSpacing" Value="15" />
        <Setter Property="Width" Value="440"></Setter>
        <Setter Property="ItemWidth" Value="440" />
        <Setter Property="Margin" Value="25,20,25,25" />
        <Setter Property="Orientation" Value="Vertical" />
    </Style>
</Styles>