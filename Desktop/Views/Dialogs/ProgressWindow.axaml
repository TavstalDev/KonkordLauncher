<Window
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Dialogs.ProgressWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Common.Models.Translation;assembly=Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Dialogs.Models"
    xmlns:templates="clr-namespace:Tavstal.KonkordLauncher.Desktop.Styles.Templates"
    Title="{lang:Translate install.title}"
    Width="400"
    MinHeight="175"
    d:DesignHeight="175"
    d:DesignWidth="400"
    x:DataType="models:ProgressViewModel"
    Background="Transparent"
    CanResize="False"
    CornerRadius="14"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://KonkordLauncher/Assets/Images/logo.png"
    ShowInTaskbar="True"
    SizeToContent="Height"
    TransparencyLevelHint="Transparent"
    UseLayoutRounding="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <!--  Main window body  -->
        <Border
            Background="{DynamicResource base-200}"
            BorderBrush="{DynamicResource border-one}"
            BorderThickness="1"
            CornerRadius="14"
            PointerPressed="DragStart_PointerPressed">
            <Grid RowDefinitions="Auto, *">
                <!--  Window Controls  -->
                <templates:CustomTitleBar />

                <!--  Main Content  -->
                <Grid Grid.Row="1" RowDefinitions="Auto, *">
                    <!--  Title  -->
                    <Border Classes="ModalTitleBorder">
                        <StackPanel>
                            <TextBlock Text="{lang:Translate instance.install.title}" />
                            <TextBlock Classes="ModalSubTitle" Text="{lang:Translate instance.install.description}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="*, Auto">
                        <!--  Content  -->
                        <Grid
                            Margin="25,20,25,20"
                            RowDefinitions="Auto, Auto, Auto"
                            RowSpacing="10">

                            <!--  Progress Header  -->
                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*, *"
                                ColumnSpacing="5">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{lang:Translate install.progress}"
                                    TextAlignment="Left" />

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0.00}}" />
                                    <TextBlock Text="%" />
                                </StackPanel>

                            </Grid>

                            <!-- Progress Bar and Details -->
                            <StackPanel Grid.Row="1" Spacing="5">
                                <!--  Progress bar  -->
                                <ProgressBar
                                    Name="ProgressBar"
                                    Classes="InstallProgress"
                                    Value="{Binding ProgressValue}" />

                                <Grid ColumnDefinitions="*, *">
                                    <!--  Task display  -->
                                    <StackPanel
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding TotalTasks, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource text-muted}"
                                            Text="Task" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource text-muted}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat=" {0} / {1}">
                                                    <Binding Path="CompletedTasks" TargetNullValue="0" />
                                                    <Binding Path="TotalTasks" TargetNullValue="0" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <!--  Byte display  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{DynamicResource text-muted}"
                                        IsVisible="{Binding TotalBytes, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} MB / {1} MB">
                                                <Binding Path="CompletedBytes" TargetNullValue="0" />
                                                <Binding Path="TotalBytes" TargetNullValue="0" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- Progress Text -->
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{DynamicResource text-faded}"
                                Text="{Binding ProgressText}"
                                TextAlignment="Center" />

                        </Grid>

                        <!--  Bottom Wrapper  -->
                        <Border Grid.Row="1" Classes="InstanceButtonBorder">
                            <Grid ColumnDefinitions="*, Auto">
                                <!--  Buttons  -->
                                <StackPanel Grid.Column="1" Classes="InstanceButtonWrapper">
                                    <!--  Cancel Button  -->
                                    <Button
                                        Classes="IconBtn ErrorBtn"
                                        Command="{Binding CloseWindowCommand}"
                                        IsEnabled="{Binding IsCancellable}">
                                        <WrapPanel Classes="IconBtnWrapper">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="FontAwesome"
                                                Text="&#xf00d;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="500"
                                                Text="{lang:Translate common.cancel}" />
                                        </WrapPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!--  Resize overlay  -->
        <templates:WindowResizer />
    </Grid>
</Window>
