<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="StackPanel.NewsPageWrapper">
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style Selector="Border.NewsCard">
        <Setter Property="Background" Value="{DynamicResource base-100}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Margin" Value="0, 0, 20, 0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.NewsCardTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.NewsCardDescription">
        <Setter Property="Foreground" Value="{DynamicResource base-content}" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>