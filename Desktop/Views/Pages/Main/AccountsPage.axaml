<UserControl
    x:Class="Tavstal.KonkordLauncher.Desktop.Views.Pages.Main.AccountsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Tavstal.KonkordLauncher.Desktop.Models.Domain"
    xmlns:lang="clr-namespace:Tavstal.KonkordLauncher.Desktop.Translation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Tavstal.KonkordLauncher.Desktop.Views.Models"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <UserControl.DataTemplates>
        <!--  Account Card  -->
        <DataTemplate x:DataType="domain:AccountModel">
            <Border Classes="AccountsCard" Classes.selected="{Binding IsSelected}">
                <Grid ColumnDefinitions="*, Auto">
                    <!--  Name & Type  -->
                    <Grid VerticalAlignment="Center" RowDefinitions="Auto, Auto">
                        <TextBlock
                            Grid.Row="0"
                            Classes="AccountsCardName"
                            Text="{Binding DisplayName}" />
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Type}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!--  Buttons  -->
                    <Grid
                        Grid.Column="1"
                        Classes="AccountsCardWrapper"
                        ColumnDefinitions="Auto, Auto, Auto">
                        <Button
                            Grid.Column="0"
                            Classes="IconBtn SuccessBtn"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).Accounts.SelectAccountBtnCommand}"
                            CommandParameter="{Binding Id}"
                            IsVisible="{Binding !IsSelected}">
                            <TextBlock Classes="FontAwesome" Text="&#xf00c;" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Classes="IconBtn WarningBtn"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).Accounts.RefreshAccountBtnCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding CanExpire}">
                            <TextBlock Classes="FontAwesome" Text="&#xf2f9;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Classes="IconBtn ErrorBtn"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).Accounts.RemoveAccountBtnCommand}"
                            CommandParameter="{Binding .}">
                            <TextBlock Classes="FontAwesome" Text="&#xf1f8;" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Classes="MainContentArea" RowDefinitions="Auto, *">
        <Grid ColumnDefinitions="*, Auto">
            <!--  Title  -->
            <TextBlock Classes="MainContentTitle" Text="{lang:Translate main.page.accounts.title}" />
            <!--  Add account button  -->
            <Button
                Grid.Column="1"
                Classes="IconBtn PrimaryBtn"
                Command="{Binding Accounts.AddAccountBtnCommand}">
                <TextBlock Classes="FontAwesome" Text="&#xf234;" />
            </Button>
        </Grid>
        <!--  No accounts text  -->
        <TextBlock
            Grid.Row="1"
            IsVisible="{Binding !Accounts.AccountData.HasAccounts}"
            Text="{lang:Translate main.page.accounts.empty}" />
        <!--  Accounts Grid  -->
        <ListBox
            Grid.Row="1"
            Classes="AccountsPageContainer"
            ItemsSource="{Binding Accounts.AccountData.Accounts}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Classes="AccountsPageWrapper" Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>

